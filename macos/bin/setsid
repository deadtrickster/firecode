#!/usr/bin/env python3
# setsid for macOS, which has the system call and not the command: run the
# rest of the command line as the leader of a new session, detached from the
# terminal and from the caller's process group.
import os
import sys

if len(sys.argv) < 2:
    sys.exit("usage: setsid command [args...]")
if os.getpgrp() == os.getpid():
    # Already a group leader, so setsid() would fail; fork once, as the
    # util-linux command does.
    if os.fork():
        os._exit(0)
os.setsid()
try:
    os.execvp(sys.argv[1], sys.argv[1:])
except OSError as e:
    sys.exit(f"setsid: {sys.argv[1]}: {e.strerror}")
