#!/usr/bin/env bash
# firellm - run a coding agent inside a Firecracker microVM, under the jailer.
#
# The agent gets root, the network and your project. It does not get your
# host: no host filesystem, no host processes, no host devices. Work is
# copied back out to a sibling directory when the VM shuts down.
set -euo pipefail

# Resolved, so this still finds the repo when it is reached through a symlink
# in ~/bin rather than by its real path.
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
IMAGES="$ROOT/images"
GUEST="$ROOT/guest"
SCRIPTS="$ROOT/scripts"
VENDOR="$ROOT/vendor/bin"
RUNS="$ROOT/runs"
STATE_DIR="$ROOT/state"
JAIL_BASE="$ROOT/.jail"

FC="$VENDOR/firecracker"
JAILER="$VENDOR/jailer"

# Where the host agents keep their configuration. Overridable mostly so the
# harness can be exercised against a throwaway copy.
CLAUDE_HOME="${FIRELLM_CLAUDE_HOME:-$HOME/.claude}"
CLAUDE_CONF="${FIRELLM_CLAUDE_CONF:-$HOME/.claude.json}"
OPENCODE_HOME="${FIRELLM_OPENCODE_HOME:-$HOME/.opencode}"

# Defaults. Claude Code alone wants ~1.5G, so 1G was never going to work.
MEM=4096
VCPU=4
NONET=0
NOJAIL=0
CGROUPS=0
KEEP=0
QUIET_BOOT=1
AUTO_FLAGS=1
TIMEOUT=0
WORKDIR="."
AGENT=""
SYNC_BACK=1
RESUME_TREE=auto
IMPORT_SESSIONS=auto
USE_GITIGNORE=1
NO_MCP=0
declare -a EXTRA_DIRS=()
declare -a HOST_PORTS=()
declare -a EXCLUDES=()

# Relative to $HOME. Never carried into the guest, whatever is asked for:
# keeping keys and credentials out is most of the point of running in a VM.
SENSITIVE_HOME_DIRS=(
	.ssh
	.gnupg
	.aws
	.kube
	.docker
	.config/gh
	.password-store
	.mozilla
	.config/google-chrome
	.config/chromium
)

# Your own list, one path or glob per line, # for comments. For work that
# must never end up on a VM drive - client code, anything under NDA.
DENY_FILE="${FIRELLM_DENY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/firellm/never-share}"

refuse_if_sensitive() {
	local path=$1 rel full line
	for rel in "${SENSITIVE_HOME_DIRS[@]}"; do
		full="$HOME/$rel"
		if [[ $path == "$full" || $path == "$full"/* ]]; then
			die "refusing to put $full in the guest - keys and credentials stay on the host"
		fi
	done

	[[ -f $DENY_FILE ]] || return 0
	while IFS= read -r line; do
		line=${line%%#*}
		line=${line#"${line%%[![:space:]]*}"}
		line=${line%"${line##*[![:space:]]}"}
		[[ -n $line ]] || continue
		line=${line/#\~/$HOME}
		# Match the entry itself, anything under it, and globs either way.
		# shellcheck disable=SC2053  # unquoted on purpose, the entry is a pattern
		if [[ $path == $line || $path == $line/* || $path == "$line" || $path == "$line"/* ]]; then
			die "refusing $path - listed in $DENY_FILE"
		fi
	done <"$DENY_FILE"
}

log() { echo "[firellm] $*" >&2; }
die() {
	echo "[firellm] error: $*" >&2
	exit 1
}

# debugfs and mkfs.ext4 live in /usr/sbin, which is not always on a user PATH.
sbin() {
	local name=$1
	shift
	local p
	for p in "$(command -v "$name" 2>/dev/null || true)" \
		/usr/sbin/"$name" /sbin/"$name" /usr/local/sbin/"$name"; do
		if [[ -n $p && -x $p ]]; then
			"$p" "$@"
			return
		fi
	done
	die "$name not found (install e2fsprogs)"
}

# How to become root, worked out once. Empty when we already are.
#
# With no controlling terminal - cron, a hook, another agent - sudo cannot
# prompt and just fails. If an askpass helper is configured it can ask on the
# desktop instead, which is the difference between an unattended run working
# and not.
declare -a SUDO=()
if ((EUID != 0)); then
	if [[ ! -t 0 && -n ${SUDO_ASKPASS:-} ]] && ! sudo -n true 2>/dev/null; then
		SUDO=(sudo -A)
	else
		SUDO=(sudo)
	fi
fi

priv() {
	"${SUDO[@]}" "$@"
}

# ---------------------------------------------------------------- assets

KERNEL=""
ROOTFS=""

resolve_assets() {
	[[ -x $FC && -x $JAILER ]] || die "firecracker not installed - run: firellm setup"

	local k
	k=$(find "$IMAGES" -maxdepth 1 -name 'vmlinux-*' -type f | sort -V | tail -1)
	[[ -n $k ]] || die "no guest kernel in $IMAGES - run: firellm setup"
	KERNEL=$k

	# Explicitly the prepared image. Do not glob and take the first match:
	# that is how this used to silently boot the untouched base image.
	ROOTFS="$IMAGES/agent-firellm.ext4"
	[[ -f $ROOTFS ]] || die "no guest rootfs - run: firellm prepare"
}

# ---------------------------------------------------------------- host MCP

# Ports of MCP servers the host exposes over http/sse on localhost. Those are
# the only ones that can be relayed into the guest; stdio servers are host
# binaries and cannot come along.
discover_mcp_ports() {
	[[ -f $CLAUDE_CONF ]] || return 0
	python3 - "$CLAUDE_CONF" <<'PY' 2>/dev/null || true
import json, re, sys

ports = set()

def walk(o):
    if isinstance(o, dict):
        servers = o.get("mcpServers")
        if isinstance(servers, dict):
            for spec in servers.values():
                url = spec.get("url") if isinstance(spec, dict) else None
                if not url:
                    continue
                if "localhost:" in url or "127.0.0.1:" in url:
                    m = re.search(r":(\d+)", url)
                    if m:
                        ports.add(int(m.group(1)))
        for v in o.values():
            walk(v)
    elif isinstance(o, list):
        for v in o:
            walk(v)

try:
    with open(sys.argv[1]) as fh:
        walk(json.load(fh))
except Exception:
    sys.exit(0)

print(" ".join(str(p) for p in sorted(ports)))
PY
}

# ---------------------------------------------------------------- drives

# ext4 image built straight from a directory, no mount and no root.
mkimage_from_dir() {
	local src=$1 out=$2 label=$3 size=$4
	# Round up to a whole MiB: firecracker warns about anything that is not a
	# multiple of the 512 byte sector size, and the tail would be invisible.
	local mib=$((1024 * 1024))
	size=$(((size + mib - 1) / mib * mib))
	rm -f "$out"
	truncate -s "$size" "$out"
	sbin mkfs.ext4 -q -F -L "$label" -d "$src" "$out"
}

# Lay the project out for imaging. Build artefacts are the difference between
# a 150K drive and a 10G one, so ignored files are left behind by default.
# Hardlinked where the filesystems allow it, so this copies no data.
stage_project() {
	local workdir=$1 stage=$2
	rm -rf "$stage"
	mkdir -p "$stage"

	local -a rs=(-a --link-dest="$workdir")
	if ((USE_GITIGNORE)) && [[ -d $workdir/.git ]]; then
		# Per-directory .gitignore rules, the same set git itself would skip.
		# .git is not covered by those, so the history still comes along.
		rs+=(--filter=':- .gitignore')
	fi
	local p
	for p in ${EXCLUDES+"${EXCLUDES[@]}"}; do
		rs+=(--exclude="$p")
	done

	rsync "${rs[@]}" "$workdir"/ "$stage"/ 2>/dev/null || true

	local full staged
	full=$(du -sb --apparent-size "$workdir" 2>/dev/null | cut -f1)
	staged=$(du -sb --apparent-size "$stage" 2>/dev/null | cut -f1)
	if ((${full:-0} > ${staged:-0} + 64 * 1024 * 1024)); then
		log "left behind $(numfmt --to=iec $((full - staged))) of ignored files (--all-files to include them)"
	fi
}

# Cheap stand-in for "has this tree changed": total apparent size and the
# newest mtime in it. Wrong only if an edit keeps both identical.
dir_fingerprint() {
	local dir=$1 size newest
	size=$(du -sb --apparent-size "$dir" 2>/dev/null | cut -f1)
	newest=$(find "$dir" -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
	echo "${size:-0}:${newest:-0}"
}

# A read-only drive for a directory that has not changed is the same drive it
# was last time, so build it once and keep it. Firecracker has no shared
# filesystem device and this host's ext4 has no reflinks, so a cache is as
# close to copy-on-write as this gets.
cached_ro_image() {
	local dir=$1 label=$2 idx=$3
	local slug img stamp want
	slug=$(project_slug "$dir")
	img="$STATE_DIR/ro-$slug.ext4"
	stamp="$STATE_DIR/ro-$slug.stamp"
	mkdir -p "$STATE_DIR"
	want=$(dir_fingerprint "$dir")

	if [[ -f $img && -f $stamp && $(cat "$stamp") == "$want" ]]; then
		echo "$img"
		return 0
	fi

	local stage="$RUN_DIR/extra$idx"
	# Same gitignore filtering as the project itself: a checkout's .venv or
	# node_modules is usually most of it and never what you wanted.
	stage_project "$dir" "$stage" >&2
	local bytes
	bytes=$(du -sb --apparent-size "$stage" 2>/dev/null | cut -f1)
	if ((bytes > 32 * 1024 * 1024 * 1024)); then
		die "--add-dir $dir is $((bytes / 1024 / 1024 / 1024))G - too big to put in a VM"
	fi
	# Same reasoning as the config drive: build beside it, then move, so a
	# concurrent run never attaches a partly written image.
	mkimage_from_dir "$stage" "$img.$BASHPID" "$label" "$(size_ro_dir "$stage")"
	mv -f "$img.$BASHPID" "$img"
	rm -rf "$stage"
	echo "$want" >"$stamp"
	echo "$img"
}

# Read-only drives never grow, so they only need their contents plus the
# filesystem's own overhead.
size_ro_dir() {
	local dir=$1 used
	used=$(du -sb --apparent-size "$dir" 2>/dev/null | cut -f1)
	echo $((${used:-0} * 11 / 10 + 128 * 1024 * 1024))
}

# Bytes needed to hold a directory, with room for the agent to work in.
size_for_dir() {
	local dir=$1 floor=$2 used
	used=$(du -sb --apparent-size "$dir" 2>/dev/null | cut -f1)
	used=${used:-0}
	local want=$((used * 2 + 2 * 1024 * 1024 * 1024))
	((want < floor)) && want=$floor
	echo "$want"
}

CFG_DRIVE="$IMAGES/agent-roconfig.ext4"
CFG_STAMP="$IMAGES/.roconfig.stamp"

config_fingerprint() {
	local parts=() p bin
	for p in "$CLAUDE_CONF" "$CLAUDE_HOME/settings.json" \
		"$CLAUDE_HOME/settings.local.json" "$CLAUDE_HOME/.credentials.json"; do
		[[ -e $p ]] && parts+=("$p:$(stat -Lc %Y "$p" 2>/dev/null || echo 0)")
	done
	for p in claude opencode; do
		bin=$(command -v "$p" 2>/dev/null || true)
		[[ -n $bin ]] && parts+=("$p:$(stat -Lc '%Y:%s' "$bin" 2>/dev/null || echo 0)")
	done
	printf '%s\n' ${parts+"${parts[@]}"} | sha256sum | cut -d' ' -f1
}

build_config_drive() {
	local want
	want=$(config_fingerprint)
	if [[ -f $CFG_DRIVE && -f $CFG_STAMP ]] && [[ $(cat "$CFG_STAMP") == "$want" ]]; then
		return 0
	fi

	# One drive, shared by every run. Two starting at once would both decide
	# it was stale and the second would delete the first's staging directory
	# mid-mkfs. Wait rather than race, then look again - the other one may
	# have just built exactly what we wanted.
	mkdir -p "$IMAGES"
	local lock_fd
	exec {lock_fd}>"$IMAGES/.roconfig.lock"
	flock "$lock_fd"
	if [[ -f $CFG_DRIVE && -f $CFG_STAMP ]] && [[ $(cat "$CFG_STAMP") == "$want" ]]; then
		exec {lock_fd}>&-
		return 0
	fi

	log "building the read-only config drive (host agent config + binaries)"
	local stage
	stage=$(mktemp -d "$IMAGES/.cfgstage.XXXXXX")
	mkdir -p "$stage/bin" "$stage/claude"

	local a bin
	for a in claude opencode; do
		bin=$(command -v "$a" 2>/dev/null || true)
		if [[ -n $bin ]]; then
			cp -L "$bin" "$stage/bin/$a"
			chmod +x "$stage/bin/$a"
			log "  $a $(basename "$(readlink -f "$bin")")"
		else
			log "  $a not installed on the host, skipping"
		fi
	done

	# Only the parts of the host config that mean anything in a fresh VM. The
	# rest is 1.6G of session history for projects that do not exist in there.
	local item
	for item in .credentials.json settings.json settings.local.json CLAUDE.md \
		agents commands skills plugins output-styles; do
		[[ -e $CLAUDE_HOME/$item ]] || continue
		rsync -a --copy-unsafe-links "$CLAUDE_HOME/$item" "$stage/claude/" 2>/dev/null || true
	done

	if [[ -d $OPENCODE_HOME ]]; then
		mkdir -p "$stage/opencode"
		rsync -a --copy-unsafe-links \
			--exclude=cache --exclude=.cache --exclude=log --exclude=logs \
			"$OPENCODE_HOME"/ "$stage/opencode"/ 2>/dev/null || true
	fi

	# Hooks point at host binaries that do not exist in the guest; leaving
	# them in produces a failed hook on every single tool call.
	if [[ -f $stage/claude/settings.json ]]; then
		python3 - "$stage/claude/settings.json" <<'PY' || true
import json, sys
p = sys.argv[1]
try:
    with open(p) as fh:
        d = json.load(fh)
except Exception:
    sys.exit(0)
if d.pop("hooks", None) is not None:
    with open(p, "w") as fh:
        json.dump(d, fh, indent=2)
    print("[firellm]   dropped hooks from settings (they point at host paths)",
          file=sys.stderr)
PY
	fi

	if [[ -f $CLAUDE_CONF ]]; then
		python3 - "$CLAUDE_CONF" "$stage/claude.json" <<'PY' || true
import json, sys

src, dst = sys.argv[1], sys.argv[2]
with open(src) as fh:
    d = json.load(fh)

# Per-project state refers to host paths that do not exist in the guest.
d.pop("projects", None)

servers = d.get("mcpServers")
if isinstance(servers, dict):
    kept, dropped = {}, []
    for name, spec in servers.items():
        url = spec.get("url") if isinstance(spec, dict) else None
        if url and ("localhost:" in url or "127.0.0.1:" in url):
            kept[name] = spec
        else:
            dropped.append(name)
    d["mcpServers"] = kept
    if dropped:
        print("[firellm]   MCP unavailable in guest (host stdio binaries): "
              + ", ".join(dropped), file=sys.stderr)
    if kept:
        print("[firellm]   MCP relayed over vsock: " + ", ".join(kept),
              file=sys.stderr)

d["hasCompletedOnboarding"] = True

with open(dst, "w") as fh:
    json.dump(d, fh, indent=2)
PY
	fi

	local size
	size=$(size_ro_dir "$stage")
	# Built beside the real one and moved into place, so a run that is already
	# using the old drive never sees a half-written file.
	mkimage_from_dir "$stage" "$CFG_DRIVE.$BASHPID" firellm-cfg "$size"
	mv -f "$CFG_DRIVE.$BASHPID" "$CFG_DRIVE"
	rm -rf "$stage"
	echo "$want" >"$CFG_STAMP"
	log "config drive: $(du -h --apparent-size "$CFG_DRIVE" | cut -f1)"
	exec {lock_fd}>&-
}

# ---------------------------------------------------------------- state

# Everything the agent writes under its home directory - sessions, history,
# todos - lands on a per-project drive that outlives the VM. That is what
# makes `--continue` and `--resume` work across runs: without it every VM
# starts with no memory of the last one.

STATE_FD=""
STATE_PERSISTENT=0
STATE_DRIVE=""
SLUG=""

project_slug() {
	local dir=$1 hash
	hash=$(printf '%s' "$dir" | sha256sum | cut -c1-8)
	echo "$(basename "$dir" | tr -c 'A-Za-z0-9._-' '-')-$hash"
}

# Sets STATE_DRIVE, and STATE_PERSISTENT if this run holds the project lock.
# Same reason as alloc_net_slot: it cannot print its answer, because the
# subshell of a command substitution would drop both the lock and the flag.
ensure_state_drive() {
	local workdir=$1 run_dir=$2 img size
	SLUG=$(project_slug "$workdir")
	local slug=$SLUG
	img="$STATE_DIR/$slug.ext4"
	mkdir -p "$STATE_DIR"

	if [[ ! -f $img ]]; then
		local seed
		seed=$(mktemp -d)
		mkdir -p "$seed/upper" "$seed/work"
		size=${FIRELLM_STATE_SIZE:-$((3 * 1024 * 1024 * 1024))}
		mkimage_from_dir "$seed" "$img" firellm-state "$size"
		rm -rf "$seed"
		log "new agent state drive for this project: $(basename "$img")"
	fi

	# Two VMs writing one ext4 image would corrupt it, so a second concurrent
	# run on the same project gets a throwaway copy instead.
	exec {STATE_FD}>"$STATE_DIR/$slug.lock"
	if flock -n "$STATE_FD"; then
		STATE_PERSISTENT=1
		STATE_DRIVE=$img
	else
		log "WARNING: another run holds this project's state drive."
		log "         using a private copy - this session will not be resumable."
		cp --sparse=always "$img" "$run_dir/state.ext4"
		STATE_DRIVE="$run_dir/state.ext4"
	fi
}

# Claude Code keys a project's transcripts by its working directory, with
# every non-alphanumeric character turned into a dash. The guest works at the
# same path the host does, so the key is the same on both sides.
claude_project_slug() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'
}

# Copies this project's host transcripts into the guest's agent home. Verbatim
# - the guest sees the project at the same absolute path, so every path in the
# transcript already points at the right thing. Only the state drive is
# touched; the host's own sessions are read and never modified.
import_host_sessions() {
	local workdir=$1 img=$2 only=${3:-} host_dir slug
	slug=$(claude_project_slug "$workdir")
	host_dir="$CLAUDE_HOME/projects/$slug"

	if [[ ! -d $host_dir ]]; then
		log "no host sessions recorded for $workdir, nothing to import"
		return 0
	fi
	if ! compgen -G "$host_dir/*.jsonl" >/dev/null; then
		log "no transcripts in $host_dir"
		return 0
	fi

	local tmp size
	tmp=$(mktemp -d)
	size=$(stat -c %s "$img")

	# Pull the drive apart, add the sessions, put it back together. Writing
	# into a mounted image would need root; this does not.
	sbin debugfs -R "rdump / $tmp" "$img" >/dev/null 2>&1 || true
	rm -rf "$tmp/lost+found"

	local dst="$tmp/upper/claude/projects/$slug"
	mkdir -p "$dst"

	local n=0 f
	for f in "$host_dir"/*.jsonl; do
		[[ -f $f ]] || continue
		if [[ -n $only && $(basename "$f") != "$only"* ]]; then
			continue
		fi
		cp -f "$f" "$dst/"
		n=$((n + 1))
	done

	if ((n == 0)); then
		log "no matching sessions to import"
		rm -rf "$tmp"
		return 0
	fi

	mkimage_from_dir "$tmp" "$img.new" firellm-state "$size"
	mv -f "$img.new" "$img"
	rm -rf "$tmp"
	log "imported $n host session(s), resumable at their original paths"
}

cmd_state() {
	local sub=${1:-list}
	shift || true
	case "$sub" in
	list)
		if ! compgen -G "$STATE_DIR/*.ext4" >/dev/null; then
			echo "no project state yet"
			return 0
		fi
		local f
		for f in "$STATE_DIR"/*.ext4; do
			printf '%-44s %s\n' "$(basename "$f" .ext4)" \
				"$(du -h --apparent-size "$f" | cut -f1)"
		done
		;;
	sessions)
		local dir=${1:-$PWD} img tmp
		img="$STATE_DIR/$(project_slug "$(cd "$dir" && pwd)").ext4"
		[[ -f $img ]] || die "no state for $dir yet"
		tmp=$(mktemp -d)
		sbin debugfs -R "rdump /upper/claude/projects $tmp" "$img" >/dev/null 2>&1 || true
		if compgen -G "$tmp/projects/*/*.jsonl" >/dev/null; then
			local s
			# Newest last, so the most useful one is next to the prompt.
			while IFS= read -r s; do
				printf '%s  %s\n' "$(date -r "$s" '+%Y-%m-%d %H:%M')" \
					"$(basename "$s" .jsonl)"
			done < <(find "$tmp/projects" -name '*.jsonl' -printf '%T@ %p\n' |
				sort -n | cut -d' ' -f2-)
			echo
			echo "resume with:  firellm claude --resume <id> 'next thing'"
		else
			echo "no sessions recorded for $dir yet"
		fi
		rm -rf "$tmp"
		;;
	reset)
		local dir=${1:-$PWD} img
		img="$STATE_DIR/$(project_slug "$(cd "$dir" && pwd)").ext4"
		[[ -f $img ]] || die "no state for $dir"
		rm -f "$img"
		log "removed $img - the next run starts with a clean agent home"
		;;
	*)
		die "usage: firellm state [list|sessions [dir]|reset [dir]]"
		;;
	esac
}

# ---------------------------------------------------------------- networking

NET_SLOT=""
TAP_DEV=""
NET_ADOPTED=0
NET_FD=""

# Each VM gets its own tap and its own /30, so several can run at once. A slot
# is held with a lock file rather than by looking at what exists, because a
# persistent tap left behind by net-setup exists whether or not it is in use.
#
# Sets NET_SLOT and NET_FD rather than printing. It cannot print: a command
# substitution runs in a subshell, so the descriptor holding the lock would be
# closed the moment it returned, and every VM would take the same slot.
alloc_net_slot() {
	local s fd
	mkdir -p "$STATE_DIR/net"
	for ((s = 1; s <= 250; s++)); do
		exec {fd}>"$STATE_DIR/net/$s.lock"
		if ! flock -n "$fd"; then
			exec {fd}>&-
			continue
		fi
		# The lock says no live firellm holds this slot, which is not the same
		# as the tap being free: a VM outlives a firellm that was killed
		# rather than asked to stop, and it keeps the device open. A tap with
		# a process attached has carrier; an idle one does not.
		if [[ $(cat "/sys/class/net/fcllm$s/carrier" 2>/dev/null || echo 0) == 1 ]]; then
			log "fcllm$s is still in use by something, trying the next slot"
			exec {fd}>&-
			continue
		fi
		NET_FD=$fd
		NET_SLOT=$s
		return 0
	done
	return 1
}

# One-time root setup for a tap. Made persistent and owned by the invoking
# user, so afterwards firecracker can open it with no privileges at all.
net_create_tap() {
	local dev=$1 slot=$2 owner
	# Under sudo, id -u is 0. The tap has to belong to whoever will actually
	# run firecracker, or the whole point of making it persistent is lost.
	owner=${SUDO_UID:-$(id -u)}
	priv ip tuntap add dev "$dev" mode tap user "$owner"
	priv ip addr add "172.16.$slot.1/30" dev "$dev"
	priv ip link set "$dev" up
	priv sysctl -qw net.ipv4.ip_forward=1

	# Docker sets the FORWARD policy to DROP, so the masquerade rule alone is
	# not enough: the traffic has to be allowed through the filter table too.
	priv iptables -t nat -C POSTROUTING -s "172.16.$slot.0/30" ! -o "$dev" \
		-j MASQUERADE 2>/dev/null ||
		priv iptables -t nat -A POSTROUTING -s "172.16.$slot.0/30" ! -o "$dev" -j MASQUERADE
	priv iptables -C FORWARD -i "$dev" -j ACCEPT 2>/dev/null ||
		priv iptables -I FORWARD 1 -i "$dev" -j ACCEPT
	priv iptables -C FORWARD -o "$dev" -j ACCEPT 2>/dev/null ||
		priv iptables -I FORWARD 1 -o "$dev" -j ACCEPT
}

net_up() {
	alloc_net_slot || die "no free network slot (250 VMs already running?)"
	TAP_DEV="fcllm$NET_SLOT"

	if ip link show "$TAP_DEV" >/dev/null 2>&1; then
		# Left in place by net-setup. Nothing here needs root.
		NET_ADOPTED=1
		log "network: $TAP_DEV (already set up), guest 172.16.$NET_SLOT.2"
		return 0
	fi

	log "network: $TAP_DEV, guest 172.16.$NET_SLOT.2 via 172.16.$NET_SLOT.1"
	net_create_tap "$TAP_DEV" "$NET_SLOT"
}

net_down() {
	[[ -n $TAP_DEV ]] || return 0
	if ((NET_ADOPTED == 0)); then
		priv iptables -t nat -D POSTROUTING -s "172.16.$NET_SLOT.0/30" \
			! -o "$TAP_DEV" -j MASQUERADE 2>/dev/null || true
		priv iptables -D FORWARD -i "$TAP_DEV" -j ACCEPT 2>/dev/null || true
		priv iptables -D FORWARD -o "$TAP_DEV" -j ACCEPT 2>/dev/null || true
		priv ip link del "$TAP_DEV" 2>/dev/null || true
	fi
	TAP_DEV=""
	[[ -n $NET_FD ]] && exec {NET_FD}>&- 2>/dev/null
	NET_FD=""
}

# Pre-create taps so ordinary runs need no privileges for networking. One
# sudo now instead of one per run.
cmd_net_setup() {
	local count=4 s dev
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--count)
			count="$2"
			shift 2
			;;
		--teardown)
			for ((s = 1; s <= 250; s++)); do
				dev="fcllm$s"
				ip link show "$dev" >/dev/null 2>&1 || continue
				priv iptables -t nat -D POSTROUTING -s "172.16.$s.0/30" \
					! -o "$dev" -j MASQUERADE 2>/dev/null || true
				priv iptables -D FORWARD -i "$dev" -j ACCEPT 2>/dev/null || true
				priv iptables -D FORWARD -o "$dev" -j ACCEPT 2>/dev/null || true
				priv ip link del "$dev" 2>/dev/null || true
				log "removed $dev"
			done
			return 0
			;;
		*) die "usage: firellm net-setup [--count N] [--teardown]" ;;
		esac
	done

	for ((s = 1; s <= count; s++)); do
		dev="fcllm$s"
		if ip link show "$dev" >/dev/null 2>&1; then
			log "$dev already there"
			continue
		fi
		net_create_tap "$dev" "$s"
		log "$dev up, for a guest on 172.16.$s.2"
	done
	echo
	echo "  $count VMs can now have a network without any further privileges."
	echo "  Undo with: firellm net-setup --teardown"
}

# ---------------------------------------------------------------- MCP relay

RELAY_PIDS=()

# Firecracker turns a guest connection to CID 2 port N into a connection to
# the unix socket <uds_path>_N on the host. Listening there and forwarding to
# 127.0.0.1:N is what makes the guest's localhost:N the host's localhost:N.
# The host MCP servers see an ordinary local connection and need no changes.
relays_up() {
	local jail_dir=$1 ports=$2 p
	[[ -n $ports ]] || return 0
	if ! command -v socat >/dev/null 2>&1; then
		log "WARNING: socat not installed on the host, MCP will not be reachable"
		return 0
	fi
	for p in $ports; do
		# Bound from inside the jail directory on purpose. A unix socket path
		# is capped at 108 bytes, and the absolute path to a run's jail is
		# already longer than that for any normally placed checkout.
		(cd "$jail_dir" && exec socat \
			"UNIX-LISTEN:firecracker-vsock.sock_$p,fork,unlink-early" \
			"TCP:127.0.0.1:$p") >>"$RUN_DIR/relays.log" 2>&1 &
		RELAY_PIDS+=($!)
	done
	# Give socat time to create the sockets: firecracker resets the guest's
	# connection if the matching one is not there yet.
	local waited=0
	while ((waited < 30)); do
		local missing=0
		for p in $ports; do
			[[ -S $jail_dir/firecracker-vsock.sock_$p ]] || missing=1
		done
		((missing)) || break
		sleep 0.1
		waited=$((waited + 1))
	done
	log "host reachable from the guest on ports: $ports"
}

relays_down() {
	local pid
	for pid in ${RELAY_PIDS+"${RELAY_PIDS[@]}"}; do
		kill "$pid" 2>/dev/null || true
	done
	RELAY_PIDS=()
}

# ---------------------------------------------------------------- arguments

# Turn a natural command line into one that actually runs unattended. An
# agent sitting at an interactive prompt with no tty just hangs until the
# timeout, which is the least useful possible outcome for autopilot.
massage_args() {
	local agent=$1
	shift
	local -a in=("$@") out=()
	local a has_print=0 has_perm=0 subcmd=0

	for a in ${in+"${in[@]}"}; do
		case "$a" in
		-p | --print) has_print=1 ;;
		--dangerously-skip-permissions | --permission-mode | --allowedTools | \
			--allowed-tools) has_perm=1 ;;
		esac
	done

	if [[ $agent == claude ]]; then
		((has_print)) || out+=(-p)
		# The whole point of the VM is that the agent does not need to ask.
		((has_perm)) || out+=(--dangerously-skip-permissions)
	elif [[ $agent == opencode ]]; then
		case "${in[0]:-}" in
		run | serve | models | auth | providers | agent | session | stats | \
			export | import | github | pr | mcp | debug | upgrade | plugin | \
			db | web | attach | acp | completion | uninstall) subcmd=1 ;;
		esac
		((subcmd)) || out+=(run)
	fi

	printf '%s\0' ${out+"${out[@]}"} ${in+"${in[@]}"}
}

# Is there an actual task in here, as opposed to only flags?
#
# This is what decides unattended versus interactive. Arguments alone are not
# the test: `--resume <id>` is a flag and a session id, not something to do,
# and treating it as a task produced `claude -p --resume <id>` with nothing to
# respond to - which fails on its first line.
has_prompt() {
	local -a in=("$@")
	local i skip=0

	for ((i = 0; i < ${#in[@]}; i++)); do
		local a=${in[i]}
		if ((skip)); then
			skip=0
			continue
		fi
		case "$a" in
		# Flags whose value would otherwise look like a task.
		-r | --resume | --model | --agent | --settings | --permission-mode | \
			--append-system-prompt | --system-prompt | --autocompact | \
			--output-format | --input-format | --session-id | --fallback-model)
			skip=1
			;;
		-*) ;;
		*) return 0 ;;
		esac
	done
	return 1
}

# ---------------------------------------------------------------- launch

RUN_DIR=""
JAIL_DIR=""

cleanup_run() {
	local status=$?
	trap - EXIT INT TERM
	relays_down
	net_down
	if [[ $KEEP -eq 0 ]]; then
		[[ -n $RUN_DIR ]] && rm -f "$RUN_DIR"/*.ext4
		[[ -n $JAIL_DIR ]] && rm -rf "$(dirname "$JAIL_DIR")"
	fi
	return $status
}

launch() {
	AGENT=$1
	shift

	local -a agent_args=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--workdir | --project)
			WORKDIR="$2"
			shift 2
			;;
		--mem)
			MEM="$2"
			shift 2
			;;
		--vcpu | --cpus)
			VCPU="$2"
			shift 2
			;;
		--timeout)
			TIMEOUT="$2"
			shift 2
			;;
		--no-net)
			NONET=1
			shift
			;;
		--no-jail)
			NOJAIL=1
			shift
			;;
		--no-sync)
			SYNC_BACK=0
			shift
			;;
		--keep)
			KEEP=1
			shift
			;;
		--cgroups)
			CGROUPS=1
			shift
			;;
		--debug-boot)
			QUIET_BOOT=0
			shift
			;;
		--no-auto-flags)
			AUTO_FLAGS=0
			shift
			;;
		--add-dir)
			EXTRA_DIRS+=("$2")
			shift 2
			;;
		--host-port)
			HOST_PORTS+=("$2")
			shift 2
			;;
		--exclude)
			EXCLUDES+=("$2")
			shift 2
			;;
		--all-files)
			USE_GITIGNORE=0
			shift
			;;
		--no-mcp)
			NO_MCP=1
			shift
			;;
		--import-sessions)
			IMPORT_SESSIONS=1
			shift
			;;
		--no-import-sessions)
			IMPORT_SESSIONS=0
			shift
			;;
		--fresh)
			RESUME_TREE=0
			shift
			;;
		--resume-tree)
			RESUME_TREE=1
			shift
			;;
		--)
			shift
			# With `firellm exec ... -- cmd args`, the command itself is the
			# first thing after the separator.
			if [[ -z $AGENT && $# -gt 0 ]]; then
				AGENT="$1"
				shift
			fi
			agent_args+=("$@")
			break
			;;
		*)
			# `firellm exec` passes an empty agent so that the first thing
			# that is not a firellm option becomes the command to run.
			if [[ -z $AGENT ]]; then
				AGENT="$1"
			else
				agent_args+=("$1")
			fi
			shift
			;;
		esac
	done
	[[ -n $AGENT ]] || die "no command given"

	resolve_assets
	WORKDIR=$(cd "$WORKDIR" && pwd) || die "workdir does not exist"
	# The project directory is a way into the guest just as much as --add-dir
	# is. Matters most if launching is ever exposed to something automated.
	refuse_if_sensitive "$WORKDIR"

	# A task means unattended. Flags on their own - `--resume <id>`, a model
	# choice - mean you want the session, and you are the one driving it, so
	# you get a console with those flags passed straight through.
	local mode=auto
	if [[ $AGENT == shell ]]; then
		mode=interactive
	elif [[ $AGENT == claude || $AGENT == opencode ]]; then
		has_prompt ${agent_args+"${agent_args[@]}"} || mode=interactive
	elif ((${#agent_args[@]} == 0)); then
		mode=interactive
	fi

	# Continuing a conversation but starting from the pristine host tree would
	# be nonsense: the agent would be told it already made changes that are
	# not there. So --continue/--resume carries the working tree forward too.
	if [[ $RESUME_TREE == auto ]]; then
		RESUME_TREE=0
		# Only for the agents whose -c and -r actually mean continue and
		# resume. Guessing from any command's flags is wrong: `bash -c` is
		# not a request to carry the last run's working tree forward.
		if [[ $AGENT == claude || $AGENT == opencode ]]; then
			local a
			for a in ${agent_args+"${agent_args[@]}"}; do
				case "$a" in
				-c | --continue | -r | --resume) RESUME_TREE=1 ;;
				esac
			done
		fi
	fi

	# Known issue, cause not pinned down. Firecracker wires the guest serial
	# port to its own stdin and stdout - that is what the console is. Run the
	# jailer under sudo with those on a terminal and firecracker stops right
	# after opening its API socket: silently, exit 0, before it even reads the
	# config. Unattended runs pipe their output through tee, never touch a
	# terminal, and are unaffected. Wrapping it in script(1) to give it a
	# private pty does not help, so sudo's use_pty is not the whole story.
	#
	# Giving up the jailer costs the chroot, the dropped uid and the pid
	# namespace around the VMM process. The guest is still a KVM VM with its
	# own kernel and no view of this filesystem, which is the boundary that
	# was the point.
	if [[ $mode == interactive ]] && ((NOJAIL == 0)); then
		NOJAIL=1
		log "interactive: not jailed - a jailed guest console dies on a terminal"
	fi

	local id
	# BASHPID, not $$: in a subshell $$ is still the parent's pid, so two runs
	# launched together from one shell would collide on the same run id.
	id="firellm-$(date +%Y%m%d-%H%M%S)-$BASHPID"
	RUN_DIR="$RUNS/$id"
	JAIL_DIR="$JAIL_BASE/firecracker/$id/root"
	mkdir -p "$RUN_DIR" "$JAIL_DIR"
	trap cleanup_run EXIT INT TERM

	log "run $id  agent=$AGENT  mode=$mode  project=$WORKDIR"

	build_config_drive

	# Everything the guest should be able to reach on the host's loopback:
	# MCP servers found in the config, plus whatever --host-port asked for
	# (a local llama-server or any other OpenAI-compatible endpoint).
	local relay_ports
	local -a mcp=()
	((NO_MCP)) || read -r -a mcp <<<"$(discover_mcp_ports)"
	# The `|| true` is load-bearing: with nothing to forward, grep matches
	# nothing and exits 1, which under `set -e` takes the whole run down.
	relay_ports=$(printf '%s\n' ${mcp+"${mcp[@]}"} ${HOST_PORTS+"${HOST_PORTS[@]}"} |
		grep -E '^[0-9]+$' | sort -un | tr '\n' ' ' || true)
	relay_ports=${relay_ports% }

	# --- per-project agent state, so --continue and --resume have something
	#     to continue from. Taken first: it decides where the src drive lives.
	ensure_state_drive "$WORKDIR" "$RUN_DIR"
	local state_drive=$STATE_DRIVE

	# Continuing a conversation that only exists on the host means bringing
	# the transcript in. Done once per project unless asked for again.
	local imported_marker="$STATE_DIR/$SLUG.imported"
	if [[ $IMPORT_SESSIONS == 1 ]] ||
		{ [[ $IMPORT_SESSIONS == auto ]] && ((RESUME_TREE)) && [[ ! -f $imported_marker ]]; }; then
		import_host_sessions "$WORKDIR" "$state_drive"
		touch "$imported_marker"
	fi

	# --- src drive. Persistent per project when we hold the lock, so a
	#     continuation run resumes the tree the last run left behind.
	local src_drive src_size
	if ((STATE_PERSISTENT)); then
		src_drive="$STATE_DIR/$SLUG-src.ext4"
	else
		src_drive="$RUN_DIR/src.ext4"
	fi

	if ((RESUME_TREE)) && [[ -f $src_drive ]]; then
		log "resuming the working tree from the previous run"
	else
		((RESUME_TREE)) && log "no previous tree for this project, starting from $WORKDIR"
		local src_stage="$RUN_DIR/src"
		stage_project "$WORKDIR" "$src_stage"
		src_size=$(size_for_dir "$src_stage" $((4 * 1024 * 1024 * 1024)))
		log "packing $WORKDIR into a $((src_size / 1024 / 1024 / 1024))G drive"
		mkimage_from_dir "$src_stage" "$src_drive" firellm-src "$src_size"
		rm -rf "$src_stage"
	fi

	# --- extra read-only context: sibling projects, notes, whatever. These
	#     are copies, so the guest can read them and nothing goes back.
	local -a extra_drives=() extra_spec=()
	local n=0 d
	for d in ${EXTRA_DIRS+"${EXTRA_DIRS[@]}"}; do
		d=$(cd "$d" 2>/dev/null && pwd) || die "--add-dir: no such directory: $d"
		refuse_if_sensitive "$d"
		n=$((n + 1))
		# Label derived from the path, not from the order it was given in, so
		# a cached image is never relabelled out from under a running VM.
		local label img
		label="fl-$(printf '%s' "$d" | sha256sum | cut -c1-8)"
		img=$(cached_ro_image "$d" "$label" "$n")
		log "adding $d read-only at $d"
		extra_drives+=("$img")
		# Mounted where it lives on the host, not under /mnt, so references
		# to it from anywhere still resolve.
		extra_spec+=("$label:$d")
	done

	# --- control drive: this run's parameters, read-only in the guest
	local ctl_stage="$RUN_DIR/ctl"
	mkdir -p "$ctl_stage"
	{
		echo "FIRELLM_ID=$id"
		echo "FIRELLM_MODE=$mode"
		[[ $AGENT != shell ]] && echo "FIRELLM_AGENT=$AGENT"
		echo "FIRELLM_TIMEOUT=$TIMEOUT"
		echo "FIRELLM_RELAY_PORTS='$relay_ports'"
		# The guest mirrors the host's layout: same user, same uid, same home,
		# same project path. An absolute path in a resumed transcript, in a
		# CLAUDE.md or in a tool call then means the same thing in both places,
		# and nothing has to be rewritten on the way in or out.
		# A serial console has no window size and no SIGWINCH, so the guest
		# would sit at the 80x24 default whatever your terminal is - which a
		# full-screen TUI renders into and then misplaces every keystroke.
		# Taken once, at launch.
		if [[ -t 0 ]]; then
			local rows cols
			read -r rows cols < <(stty size 2>/dev/null || echo "")
			[[ -n ${rows:-} && -n ${cols:-} && $rows != 0 && $cols != 0 ]] &&
				printf 'FIRELLM_ROWS=%s\nFIRELLM_COLS=%s\n' "$rows" "$cols"
		fi
		echo "FIRELLM_USER='$(id -un)'"
		echo "FIRELLM_UID=$(id -u)"
		echo "FIRELLM_GID=$(id -g)"
		echo "FIRELLM_HOME='$HOME'"
		echo "FIRELLM_PROJECT='$WORKDIR'"
		echo "FIRELLM_EXTRA='${extra_spec[*]-}'"
		# Read from the project, not from wherever firellm happens to live, so
		# a repo-local identity wins the same way it would on the host.
		echo "FIRELLM_GIT_NAME='$(git -C "$WORKDIR" config --get user.name 2>/dev/null || true)'"
		echo "FIRELLM_GIT_EMAIL='$(git -C "$WORKDIR" config --get user.email 2>/dev/null || true)'"
		if [[ $NONET -eq 0 ]]; then
			echo "FIRELLM_GUEST_IP=172.16.SLOT.2/30"
			echo "FIRELLM_GATEWAY=172.16.SLOT.1"
			echo "FIRELLM_DNS='1.1.1.1 8.8.8.8'"
		fi
	} >"$ctl_stage/env"
	cp -f "$GUEST/firellm-context.md" "$ctl_stage/context.md"

	# The guest scripts ride along on the control drive and take precedence
	# over the copies baked into the image, so changing the harness does not
	# mean rebuilding a 6G rootfs.
	local g
	for g in firellm-setup.sh agent-entrypoint.sh profile.sh; do
		install -m 0755 "$GUEST/$g" "$ctl_stage/$g"
	done

	if [[ $mode == auto ]]; then
		# The presence of this file is what starts firellm-agent.service.
		if ((AUTO_FLAGS)); then
			massage_args "$AGENT" ${agent_args+"${agent_args[@]}"} >"$ctl_stage/args"
		else
			printf '%s\0' ${agent_args+"${agent_args[@]}"} >"$ctl_stage/args"
		fi
		log "agent command: $AGENT $(tr '\0' ' ' <"$ctl_stage/args")"
	elif ((${#agent_args[@]} > 0)); then
		# Interactive, but with flags to hand the agent. Under a different
		# name, or the agent service would take it as an unattended run.
		local -a iargs=(${agent_args+"${agent_args[@]}"})
		# No -p here - there is a terminal, and you are on it. Permissions
		# still get bypassed: the VM is the boundary, not the prompt.
		if ((AUTO_FLAGS)) && [[ $AGENT == claude ]]; then
			local a has_perm=0
			for a in "${iargs[@]}"; do
				case "$a" in
				--dangerously-skip-permissions | --permission-mode | \
					--allowedTools | --allowed-tools) has_perm=1 ;;
				esac
			done
			((has_perm)) || iargs=(--dangerously-skip-permissions "${iargs[@]}")
		fi
		printf '%s\0' "${iargs[@]}" >"$ctl_stage/interactive-args"
		log "interactive: $AGENT ${iargs[*]}"
	fi

	# --- networking, then patch the allocated slot into the control drive
	if [[ $NONET -eq 0 ]]; then
		net_up
		sed -i "s/172\.16\.SLOT\./172.16.$NET_SLOT./g" "$ctl_stage/env"
	fi

	local ctl_drive="$RUN_DIR/ctl.ext4"
	mkimage_from_dir "$ctl_stage" "$ctl_drive" firellm-ctl "$(size_ro_dir "$ctl_stage")"

	# --- per-run copy of the rootfs, so the guest can wreck it freely
	local root_drive="$RUN_DIR/root.ext4"
	cp --sparse=always "$ROOTFS" "$root_drive"

	# --- jail: everything the VM touches has to live inside the chroot
	local f
	for f in "$KERNEL" "$root_drive" "$src_drive" "$CFG_DRIVE" "$ctl_drive" \
		"$state_drive" ${extra_drives+"${extra_drives[@]}"}; do
		ln "$f" "$JAIL_DIR/$(basename "$f")" 2>/dev/null ||
			cp "$f" "$JAIL_DIR/$(basename "$f")"
	done

	local extra_json="" i=0
	for f in ${extra_drives+"${extra_drives[@]}"}; do
		i=$((i + 1))
		extra_json="$extra_json,
    {\"drive_id\": \"extra$i\", \"path_on_host\": \"$(basename "$f")\", \"is_root_device\": false, \"is_read_only\": true}"
	done

	local net_ifaces="[]"
	if [[ -n $TAP_DEV ]]; then
		local mac
		mac=$(printf '06:00:ac:10:%02x:02' "$NET_SLOT")
		net_ifaces="[{\"iface_id\":\"eth0\",\"guest_mac\":\"$mac\",\"host_dev_name\":\"$TAP_DEV\"}]"
	fi

	local boot_args="console=ttyS0 reboot=k panic=1 pci=off"
	((QUIET_BOOT)) && boot_args="$boot_args quiet loglevel=3 systemd.show_status=false"

	local cid=$((3 + ${NET_SLOT:-0}))
	cat >"$JAIL_DIR/vm-config.json" <<EOF
{
  "boot-source": {
    "kernel_image_path": "$(basename "$KERNEL")",
    "boot_args": "$boot_args"
  },
  "drives": [
    {"drive_id": "rootfs",   "path_on_host": "$(basename "$root_drive")", "is_root_device": true,  "is_read_only": false},
    {"drive_id": "src",      "path_on_host": "$(basename "$src_drive")",  "is_root_device": false, "is_read_only": false},
    {"drive_id": "roconfig", "path_on_host": "$(basename "$CFG_DRIVE")",  "is_root_device": false, "is_read_only": true},
    {"drive_id": "control",  "path_on_host": "$(basename "$ctl_drive")",  "is_root_device": false, "is_read_only": true},
    {"drive_id": "state",    "path_on_host": "$(basename "$state_drive")","is_root_device": false, "is_read_only": false}$extra_json
  ],
  "machine-config": {"vcpu_count": $VCPU, "mem_size_mib": $MEM},
  "network-interfaces": $net_ifaces,
  "vsock": {"guest_cid": $cid, "uds_path": "firecracker-vsock.sock"}
}
EOF

	relays_up "$JAIL_DIR" "$relay_ports"

	local -a jargs=(
		--id "$id"
		--exec-file "$FC"
		--uid "$(id -u)"
		--gid "$(id -g)"
		--chroot-base-dir "$JAIL_BASE"
		--new-pid-ns
	)
	if ((CGROUPS)); then
		jargs+=(
			--cgroup-version 2
			--cgroup "memory.max=$(((MEM + 512) * 1024 * 1024))"
			--cgroup "cpu.max=$((VCPU * 100000)) 100000"
			--cgroup "pids.max=4096"
		)
	fi
	jargs+=(-- --api-sock /firecracker.socket --config-file /vm-config.json)

	# The VM boundary is Firecracker and KVM either way. The jailer adds a
	# chroot, a dropped uid and a private pid namespace around the VMM
	# process itself - defence in depth against a VMM escape, and the only
	# part that needs root. Without it you still get a real VM.
	local -a cmd=()
	if ((NOJAIL)); then
		log "WARNING: --no-jail, the VMM runs unconfined on the host"
		cmd=("$FC" --api-sock firecracker.socket --config-file vm-config.json)
	else
		cmd=(${SUDO+"${SUDO[@]}"} "$JAILER" "${jargs[@]}")
	fi

	log "booting ($VCPU vcpu, ${MEM}M)"
	echo >&2

	local rc=0
	if [[ $mode == interactive ]]; then
		# No pipe: firecracker hands the guest serial port straight to this
		# terminal, and a pipe would break the tty the agent's UI needs.
		(cd "$JAIL_DIR" && "${cmd[@]}") || rc=$?
	else
		(cd "$JAIL_DIR" && "${cmd[@]}") 2>&1 | tee "$RUN_DIR/console.log" || rc=$?
	fi

	echo >&2
	log "VM exited (status $rc)"

	if ((SYNC_BACK)); then
		local out_dir="${WORKDIR}-${id#firellm-}"
		log "copying /src out to $out_dir"
		extract_image "$src_drive" "$out_dir"
		local st="$out_dir/.firellm-exit-status"
		if [[ -f $st ]]; then
			log "agent exit status: $(cat "$st")"
			rm -f "$st"
		fi
		echo
		echo "  result:  $out_dir"
		echo "  diff:    diff -ru --exclude=.git '$WORKDIR' '$out_dir' | less"
		[[ -f $RUN_DIR/console.log ]] && echo "  console: $RUN_DIR/console.log"
		if ((STATE_PERSISTENT)); then
			echo "  resume:  firellm $AGENT --continue 'and now also ...'"
			echo "           firellm state sessions"
		fi
		echo
	fi

	return $rc
}

# Read an ext4 image without mounting it, so no root is needed. Files the
# guest created as root come out owned by you, which is what you want anyway.
extract_image() {
	local img=$1 dest=$2
	mkdir -p "$dest"
	sbin debugfs -R "rdump / $dest" "$img" >/dev/null 2>&1 ||
		log "WARNING: extraction reported errors, check $dest"
	rm -rf "$dest/lost+found"
}

# ---------------------------------------------------------------- commands

cmd_extract() {
	local id=${1:-}
	[[ -n $id ]] || die "usage: firellm extract <run-id> [dest]"
	local img="$RUNS/$id/src.ext4"
	[[ -f $img ]] || die "no src drive for run $id (already cleaned up?)"
	local dest=${2:-$RUNS/$id/src}
	log "extracting $img to $dest"
	extract_image "$img" "$dest"
	echo "$dest"
}

cmd_list() {
	if [[ ! -d $RUNS ]]; then
		echo "no runs yet"
		return 0
	fi
	local d id state
	for d in "$RUNS"/*/; do
		[[ -d $d ]] || continue
		id=$(basename "$d")
		state="cleaned"
		compgen -G "$d*.ext4" >/dev/null && state="drives kept"
		printf '%-40s %s\n' "$id" "$state"
	done
}

cmd_gc() {
	local keep=${1:-5} n=0 d
	[[ -d $RUNS ]] || return 0
	# Newest first; anything past the keep count goes entirely.
	while IFS= read -r d; do
		n=$((n + 1))
		if ((n > keep)); then
			log "removing $(basename "$d")"
			rm -rf "$d"
		else
			rm -f "$d"/*.ext4
		fi
	done < <(find "$RUNS" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
		sort -rn | cut -d' ' -f2-)
	rm -rf "${JAIL_BASE:?}/firecracker" 2>/dev/null || true
	log "kept the $keep most recent runs (logs only)"
}

cmd_doctor() {
	local ok=0 bad=0
	check() {
		if eval "$2" >/dev/null 2>&1; then
			printf '  ok    %s\n' "$1"
			ok=$((ok + 1))
		else
			printf '  FAIL  %s\n' "$1"
			bad=$((bad + 1))
		fi
	}
	echo "firellm doctor"
	check "kvm accessible (/dev/kvm)" "test -r /dev/kvm -a -w /dev/kvm"
	check "firecracker installed" "test -x '$FC'"
	check "jailer installed" "test -x '$JAILER'"
	check "guest kernel present" "compgen -G '$IMAGES/vmlinux-*'"
	check "guest rootfs built" "test -f '$IMAGES/agent-firellm.ext4'"
	check "docker usable (for prepare)" "docker info"
	check "mkfs.ext4 present" "command -v mkfs.ext4 || test -x /usr/sbin/mkfs.ext4"
	check "debugfs present" "command -v debugfs || test -x /usr/sbin/debugfs"
	check "socat present (MCP relay)" "command -v socat"
	check "rsync present" "command -v rsync"
	check "iptables present" "command -v iptables || test -x /usr/sbin/iptables"
	# The jailer specifically, not sudo in general: a correctly scoped rule
	# grants this one binary, so `sudo -n true` failing proves nothing.
	check "jailer runs without a password" "sudo -n '$JAILER' --version"
	check "a tap is ready (firellm net-setup)" "ip link show fcllm1"
	check "claude on host" "command -v claude"
	echo
	echo "  $ok ok, $bad failed"
	if ! sudo -n "$JAILER" --version >/dev/null 2>&1; then
		echo
		echo "  Jailed runs will prompt for a password. To stop that:"
		echo "      sudo $SCRIPTS/install-privileged.sh"
		echo "  Or skip the jailer entirely with --no-jail."
	fi
	if ! ip link show fcllm1 >/dev/null 2>&1; then
		echo
		echo "  Networking will need root on every run. To stop that:"
		echo "      sudo $ROOT/bin/firellm net-setup --count 4"
	fi
	((bad == 0))
}

usage() {
	cat <<'EOF'
firellm - run a coding agent in a Firecracker microVM

  firellm setup                 fetch firecracker, jailer and a guest kernel
  firellm prepare [--full]      build the guest rootfs (via docker, no root)
  firellm net-setup [--count N] pre-create taps once, so runs need no root
  firellm doctor                check the host is ready

  firellm claude [args...]      run claude in a VM over the current directory
  firellm opencode [args...]    same, with opencode
  firellm shell                 interactive root shell in a VM
  firellm exec CMD [args...]    run any command in a VM over this directory

  firellm list                  runs, and whether their drives still exist
  firellm extract <id> [dest]   pull a run's /src back out
  firellm gc [keep]             drop old run drives (default: keep 5)

  firellm state list            per-project agent state drives
  firellm state sessions [dir]  session ids you can --resume
  firellm state reset [dir]     forget this project's agent history

options (before the agent's own arguments):
  --workdir DIR   project to put in /src            (default: .)
  --exclude PAT   leave PAT out of /src, repeatable
  --all-files     include gitignored files too (they are left out by default)
  --add-dir DIR   extra host dir, read-only at /mnt/<name>, repeatable
  --host-port N   make the host's localhost:N reachable at localhost:N in the
                  guest, over vsock; repeatable. For a local llama-server or
                  any other OpenAI-compatible endpoint on loopback.
  --resume-tree   carry the previous run's /src forward (implied by -c/-r)
  --fresh         start from the host tree even when continuing
  --import-sessions    copy this project's host transcripts into the VM,
                       rewriting host paths to /src so they can be resumed
  --no-import-sessions never do that
  --mem MB        guest memory                      (default: 4096)
  --vcpu N        guest cpus                        (default: 4)
  --timeout SEC   kill the agent after SEC seconds  (default: none)
  --no-net        no network at all
  --no-jail       skip the jailer (still a real VM, less hardening, no root)
  --no-sync       do not copy /src back out
  --keep          keep the run's drives afterwards
  --cgroups       also cap the host-side process via jailer cgroups
  --debug-boot    verbose guest boot
  --no-auto-flags do not add -p / --dangerously-skip-permissions
  --              everything after this goes to the agent verbatim

Given arguments, the agent runs unattended and the VM powers off when it is
done. Given none, you get an interactive session on the guest console.

Work is copied to a sibling directory, <project>-<timestamp>-<pid>. Your
project directory is never written to.

The agent's home directory is kept on a per-project drive that outlives the
VM, so a later run can pick up where the last one stopped:

  firellm claude "start the refactor"
  firellm claude --continue "now do the tests too"
  firellm state sessions
  firellm claude --resume 3f9a1c2e "and update the docs"

examples:
  firellm claude "add tests for the parser"
  firellm claude --timeout 3600 -- -p "fix the failing build" --model opus
  firellm opencode "fix the tests"
  firellm claude --workdir ~/Projects/foo "update the readme"
  firellm claude --add-dir ~/Projects "match the API used in the sibling repo"
  firellm shell
EOF
}

case "${1:-}" in
setup)
	shift
	"$SCRIPTS/setup.sh" "$@"
	;;
prepare)
	shift
	"$SCRIPTS/prepare-rootfs.sh" "$@"
	;;
doctor)
	shift
	cmd_doctor
	;;
list | ls)
	shift
	cmd_list
	;;
extract)
	shift
	cmd_extract "$@"
	;;
gc)
	shift
	cmd_gc "$@"
	;;
state)
	shift
	cmd_state "$@"
	;;
net-setup)
	shift
	cmd_net_setup "$@"
	;;
spawn-server)
	shift
	exec python3 "$ROOT/mcp/firellm-spawn.py" "$@"
	;;
test)
	shift
	exec "$ROOT/tests/run-tests.sh" "$@"
	;;
claude | opencode)
	agent=$1
	shift
	launch "$agent" "$@"
	;;
shell)
	shift
	launch shell "$@"
	;;
exec)
	shift
	[[ $# -gt 0 ]] || die "usage: firellm exec [options] <command> [args...]"
	launch "" "$@"
	;;
-h | --help | help | "")
	usage
	;;
*)
	die "unknown command: $1 (try: firellm help)"
	;;
esac
