#!/usr/bin/env bash
# firecode - run a coding agent inside a Firecracker microVM, under the jailer.
#
# The agent gets root, the network and your project. It does not get your
# host: no host filesystem, no host processes, no host devices. Work is
# copied back out to a sibling directory when the VM shuts down.
set -euo pipefail

# Resolved, so this still finds the repo when it is reached through a symlink
# in ~/bin rather than by its real path.
SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=$(cd "$(dirname "$SELF")/.." && pwd)
IMAGES="$ROOT/images"
# The image whose e2fsprogs does the ext4 conversion, as root inside a
# container. Same trick prepare uses, and the reason none of this needs sudo.
CONVERTER_IMAGE="${FIRECODE_CONVERTER_IMAGE:-firecode/rootfs:latest}"
GUEST="$ROOT/guest"
SCRIPTS="$ROOT/scripts"
VENDOR="$ROOT/vendor/bin"
RUNS="$ROOT/runs"
STATE_DIR="$ROOT/state"
JAIL_BASE="$ROOT/.jail"

# The command as invoked, so a multiplexer session can re-run it verbatim.
declare -a FIRECODE_ARGV=("$@")

FC="$VENDOR/firecracker"
JAILER="$VENDOR/jailer"

# Where the host agents keep their configuration. Overridable mostly so the
# harness can be exercised against a throwaway copy.
CLAUDE_HOME="${FIRECODE_CLAUDE_HOME:-$HOME/.claude}"
CLAUDE_CONF="${FIRECODE_CLAUDE_CONF:-$HOME/.claude.json}"
OPENCODE_HOME="${FIRECODE_OPENCODE_HOME:-$HOME/.opencode}"
OPENCODE_SHARE="${FIRECODE_OPENCODE_SHARE:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode}"
OPENCODE_CONF="${FIRECODE_OPENCODE_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"

# Defaults. Claude Code alone wants ~1.5G, so 1G was never going to work.
MEM=4096
VCPU=4
NONET=0
NOJAIL=0
CGROUPS=0
KEEP=0
QUIET_BOOT=1
AUTO_FLAGS=1
TIMEOUT=0
WORKDIR="."
AGENT=""
SYNC_BACK=1
FAST=0
REFRESH=0
PARENT_RUN=""
# Which hypervisor. firecracker for everything it can do - it starts in
# milliseconds and restores a snapshot in sixty - and libvirt/qemu for the one
# thing it cannot: there is no PCI bus in a firecracker VM, so no GPU either.
VMM="${FIRECODE_VMM:-firecracker}"
VECTORIZED=0
DELIVER=""
# The command that decides whether the work is usable, run by the harness
# after the agent has finished and before anything is handed back.
VERIFY=""
VERIFY_TIMEOUT="${FIRECODE_VERIFY_TIMEOUT:-1800}"
# Authenticate guests through the host instead of copying a token into each.
AUTH_RELAY=0
AUTH_RELAY_PORT=""
AUTH_RELAY_PID=""
# Which provider the relay is standing in for. Worked out from the model that
# was asked for, not from the agent's name: opencode speaks several, and
# relaying one while withholding the credentials of another leaves a run with
# neither.
RELAY_PROVIDER=""
#: providers auth-relay.py knows how to authenticate as
RELAY_KNOWS="claude xai"
API_BASE=""
HYBRID=0
PCORES=""
VPMU=0
GPU_PCI=""
LIBVIRT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"
RESUME_TREE=auto
IMPORT_SESSIONS=auto
USE_GITIGNORE=1
NO_MCP=0
NO_TMUX=0
DRY_RUN=0
WORKTREE=""
FRESH_ROOT=0
declare -a EXTRA_DIRS=()
# Host disks handed to the guest whole: HOSTPATH[:GUESTPATH[:ro]]. A file or a
# block device, attached rather than copied - which is the only workable answer
# once a dataset is measured in terabytes.
declare -a DISKS=()
declare -a HOST_PORTS=()
declare -a EXCLUDES=()

# Relative to $HOME. Never carried into the guest, whatever is asked for:
# keeping keys and credentials out is most of the point of running in a VM.
SENSITIVE_HOME_DIRS=(
	.ssh
	.gnupg
	.aws
	.kube
	.docker
	.config/gh
	.password-store
	.mozilla
	.config/google-chrome
	.config/chromium
)

# Your own list, one path or glob per line, # for comments. For work that
# must never end up on a VM drive - client code, anything under NDA.
DENY_FILE="${FIRECODE_DENY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/firecode/never-share}"

# Host loopback ports every run should be able to reach, one per line.
PORTS_FILE="${FIRECODE_PORTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/firecode/host-ports}"

# Guest vsock port the interactive session listens on.
CONSOLE_PORT=${FIRECODE_CONSOLE_PORT:-1024}
FILES_PORT=${FIRECODE_FILES_PORT:-1025}
EXEC_PORT=${FIRECODE_EXEC_PORT:-1026}

refuse_if_sensitive() {
	local path=$1 rel full line
	for rel in "${SENSITIVE_HOME_DIRS[@]}"; do
		full="$HOME/$rel"
		if [[ $path == "$full" || $path == "$full"/* ]]; then
			die "refusing to put $full in the guest - keys and credentials stay on the host"
		fi
	done

	[[ -f $DENY_FILE ]] || return 0
	while IFS= read -r line; do
		line=${line%%#*}
		line=${line#"${line%%[![:space:]]*}"}
		line=${line%"${line##*[![:space:]]}"}
		[[ -n $line ]] || continue
		line=${line/#\~/$HOME}
		# Match the entry itself, anything under it, and globs either way.
		# shellcheck disable=SC2053  # unquoted on purpose, the entry is a pattern
		if [[ $path == $line || $path == $line/* || $path == "$line" || $path == "$line"/* ]]; then
			die "refusing $path - listed in $DENY_FILE"
		fi
	done <"$DENY_FILE"
}

log() { echo "[firecode] $*" >&2; }
die() {
	echo "[firecode] error: $*" >&2
	exit 1
}

# debugfs and mkfs.ext4 live in /usr/sbin, which is not always on a user PATH.
sbin() {
	local name=$1
	shift
	local p
	for p in "$(command -v "$name" 2>/dev/null || true)" \
		/usr/sbin/"$name" /sbin/"$name" /usr/local/sbin/"$name"; do
		if [[ -n $p && -x $p ]]; then
			"$p" "$@"
			return
		fi
	done
	die "$name not found (install e2fsprogs)"
}

# How to become root, worked out once. Empty when we already are.
#
# With no controlling terminal - cron, a hook, another agent - sudo cannot
# prompt and just fails. If an askpass helper is configured it can ask on the
# desktop instead, which is the difference between an unattended run working
# and not.
declare -a SUDO=()
if ((EUID != 0)); then
	if [[ ! -t 0 && -n ${SUDO_ASKPASS:-} ]] && ! sudo -n true 2>/dev/null; then
		SUDO=(sudo -A)
	else
		SUDO=(sudo)
	fi
fi

priv() {
	"${SUDO[@]}" "$@"
}

# ---------------------------------------------------------------- assets

KERNEL=""
ROOTFS=""
INITRD=""
# "" the stock kernel, "debug" the traceable one, or a path.
WANT_KERNEL="${FIRECODE_KERNEL:-}"

resolve_assets() {
	[[ -x $FC && -x $JAILER ]] || die "firecracker not installed - run: firecode setup"

	local k
	case "$WANT_KERNEL" in
	"")
		# Newest stock kernel. -debug ones are excluded rather than sorted
		# around: "debug" sorts after any digit, so a plain glob would have
		# silently made the traceable kernel the default for every run.
		k=$(find "$IMAGES" -maxdepth 1 -name 'vmlinux-*' -not -name '*-debug' -type f |
			sort -V | tail -1)
		[[ -n $k ]] || die "no guest kernel in $IMAGES - run: firecode setup"
		;;
	debug)
		k=$(find "$IMAGES" -maxdepth 1 -name 'vmlinux-*-debug' -type f | sort -V | tail -1)
		[[ -n $k ]] || die "no debug kernel - run: firecode setup --debug-kernel"
		;;
	*)
		k=$WANT_KERNEL
		[[ -f $k ]] || die "no such kernel: $k"
		;;
	esac
	KERNEL=$k

	# Explicitly the prepared image. Do not glob and take the first match:
	# that is how this used to silently boot the untouched base image.
	ROOTFS="$IMAGES/agent-firecode.ext4"
	[[ -f $ROOTFS ]] || die "no guest rootfs - run: firecode prepare"

	# Assembles the layered root before handing over to the guest's init.
	INITRD="$IMAGES/initrd.gz"
	[[ -f $INITRD ]] || die "no initrd - rebuild with: firecode prepare --force"
}

# ---------------------------------------------------------------- host MCP

# Ports of MCP servers the host exposes over http/sse on localhost. Those are
# the only ones that can be relayed into the guest; stdio servers are host
# binaries and cannot come along.
discover_mcp_ports() {
	[[ -f $CLAUDE_CONF ]] || return 0
	python3 - "$CLAUDE_CONF" <<'PY' 2>/dev/null || true
import json, re, sys

ports = set()

def walk(o):
    if isinstance(o, dict):
        servers = o.get("mcpServers")
        if isinstance(servers, dict):
            for spec in servers.values():
                url = spec.get("url") if isinstance(spec, dict) else None
                if not url:
                    continue
                if "localhost:" in url or "127.0.0.1:" in url:
                    m = re.search(r":(\d+)", url)
                    if m:
                        ports.add(int(m.group(1)))
        for v in o.values():
            walk(v)
    elif isinstance(o, list):
        for v in o:
            walk(v)

try:
    with open(sys.argv[1]) as fh:
        walk(json.load(fh))
except Exception:
    sys.exit(0)

print(" ".join(str(p) for p in sorted(ports)))
PY
}

# ---------------------------------------------------------------- drives

# ext4 image built straight from a directory, no mount and no root.
mkimage_from_dir() {
	local src=$1 out=$2 label=$3 size=$4
	# Round up to a whole MiB: firecracker warns about anything that is not a
	# multiple of the 512 byte sector size, and the tail would be invisible.
	local mib=$((1024 * 1024))
	size=$(((size + mib - 1) / mib * mib))
	rm -f "$out"
	truncate -s "$size" "$out"
	sbin mkfs.ext4 -q -F -L "$label" -d "$src" "$out"
}

# Lay the project out for imaging. Build artefacts are the difference between
# a 150K drive and a 10G one, so ignored files are left behind by default.
# Hardlinked where the filesystems allow it, so this copies no data.
stage_project() {
	local workdir=$1 stage=$2
	rm -rf "$stage"
	mkdir -p "$stage"

	local -a rs=(-a --link-dest="$workdir")
	if ((USE_GITIGNORE)) && [[ -d $workdir/.git ]]; then
		# Per-directory .gitignore rules, the same set git itself would skip.
		# .git is not covered by those, so the history still comes along.
		rs+=(--filter=':- .gitignore')
	fi
	local p
	for p in ${EXCLUDES+"${EXCLUDES[@]}"}; do
		rs+=(--exclude="$p")
	done

	rsync "${rs[@]}" "$workdir"/ "$stage"/ 2>/dev/null || true

	# A git worktree's .git is a file pointing into the main checkout, which is
	# not in the VM - so git in there would find no repository at all, and the
	# agent could not read history or commit. Give the copy a real .git from
	# the common directory, then let git itself set the branch: which refs are
	# files and which live in a reftable stack is not something to guess at.
	if [[ -f $workdir/.git ]]; then
		local common head_ref head_sha
		common=$(git -C "$workdir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
		if [[ -d $common ]]; then
			rm -f "$stage/.git"
			mkdir -p "$stage/.git"
			rsync -a --exclude=worktrees --exclude=modules --exclude=index \
				"$common"/ "$stage/.git"/ 2>/dev/null || true
			git -C "$stage" config --unset core.worktree 2>/dev/null || true
			git -C "$stage" config --unset core.bare 2>/dev/null || true

			head_sha=$(git -C "$workdir" rev-parse HEAD 2>/dev/null || true)
			head_ref=$(git -C "$workdir" symbolic-ref -q HEAD 2>/dev/null || true)
			if [[ -n $head_sha && -n $head_ref ]]; then
				git -C "$stage" update-ref "$head_ref" "$head_sha" 2>/dev/null
				git -C "$stage" symbolic-ref HEAD "$head_ref" 2>/dev/null
			elif [[ -n $head_sha ]]; then
				git -C "$stage" update-ref --no-deref HEAD "$head_sha" 2>/dev/null
			fi
			# The index came from the main checkout's branch; rebuild it so
			# the agent does not open on a diff it did not make.
			git -C "$stage" reset -q 2>/dev/null || true
			log "worktree: gave the copy a standalone .git on ${head_ref##*/}"
		fi
	fi

	local full staged
	full=$(du -sb --apparent-size "$workdir" 2>/dev/null | cut -f1)
	staged=$(du -sb --apparent-size "$stage" 2>/dev/null | cut -f1)
	if ((${full:-0} > ${staged:-0} + 64 * 1024 * 1024)); then
		log "left behind $(numfmt --to=iec $((full - staged))) of ignored files (--all-files to include them)"
	fi
}

# Cheap stand-in for "has this tree changed": total apparent size and the
# newest mtime in it. Wrong only if an edit keeps both identical.
dir_fingerprint() {
	local dir=$1 size newest
	size=$(du -sb --apparent-size "$dir" 2>/dev/null | cut -f1)
	newest=$(find "$dir" -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
	echo "${size:-0}:${newest:-0}"
}

# A read-only drive for a directory that has not changed is the same drive it
# was last time, so build it once and keep it. Firecracker has no shared
# filesystem device and this host's ext4 has no reflinks, so a cache is as
# close to copy-on-write as this gets.
cached_ro_image() {
	local dir=$1 label=$2 idx=$3
	local slug img stamp want
	slug=$(project_slug "$dir")
	img="$STATE_DIR/ro-$slug.ext4"
	stamp="$STATE_DIR/ro-$slug.stamp"
	mkdir -p "$STATE_DIR"
	want=$(dir_fingerprint "$dir")

	if [[ -f $img && -f $stamp && $(cat "$stamp") == "$want" ]]; then
		echo "$img"
		return 0
	fi

	local stage="$RUN_DIR/extra$idx"
	# Same gitignore filtering as the project itself: a checkout's .venv or
	# node_modules is usually most of it and never what you wanted.
	stage_project "$dir" "$stage" >&2
	local bytes
	bytes=$(du -sb --apparent-size "$stage" 2>/dev/null | cut -f1)
	if ((bytes > 32 * 1024 * 1024 * 1024)); then
		die "--add-dir $dir is $((bytes / 1024 / 1024 / 1024))G - too big to put in a VM"
	fi
	# Same reasoning as the config drive: build beside it, then move, so a
	# concurrent run never attaches a partly written image.
	mkimage_from_dir "$stage" "$img.$BASHPID" "$label" "$(size_ro_dir "$stage")"
	mv -f "$img.$BASHPID" "$img"
	rm -rf "$stage"
	echo "$want" >"$stamp"
	echo "$img"
}

# Read-only drives never grow, so they only need their contents plus the
# filesystem's own overhead.
size_ro_dir() {
	local dir=$1 used
	used=$(du -sb --apparent-size "$dir" 2>/dev/null | cut -f1)
	echo $((${used:-0} * 11 / 10 + 128 * 1024 * 1024))
}

# Bytes needed to hold a directory, with room for the agent to work in.
size_for_dir() {
	local dir=$1 floor=$2 used
	used=$(du -sb --apparent-size "$dir" 2>/dev/null | cut -f1)
	used=${used:-0}
	local want=$((used * 2 + 2 * 1024 * 1024 * 1024))
	((want < floor)) && want=$floor
	echo "$want"
}

CFG_DRIVE="$IMAGES/agent-roconfig.ext4"
CFG_STAMP="$IMAGES/.roconfig.stamp"

config_fingerprint() {
	local parts=() p bin
	for p in "$CLAUDE_CONF" "$CLAUDE_HOME/settings.json" \
		"$CLAUDE_HOME/settings.local.json" "$CLAUDE_HOME/.credentials.json"; do
		[[ -e $p ]] && parts+=("$p:$(stat -Lc %Y "$p" 2>/dev/null || echo 0)")
	done
	for p in claude opencode; do
		bin=$(command -v "$p" 2>/dev/null || true)
		[[ -n $bin ]] && parts+=("$p:$(stat -Lc '%Y:%s' "$bin" 2>/dev/null || echo 0)")
	done
	# Credentials rotate, so the drive has to notice.
	for p in "$OPENCODE_SHARE/auth.json" "$OPENCODE_CONF/opencode.jsonc" \
		"$OPENCODE_CONF/opencode.json"; do
		[[ -e $p ]] && parts+=("$p:$(stat -Lc %Y "$p" 2>/dev/null || echo 0)")
	done
	# Whether credentials are on the drive at all is part of what the drive
	# *is*. Without this a relayed run reuses a drive some earlier plain run
	# built, finds the credentials it was meant not to have, and rotates them
	# - the exact failure the relay exists to prevent.
	parts+=("relay:$AUTH_RELAY:$RELAY_PROVIDER")
	# The briefing every agent in here is given. It is baked into CLAUDE.md and
	# AGENTS.md on this drive, so editing it has to rebuild the drive - or the
	# change lands nowhere and the next run is briefed with the old text.
	[[ -e $GUEST/firecode-context.md ]] &&
		parts+=("context:$(stat -Lc %Y "$GUEST/firecode-context.md" 2>/dev/null || echo 0)")
	printf '%s\n' ${parts+"${parts[@]}"} | sha256sum | cut -d' ' -f1
}

build_config_drive() {
	local want
	want=$(config_fingerprint)
	if [[ -f $CFG_DRIVE && -f $CFG_STAMP ]] && [[ $(cat "$CFG_STAMP") == "$want" ]]; then
		return 0
	fi

	# One drive, shared by every run. Two starting at once would both decide
	# it was stale and the second would delete the first's staging directory
	# mid-mkfs. Wait rather than race, then look again - the other one may
	# have just built exactly what we wanted.
	mkdir -p "$IMAGES"
	local lock_fd
	exec {lock_fd}>"$IMAGES/.roconfig.lock"
	flock "$lock_fd"
	if [[ -f $CFG_DRIVE && -f $CFG_STAMP ]] && [[ $(cat "$CFG_STAMP") == "$want" ]]; then
		exec {lock_fd}>&-
		return 0
	fi

	log "building the read-only config drive (host agent config + binaries)"
	local stage
	stage=$(mktemp -d "$IMAGES/.cfgstage.XXXXXX")
	mkdir -p "$stage/bin" "$stage/claude"

	local a bin
	for a in claude opencode; do
		bin=$(command -v "$a" 2>/dev/null || true)
		if [[ -n $bin ]]; then
			cp -L "$bin" "$stage/bin/$a"
			chmod +x "$stage/bin/$a"
			log "  $a $(basename "$(readlink -f "$bin")")"
		else
			log "  $a not installed on the host, skipping"
		fi
	done

	# Only the parts of the host config that mean anything in a fresh VM. The
	# rest is 1.6G of session history for projects that do not exist in there.
	local item
	for item in .credentials.json settings.json settings.local.json CLAUDE.md \
		agents commands skills plugins output-styles; do
		[[ -e $CLAUDE_HOME/$item ]] || continue
		# With a relay in front, the guest authenticates through the host and
		# has no business holding a token: a VM cannot reach your filesystem,
		# but a copied session is the one thing in there worth stealing. It is
		# also the thing that expires and cannot be refreshed from inside.
		if ((AUTH_RELAY)) && [[ $item == .credentials.json ]]; then
			continue
		fi
		rsync -a --copy-unsafe-links "$CLAUDE_HOME/$item" "$stage/claude/" 2>/dev/null || true
	done

	if [[ -d $OPENCODE_HOME ]]; then
		mkdir -p "$stage/opencode"
		rsync -a --copy-unsafe-links \
			--exclude=cache --exclude=.cache --exclude=log --exclude=logs \
			"$OPENCODE_HOME"/ "$stage/opencode"/ 2>/dev/null || true
	fi
	# ~/.opencode is only the binary. The parts that decide whether it can
	# talk to anything live elsewhere: credentials under the data directory,
	# providers and MCP servers under the config directory. Without these it
	# starts up with no provider at all.
	if ((AUTH_RELAY)) && [[ $AGENT == opencode && -f $OPENCODE_SHARE/auth.json ]]; then
		# Only the relayed provider is withheld, and the rest travel.
		#
		# Withholding the whole file was too blunt: a run using one provider
		# through the relay still needs its other credentials, and an api key
		# does not rotate, so keeping it out buys nothing and costs the run
		# everything. What must not travel is the login the relay is standing
		# in for - opencode refreshes it on startup, the provider rotates the
		# pair, and the guest's copy of the new one dies with the VM, leaving
		# this host holding a token that has already been spent.
		mkdir -p "$stage/opencode-share"
		FIRECODE_RELAYED="$RELAY_PROVIDER" python3 -c '
import json, os, sys
d = json.load(open(sys.argv[1]))
gone = os.environ["FIRECODE_RELAYED"]
kept = {k: v for k, v in d.items() if k != gone}
json.dump(kept, open(sys.argv[2], "w"), indent=2)
print(" ".join(sorted(kept)) or "none")
' "$OPENCODE_SHARE/auth.json" "$stage/opencode-share/auth.json" >/dev/null 2>&1 ||
			cp -f "$OPENCODE_SHARE/auth.json" "$stage/opencode-share/auth.json"
		chmod 600 "$stage/opencode-share/auth.json" 2>/dev/null || true
		log "  $RELAY_PROVIDER goes through this host - the VM gets no credentials for it"
	elif [[ -f $OPENCODE_SHARE/auth.json ]]; then
		mkdir -p "$stage/opencode-share"
		cp -f "$OPENCODE_SHARE/auth.json" "$stage/opencode-share/auth.json"
		log "  opencode credentials: $(python3 -c 'import json,sys; print(", ".join(json.load(open(sys.argv[1]))))' "$OPENCODE_SHARE/auth.json" 2>/dev/null || echo "present")"
		# A subscription login is rotating state, and this copy is a second
		# writer. The unattended opencode path replaces it with a placeholder
		# and a relay; every other path - an interactive session, a persistent
		# VM someone later runs opencode inside - still gets the real thing,
		# and refreshing it in there spends the host's token. Cheap to say,
		# expensive to discover.
		local oauth_providers
		oauth_providers=$(python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
print(" ".join(k for k, v in d.items()
                if isinstance(v, dict) and v.get("type") == "oauth"))
' "$OPENCODE_SHARE/auth.json" 2>/dev/null || true)
		if [[ -n $oauth_providers ]]; then
			log "  WARNING: $oauth_providers is a subscription login, and it is going into"
			log "           this VM as-is. Anything that runs opencode in there can refresh"
			log "           it, which rotates the token and leaves this host holding a spent"
			log "           one. 'firecode opencode --auth-relay' avoids that; other paths"
			log "           cannot, because a relay serves one provider and this VM has no"
			log "           agent to name it."
		fi
	else
		log "  opencode has no saved credentials on the host"
	fi
	if [[ -d $OPENCODE_CONF ]]; then
		mkdir -p "$stage/opencode-config"
		# node_modules here is 60M of plugin dependencies; the config itself
		# is what decides providers and MCP servers.
		rsync -a --copy-unsafe-links --exclude=node_modules \
			"$OPENCODE_CONF"/ "$stage/opencode-config"/ 2>/dev/null || true

		# Take out the MCP servers that cannot exist in a VM.
		#
		# Claude's config gets this treatment already; opencode's was copied
		# verbatim, so an opencode started in a guest tried to exec binaries
		# living on the host filesystem - a venv, a wrapper in ~/.local/bin -
		# and to dial the spawn server's port, which is deliberately not
		# relayed. It gets no useful error out of any of that; it just takes a
		# long time not working, which is how the first attempt to run
		# opencode inside a VM here looked like a hang.
		local occ dropped
		for occ in "$stage/opencode-config/opencode.jsonc" \
			"$stage/opencode-config/opencode.json"; do
			[[ -f $occ ]] || continue
			dropped=$(FIRECODE_OCC="$occ" FIRECODE_SPAWN_PORT="${SPAWN_PORT:-9770}" python3 -c '
import json, os, re, sys
path = os.environ["FIRECODE_OCC"]
try:
    conf = json.loads(re.sub(r"(?m)^\s*//.*$", "", open(path).read()) or "{}")
except ValueError:
    raise SystemExit                      # not ours to rewrite

mcp = conf.get("mcp") or {}
gone = []
for name, cfg in list(mcp.items()):
    if not isinstance(cfg, dict):
        continue
    # A local server is a binary on the host, at a path the guest does not
    # have. The command is not shipped, so the entry cannot work.
    if cfg.get("type") == "local":
        gone.append(name + " (host binary)")
        del mcp[name]
    # And the one port a guest is never given, because a VM that could reach
    # the spawn server could start VMs of its own.
    elif cfg.get("type") == "remote" and os.environ["FIRECODE_SPAWN_PORT"] in (cfg.get("url") or ""):
        gone.append(name + " (not reachable from a guest, by design)")
        del mcp[name]
if gone:
    conf["mcp"] = mcp
    with open(path, "w") as fh:
        json.dump(conf, fh, indent=2)
    print(", ".join(gone))
' 2>/dev/null || true)
			[[ -n $dropped ]] && log "  dropped from opencode config in the guest: $dropped"
		done
	fi
	# opencode reads AGENTS.md where claude reads CLAUDE.md, so the same
	# briefing has to be put somewhere else entirely or opencode runs with no
	# idea where it is.
	if [[ -f $GUEST/firecode-context.md ]]; then
		mkdir -p "$stage/opencode-config"
		{
			[[ -f $OPENCODE_CONF/AGENTS.md ]] && cat "$OPENCODE_CONF/AGENTS.md"
			echo
			cat "$GUEST/firecode-context.md"
		} >"$stage/opencode-config/AGENTS.md"
	fi

	# What the agent is told about where it is.
	#
	# It has to go into the user-level CLAUDE.md, because that is a file the
	# agent actually reads. A briefing dropped somewhere else in the home
	# directory is just a file nobody opens - which is what it was, so the
	# agent had no idea it was in a VM at all: not that it can install
	# whatever it likes, not that its work leaves through a sibling
	# directory, not that half the MCP servers it expects are absent.
	if [[ -f $GUEST/firecode-context.md ]]; then
		{
			[[ -f $stage/claude/CLAUDE.md ]] && cat "$stage/claude/CLAUDE.md"
			echo
			cat "$GUEST/firecode-context.md"
		} >"$stage/claude/CLAUDE.md.new"
		mv -f "$stage/claude/CLAUDE.md.new" "$stage/claude/CLAUDE.md"
	fi

	# Hooks point at host binaries that do not exist in the guest; leaving
	# them in produces a failed hook on every single tool call.
	if [[ -f $stage/claude/settings.json ]]; then
		python3 - "$stage/claude/settings.json" <<'PY' || true
import json, sys
p = sys.argv[1]
try:
    with open(p) as fh:
        d = json.load(fh)
except Exception:
    sys.exit(0)
if d.pop("hooks", None) is not None:
    with open(p, "w") as fh:
        json.dump(d, fh, indent=2)
    print("[firecode]   dropped hooks from settings (they point at host paths)",
          file=sys.stderr)
PY
	fi

	if [[ -f $CLAUDE_CONF ]]; then
		python3 - "$CLAUDE_CONF" "$stage/claude.json" <<'PY' || true
import json, sys

src, dst = sys.argv[1], sys.argv[2]
with open(src) as fh:
    d = json.load(fh)

# Per-project state refers to host paths that do not exist in the guest.
d.pop("projects", None)

servers = d.get("mcpServers")
if isinstance(servers, dict):
    kept, dropped = {}, []
    for name, spec in servers.items():
        url = spec.get("url") if isinstance(spec, dict) else None
        if url and ("localhost:" in url or "127.0.0.1:" in url):
            kept[name] = spec
        else:
            dropped.append(name)
    d["mcpServers"] = kept
    if dropped:
        print("[firecode]   MCP unavailable in guest (host stdio binaries): "
              + ", ".join(dropped), file=sys.stderr)
    if kept:
        print("[firecode]   MCP relayed over vsock: " + ", ".join(kept),
              file=sys.stderr)

d["hasCompletedOnboarding"] = True

with open(dst, "w") as fh:
    json.dump(d, fh, indent=2)
PY
	fi

	local size
	size=$(size_ro_dir "$stage")
	# Built beside the real one and moved into place, so a run that is already
	# using the old drive never sees a half-written file.
	mkimage_from_dir "$stage" "$CFG_DRIVE.$BASHPID" firecode-cfg "$size"
	mv -f "$CFG_DRIVE.$BASHPID" "$CFG_DRIVE"
	rm -rf "$stage"
	echo "$want" >"$CFG_STAMP"
	log "config drive: $(du -h --apparent-size "$CFG_DRIVE" | cut -f1)"
	exec {lock_fd}>&-
}

# ---------------------------------------------------------------- state

# Everything the agent writes under its home directory - sessions, history,
# todos - lands on a per-project drive that outlives the VM. That is what
# makes `--continue` and `--resume` work across runs: without it every VM
# starts with no memory of the last one.

STATE_FD=""
STATE_PERSISTENT=0
STATE_DRIVE=""
SLUG=""

project_slug() {
	local dir=$1 hash
	hash=$(printf '%s' "$dir" | sha256sum | cut -c1-8)
	echo "$(basename "$dir" | tr -c 'A-Za-z0-9._-' '-')-$hash"
}

# Sets STATE_DRIVE, and STATE_PERSISTENT if this run holds the project lock.
# Same reason as alloc_net_slot: it cannot print its answer, because the
# subshell of a command substitution would drop both the lock and the flag.
ensure_state_drive() {
	local workdir=$1 run_dir=$2 img size
	SLUG=$(project_slug "$workdir")
	local slug=$SLUG
	img="$STATE_DIR/$slug.ext4"
	mkdir -p "$STATE_DIR"

	if [[ ! -f $img ]]; then
		local seed
		seed=$(mktemp -d)
		mkdir -p "$seed/upper" "$seed/work"
		size=${FIRECODE_STATE_SIZE:-$((3 * 1024 * 1024 * 1024))}
		mkimage_from_dir "$seed" "$img" firecode-state "$size"
		rm -rf "$seed"
		log "new agent state drive for this project: $(basename "$img")"
	fi

	# Two VMs writing one ext4 image would corrupt it, so a second concurrent
	# run on the same project gets a throwaway copy instead.
	exec {STATE_FD}>"$STATE_DIR/$slug.lock"
	if flock -n "$STATE_FD"; then
		STATE_PERSISTENT=1
		STATE_DRIVE=$img
	else
		log "WARNING: another run holds this project's state drive."
		log "         using a private copy - this session will not be resumable."
		cp --sparse=always "$img" "$run_dir/state.ext4"
		STATE_DRIVE="$run_dir/state.ext4"
	fi
}

# Claude Code keys a project's transcripts by its working directory, with
# every non-alphanumeric character turned into a dash. The guest works at the
# same path the host does, so the key is the same on both sides.
claude_project_slug() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9' '-'
}

# Copies this project's host transcripts into the guest's agent home. Verbatim
# - the guest sees the project at the same absolute path, so every path in the
# transcript already points at the right thing. Only the state drive is
# touched; the host's own sessions are read and never modified.
import_host_sessions() {
	local workdir=$1 img=$2 only=${3:-} host_dir slug
	slug=$(claude_project_slug "$workdir")
	host_dir="$CLAUDE_HOME/projects/$slug"

	if [[ ! -d $host_dir ]]; then
		log "no host sessions recorded for $workdir, nothing to import"
		return 0
	fi
	if ! compgen -G "$host_dir/*.jsonl" >/dev/null; then
		log "no transcripts in $host_dir"
		return 0
	fi

	local tmp size
	tmp=$(mktemp -d)
	size=$(stat -c %s "$img")

	# Pull the drive apart, add the sessions, put it back together. Writing
	# into a mounted image would need root; this does not.
	sbin debugfs -R "rdump / $tmp" "$img" >/dev/null 2>&1 || true
	rm -rf "$tmp/lost+found"
	# overlayfs makes its work directory mode 000, and mkfs cannot walk into
	# what it cannot enter. This is our own copy, and the guest owns these
	# directories as root anyway.
	chmod -R u+rwX "$tmp" 2>/dev/null || true

	local dst="$tmp/upper/claude/projects/$slug"
	mkdir -p "$dst"

	local n=0 f
	for f in "$host_dir"/*.jsonl; do
		[[ -f $f ]] || continue
		if [[ -n $only && $(basename "$f") != "$only"* ]]; then
			continue
		fi
		cp -f "$f" "$dst/"
		n=$((n + 1))
	done

	if ((n == 0)); then
		log "no matching sessions to import"
		rm -rf "$tmp"
		return 0
	fi

	mkimage_from_dir "$tmp" "$img.new" firecode-state "$size"
	mv -f "$img.new" "$img"
	rm -rf "$tmp"
	log "imported $n host session(s), resumable at their original paths"
}

# The checkout a worktree belongs to, or the directory itself when it is not
# one. git points every worktree at the repository's common directory, which
# is what makes "inherit what the main checkout installed" well defined.
main_checkout() {
	local dir=$1 common
	common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
	[[ $common == */.git ]] || return 0
	echo "${common%/.git}"
}

# An empty ext4 for one overlay layer. Sparse, so it costs what it holds.
ensure_layer() {
	local slug=$1
	local img="$STATE_DIR/$slug-layer.ext4"
	mkdir -p "$STATE_DIR"
	if [[ ! -f $img ]]; then
		local seed
		seed=$(mktemp -d)
		mkdir -p "$seed/upper" "$seed/work"
		mkimage_from_dir "$seed" "$img" "fl-layer" \
			"${FIRECODE_LAYER_SIZE:-$((16 * 1024 * 1024 * 1024))}"
		rm -rf "$seed"
	fi
	echo "$img"
}

# A project's whole persistent state, as three drives.
snapshot_parts() {
	local slug=$1
	echo "$STATE_DIR/$slug.ext4:agent"
	echo "$STATE_DIR/$slug-src.ext4:src"
	echo "$STATE_DIR/$slug-root.ext4:root"
}

# Files in or out of a VM that is running now. Firecracker cannot mount a host
# directory into a guest, so this streams a tar over vsock instead.
# tmux will not keep a dot in a session name - it silently becomes an
# underscore - so the name has to be built the same way on both sides or
# attach never finds what launch created.
session_name() {
	local n=${1:-}
	[[ -n $n ]] || n=$(basename "$PWD")
	echo "firecode/${n//./_}"
}

# A second shell inside a VM that is already running - to try the thing it
# just built, or watch what it is doing. The guest serves a pty per connection,
# so this does not disturb whatever is on the first one.
# The socket of a running VM, for a given project or for the only one there
# is. A socket file outlives the VM that made it, so only one with something
# listening counts.
# Is anything listening on that address. Two kinds, because the two backends
# expose the same guest ports differently.
vm_reachable() {
	local addr=$1
	if [[ $addr == cid:* ]]; then
		python3 -c '
import socket, sys
s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
s.settimeout(3)
try:
    s.connect((int(sys.argv[1]), int(sys.argv[2])))
except OSError:
    sys.exit(1)
' "${addr#cid:}" "$EXEC_PORT" 2>/dev/null
		return $?
	fi
	[[ -S $addr ]] || return 1
	# The handshake, not just a connect.
	#
	# Opening the socket and closing it leaves firecracker logging "vsock:
	# error adding local-init connection: UnexpectedEof" - it was waiting for
	# "CONNECT <port>" and got a hangup. Harmless, but it is our own polling
	# writing errors into the log a person reads to see what a VM is doing.
	python3 -c '
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
try:
    s.connect(sys.argv[1])
    s.sendall(b"CONNECT %d\n" % int(sys.argv[2]))
    reply = s.recv(64)
except OSError:
    sys.exit(1)
finally:
    s.close()
sys.exit(0 if reply.startswith(b"OK") else 1)
' "$addr" "$EXEC_PORT" 2>/dev/null
}

live_vm_socket() {
	local want=${1:-}
	local -a socks=() names=()
	local r sock proj
	for r in "$RUNS"/*/; do
		[[ -f $r/jail ]] || continue
		# Where this VM's channels are. A unix socket under firecracker, a
		# vsock cid under libvirt - the guest listens on the same ports either
		# way, so everything downstream of this line is identical.
		if [[ -f $r/vsock ]]; then
			sock=$(cat "$r/vsock")
		else
			sock="$(cat "$r/jail")/firecracker-vsock.sock"
		fi
		# Ask whoever owns the VM, not the address: a finished run's recorded
		# cid answers as soon as a later VM is given the same one.
		if [[ -f $r/domain ]]; then
			libvirt_alive "$(cat "$r/domain")" "$(cat "$r/libvirt-uri" 2>/dev/null)" || continue
		else
			vm_reachable "$sock" || continue
		fi
		proj=$(cat "$r/project" 2>/dev/null || echo "")
		# `want` is whatever the caller had in front of them: a project path,
		# a VM name, the run id, or the short form ps prints for a VM started
		# before names existed. Anything displayed has to be usable, or the
		# listing is telling you a name you cannot type.
		if [[ -n $want && $proj != "$want" ]]; then
			local rid
			rid=$(basename "${r%/}")
			[[ $(cat "$r/name" 2>/dev/null) == "$want" || $rid == "$want" ||
			${rid##*-} == "$want" ]] || continue
		fi
		# Appended together, always: the two are read by index below, and a
		# filtered-out run that lands in one but not the other silently
		# shifts every name onto the wrong socket.
		socks+=("$sock")
		names+=("$proj")
	done

	# Returns non-zero rather than dying: callers ask "is one up?" as a
	# question, and a die here would end the process mid-question.
	if ((${#socks[@]} == 1)); then
		echo "${socks[0]}"
		return 0
	fi
	# Several runs, all for the project that was asked for. That is not
	# ambiguity worth refusing over - it is one project with old run
	# directories behind it - so the newest wins. Refusing here is what left
	# `up` polling for its own VM, which was running the whole time.
	if [[ -n $want ]] && ((${#socks[@]} > 1)); then
		echo "${socks[-1]}"
		return 0
	fi
	# Several are up and none was named, so the directory you are standing in
	# gets to decide. Without this, working in a project while another VM
	# happens to be running elsewhere makes every command ambiguous.
	if [[ -z $want ]] && ((${#socks[@]} > 1)); then
		local i
		for i in "${!socks[@]}"; do
			[[ ${names[$i]} == "$PWD" ]] || continue
			echo "${socks[$i]}"
			return 0
		done
	fi
	return 1
}

# The same lookup, but for callers that need one and cannot continue without.
require_vm_socket() {
	local want=${1:-} sock
	sock=$(live_vm_socket "$want") && {
		echo "$sock"
		return 0
	}
	local running=""
	local r
	for r in "$RUNS"/*/; do
		[[ -f $r/jail ]] || continue
		[[ -S $(cat "$r/jail")/firecracker-vsock.sock ]] || continue
		vm_reachable "$(cat "$r/jail")/firecracker-vsock.sock" || continue
		running="$running $(cat "$r/project" 2>/dev/null)"
	done
	if [[ -z $running ]]; then
		die "no VM is running - start one with: firecode up"
	fi
	if [[ -n $want ]]; then
		die "no VM running for $want (running:$running)"
	fi
	die "more than one VM is running - name one with --project (running:$running)"
}

# Where each --disk wants to be mounted, in the order given: "PATH:opts".
# A disk with no mountpoint is still attached - the guest may want the raw
# device, which is the case for anything that manages its own storage.
disk_mounts() {
	local spec rest out=""
	for spec in ${DISKS+"${DISKS[@]}"}; do
		rest=${spec#*:}
		if [[ $rest == "$spec" || -z $rest ]]; then
			out="$out -"
			continue
		fi
		out="$out ${rest%%:*}:$([[ $spec == *:ro ]] && echo ro || echo rw)"
	done
	printf '%s' "${out# }"
}

# What this machine can and cannot tell you about code that measures itself.
#
# Two facts decide it, and both are invisible from inside a VM - which is the
# problem, because a benchmark that cannot see them still produces numbers.
#
#   hybrid cores   P-cores and E-cores have different vector throughput, so an
#                  unpinned run is timing whichever core it happened to land
#                  on. Two runs of identical code differ by more than most
#                  optimisations do.
#   the vPMU       cycles, instructions, cache misses. KVM turns it off on
#                  hybrid parts - a vCPU can migrate between core types whose
#                  PMUs differ - so no hypervisor here can offer it, whatever
#                  enable_pmu says.
cpu_topology() {
	HYBRID=0
	PCORES=""
	if [[ -r /sys/devices/cpu_core/cpus ]]; then
		PCORES=$(cat /sys/devices/cpu_core/cpus)
		[[ -d /sys/devices/cpu_atom ]] && HYBRID=1
	fi
	VPMU=0
	if [[ $(cat /sys/module/kvm/parameters/enable_pmu 2>/dev/null) == Y ]]; then
		VPMU=1
	fi
	# Explicit, because a function ending in a test returns that test's
	# result - and a false one ends the whole run under set -e, with nothing
	# printed and nothing actually wrong. Third time in this codebase.
	return 0
}

# Expand "0-7" or "0-3,8" into the individual cpu numbers.
cpu_list() {
	local spec=$1 part lo hi out=""
	for part in ${spec//,/ }; do
		if [[ $part == *-* ]]; then
			lo=${part%-*}
			hi=${part#*-}
			for ((i = lo; i <= hi; i++)); do out="$out $i"; done
		else
			out="$out $part"
		fi
	done
	echo "${out# }"
}

# The discrete GPU, and every function that shares its IOMMU group.
#
# The group is the unit a host can let go of, not the device: everything in it
# is passed through together or none of it is. A card whose group holds a bus
# controller cannot be given to a VM without giving away that too, and that is
# the usual reason passthrough is not possible on a given machine.
gpu_auto() {
	local addr group members=""
	addr=$(lspci -D 2>/dev/null | grep -iE "vga|3d controller" |
		grep -vi "intel" | head -1 | cut -d' ' -f1)
	[[ -n $addr ]] || return 0
	group=$(readlink -f "/sys/bus/pci/devices/$addr/iommu_group" 2>/dev/null)
	if [[ -n $group ]]; then
		local d
		for d in "$group"/devices/*; do
			members="$members,$(basename "$d")"
		done
		members=${members#,}
	fi
	echo "${members:-$addr}"
}

# Boot the same guest under libvirt.
#
# The drive list is firecracker's, translated: same files, same order, because
# the guest finds several of them by position. The channels are the same ports
# on the same vsock, reached as AF_VSOCK here rather than through a unix
# socket - the guest cannot tell the difference and does not have to.
libvirt_boot() {
	# The drive list is read back from vm-config.json rather than passed in:
	# one place decides what a VM has and in what order, and both backends
	# read that same decision.
	local cmdline=$2 cid=$3 console=$4
	command -v virsh >/dev/null 2>&1 || die "libvirt is not installed - no virsh"

	local spec="$RUN_DIR/domain.json" xml="$RUN_DIR/domain.xml"
	local name="firecode-${RUN_ID#firecode-}"
	# Read by the spec writer below, so it has to be set before it runs.
	[[ $LIBVIRT_URI == *session* ]] && export FIRECODE_LIBVIRT_SESSION=1

	# The drive list, rebuilt from the same JSON firecracker was given, so
	# there is exactly one place that decides what a VM has and in what order.
	python3 - "$spec" "$name" "$MEM" "$VCPU" "$KERNEL" "$INITRD" "$cmdline" \
		"$cid" "$console" "$JAIL_DIR" "${TAP_DEV:-}" "${GPU_PCI:-}" <<'PY'
import json, os, sys
spec_path, name, mem, vcpu, kernel, initrd, cmdline, cid, console, jail, tap, gpu = sys.argv[1:13]
drives = []
with open(os.path.join(jail, "vm-config.json")) as fh:
    cfg = json.load(fh)
for d in cfg["drives"]:
    p = d["path_on_host"]
    if not os.path.isabs(p):
        p = os.path.join(jail, p)
    drives.append({"path": p, "readonly": bool(d.get("is_read_only")),
                   "block": os.path.exists(p) and os.stat(p).st_mode & 0o170000 == 0o060000})
spec = {"name": name, "mem_mib": int(mem), "vcpus": int(vcpu), "kernel": kernel,
        "initrd": initrd, "cmdline": cmdline, "cid": int(cid), "console_log": console,
        "drives": drives, "tap": tap or None,
        "pci": [a for a in gpu.split(",") if a],
        # A session connection runs qemu as the caller and has no security
        # driver to tell anything to.
        "seclabel": not os.environ.get("FIRECODE_LIBVIRT_SESSION"),
        # Which physical cores the vcpus are nailed to, when the run cares
        # about how long things take.
        "pin": [int(c) for c in os.environ.get("FIRECODE_PIN", "").split() if c]}
if tap:
    spec["mac"] = "06:00:ac:10:%02x:02" % int(os.environ.get("NET_SLOT", "0"))
with open(spec_path, "w") as fh:
    json.dump(spec, fh, indent=2)
PY

	python3 "$SCRIPTS/libvirt-domain.py" "$spec" >"$xml" || die "could not build the domain"
	[[ -n ${GPU_PCI:-} ]] && log "passing through $GPU_PCI - the host must have released it"

	# qemu runs as root under qemu:///system and would create this 0600
	# root-owned, leaving the console unreadable by the person who asked for
	# the VM - which is the only place a boot failure is explained.
	: >"$console"
	chmod 0666 "$console" 2>/dev/null || true

	log "starting under libvirt ($VCPU vcpu, ${MEM}M)"
	# Transient: defined only while it runs, so a killed firecode leaves no
	# domain behind to be started again later by something that has forgotten
	# what it was for.
	virsh -c "$LIBVIRT_URI" create "$xml" >/dev/null ||
		die "libvirt refused the domain - see $xml"
	printf '%s\n' "$name" >"$RUN_DIR/domain"
	printf '%s\n' "$LIBVIRT_URI" >"$RUN_DIR/libvirt-uri"

	local rc=0
	# The VM outlives this call the way firecracker's does; the caller waits
	# on the guest answering, not on the VMM starting.
	while virsh -c "$LIBVIRT_URI" domstate "$name" 2>/dev/null | grep -q running; do
		sleep 1
	done
	log "the domain stopped"
	return $rc
}

# Is that domain running, asked of libvirt rather than of the guest.
#
# Probing the address cannot answer it. A cid identifies a VM only while that
# VM exists, and a run directory outlives its VM - so four finished runs that
# each recorded cid:3 all "answer" as soon as some later VM takes cid 3 again,
# and a lookup that wanted exactly one match finds four and refuses. Which is
# what made `up` wait forever with its VM already running.
libvirt_alive() {
	local name=$1 uri=${2:-$LIBVIRT_URI}
	[[ -n $name ]] || return 1
	# The connection is half the domain's identity: the same name under
	# qemu:///session and qemu:///system are different domains, and asking the
	# wrong one reports a running VM as gone.
	virsh -c "$uri" domstate "$name" 2>/dev/null | grep -q running
}

libvirt_down() {
	local name=$1 uri=${2:-$LIBVIRT_URI}
	[[ -n $name ]] || return 0
	virsh -c "$uri" destroy "$name" >/dev/null 2>&1 || true
}

# What a running VM is, in facts rather than in some tool's vocabulary.
#
# Anything that wants to look at a process inside a VM needs the same three
# things, by three different routes: an address to connect to, files to read,
# and /proc - which does not travel at all, being the kernel of whatever
# machine you read it on. What none of those needs is for firecode to know the
# name of the variable your particular dashboard reads them from.
#
#   eval "$(firecode info --env)"
#   export SERENEDB_HOST=$FIRECODE_VM_IP   # your mapping, in your shell
#
# so a tool this was never written for is two lines away, and this file does
# not grow a case per dashboard.
cmd_info() {
	local want="" as="env"
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--project)
			want=$(cd "$2" && pwd)
			shift 2
			;;
		--json)
			as="json"
			shift
			;;
		--env)
			as="env"
			shift
			;;
		*) die "usage: firecode info [--project DIR] [--env | --json]" ;;
		esac
	done

	local sock jail ip run project
	sock=$(require_vm_socket "$want")
	jail=$(dirname "$sock")
	ip=$(python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - \
		"ip -4 -o addr show eth0 | awk '{print \$4}' | cut -d/ -f1" 2>/dev/null |
		tr -cd '0-9.')
	# Matched on the address, not the jail directory: a libvirt VM is reached
	# by cid, and dirname of "cid:3" is not anything.
	local r
	for r in "$RUNS"/*/; do
		[[ -f $r/vsock && $(cat "$r/vsock") == "$sock" ]] ||
			{ [[ -f $r/jail && $(cat "$r/jail") == "$jail" ]] || continue; }
		run=$(basename "${r%/}")
		project=$(cat "$r/project" 2>/dev/null)
		break
	done

	if [[ $as == json ]]; then
		python3 -c '
import json, sys
print(json.dumps(dict(zip(
    ("run", "project", "ip", "socket", "exec_port", "console_port", "files_port"),
    sys.argv[1:])), indent=2))
' "${run:-}" "${project:-}" "${ip:-}" "$sock" "$EXEC_PORT" "$CONSOLE_PORT" "$FILES_PORT"
		return 0
	fi

	cat <<EOF
FIRECODE_VM_RUN='${run:-}'
FIRECODE_VM_PROJECT='${project:-}'
FIRECODE_VM_IP='${ip:-}'
FIRECODE_VM_SOCKET='$sock'
FIRECODE_VM_EXEC_PORT='$EXEC_PORT'
FIRECODE_PROCFS_CMD='$SCRIPTS/vmprocfs.py $sock $EXEC_PORT'
FIRECODE_MIRROR_CMD='$SELF mirror --once${want:+ --project $want}'
EOF
	[[ -n $ip ]] ||
		echo "# no address: this VM was started with --no-net, so nothing can connect to it" >&2
}

# --- the guest's /proc, on the host -------------------------------------
#
# A dashboard reads three different things about a server: SQL over a socket,
# perf captures out of a directory, and /proc for everything the server cannot
# be asked about itself - runnable threads, context switches, resident memory.
#
# The first two cross a VM boundary already. SQL is TCP, and a perf capture is
# a file that resolves against any build with a matching build-id, on any
# machine. /proc does not cross anything: it is the kernel of the machine you
# read it on, and reading it on the host while the process runs in a VM
# silently describes the wrong machine.
#
# So mirror it. One round trip per tick copies the handful of files that
# matter into a directory on the host that looks exactly like /proc, and
# anything that can be pointed at a proc root reads the guest instead.
#
# Staged into a temp directory in the guest before being packed, because /proc
# files report a size of zero and tar records what the size field says - a tar
# taken straight from /proc arrives with every file present and empty.
# Whatever paths you name, packed from the guest. Globs are expanded there,
# not here, so a pattern means what it means inside the VM.
mirror_script() {
	local patterns=$1
	cat <<EOF
set -u
stage=\$(mktemp -d)
found=0
for pat in $patterns; do
	for f in \$pat; do
		[ -e "\$f" ] || continue
		# Each file keeps the path it had, so the mirror is a subtree of the
		# guest's filesystem rather than a pile of basenames.
		#
		# The directories are made here rather than by cp --parents, which
		# recreates them with the *source* directory's mode - and /proc is
		# r-xr-xr-x, so the first file lands and every one after it fails
		# with "permission denied" on a directory cp itself just made.
		d=\$(dirname "\$f")
		mkdir -p "\$stage\$d" 2>/dev/null || continue
		cp -r "\$f" "\$stage\$d/" 2>/dev/null && found=\$((found + 1))
	done
done
[ "\$found" -gt 0 ] || { echo "NOMATCH" >&2; rm -rf "\$stage"; exit 4; }
# base64 because the exec channel filters what a guest prints at your terminal,
# as it should - text survives that, a tar stream would not.
tar -C "\$stage" -cf - . | base64 -w0
rm -rf "\$stage"
EOF
}

cmd_mirror() {
	local want="" pid="" name="" interval=2 out="" once=0
	local -a patterns=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--project)
			want=$(cd "$2" && pwd)
			shift 2
			;;
		--pid)
			pid="$2"
			shift 2
			;;
		--name)
			name="$2"
			shift 2
			;;
		--interval)
			interval="$2"
			shift 2
			;;
		--out)
			out="$2"
			shift 2
			;;
		--once)
			once=1
			shift
			;;
		-*) die "firecode mirror: unknown option $1" ;;
		*)
			patterns+=("$1")
			shift
			;;
		esac
	done
	((${#patterns[@]})) || die "$(
		cat <<'USAGE'
usage: firecode mirror [--project DIR] [--name PROC | --pid N]
                       [--interval S] [--out DIR] [--once] PATTERN...

Copies paths out of a running VM, repeatedly, into a directory that mirrors
the guest's filesystem. Patterns are globs expanded inside the guest, and %pid
stands for the process named by --name or --pid:

  firecode mirror --name serened --out ~/.cache/vm \
      '/proc/%pid/stat' '/proc/%pid/status' '/proc/%pid/task/*/stat' \
      '/proc/loadavg' '/proc/meminfo' '/proc/sys/vm/max_map_count'

Then point a reader at ~/.cache/vm as though it were /. This is how anything
that reads /proc - a dashboard, a profiler's companion - can describe a
process inside a VM instead of the machine it is running on.
USAGE
	)"

	local sock
	sock=$(require_vm_socket "$want")
	out=${out:-$RUNS/mirror}
	mkdir -p "$out"

	local needs_pid=0
	[[ "${patterns[*]}" == *%pid* ]] && needs_pid=1
	((needs_pid)) && [[ -z $pid && -z $name ]] &&
		die "these patterns use %pid, so give --name or --pid"

	log "mirroring $((${#patterns[@]})) pattern(s) from the VM into $out"
	((once)) || log "every ${interval}s - ^C to stop"

	local tmp payload rc
	tmp=$(mktemp -d "$RUNS/procmirror.XXXXXX")
	# shellcheck disable=SC2064  # expand now: the trap must know this path
	trap "rm -rf '$tmp'" EXIT

	while :; do
		local resolved=("${patterns[@]}")
		if ((needs_pid)); then
			local target=$pid
			if [[ -n $name ]]; then
				# Re-resolved every tick on purpose: a process that restarts
				# comes back as a different pid, and a mirror pinned to the
				# old one keeps serving the last thing it saw as if it were
				# live - which is worse than saying nothing.
				target=$(python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - \
					"pgrep -x $(printf '%q' "$name") | head -1" 2>/dev/null |
					tr -cd '0-9')
			fi
			if [[ -z $target ]]; then
				log "no process named ${name:-$pid} in the VM - waiting"
				((once)) && return 1
				sleep "$interval"
				continue
			fi
			local i
			for i in "${!resolved[@]}"; do
				resolved[i]=${resolved[i]//\%pid/$target}
			done
		fi

		rc=0
		payload=$(python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - \
			"$(mirror_script "${resolved[*]}")" 2>/dev/null) || rc=$?
		if ((rc != 0)) || [[ -z $payload ]]; then
			log "nothing matched in the guest (status $rc)"
			((once)) && return 1
		else
			rm -rf "${tmp:?}/next"
			mkdir -p "$tmp/next"
			if printf '%s' "$payload" | base64 -d 2>/dev/null |
				tar -C "$tmp/next" -xf - 2>/dev/null; then
				# Swapped in whole, so a reader never catches a half-written
				# tree - it either sees the last tick or this one.
				local top
				for top in "$tmp"/next/*; do
					[[ -e $top ]] || continue
					rm -rf "$out/$(basename "$top").swap"
					mv "$top" "$out/$(basename "$top").swap"
					rm -rf "${out:?}/$(basename "$top")"
					mv "$out/$(basename "$top").swap" "$out/$(basename "$top")"
				done
			else
				log "the guest's reply did not unpack - skipping this tick"
				((once)) && return 1
			fi
		fi
		((once)) && return 0
		sleep "$interval"
	done
}

# --- imported images as layers ------------------------------------------
#
# A project's build environment is usually already a docker image - serenedb
# ships its own toolchain image, and rebuilding that inside a VM per run would
# be absurd. So import it: export the image once, keyed by its digest, and
# mount it as a read-only lower layer under the project's own.
#
# This is not a second docker. Docker is good at building and caching an
# image; what it cannot do is run one behind a kernel boundary or hand back a
# running system in 60ms. So it keeps the job it is good at, and its output
# becomes an input here.
#
# Keyed by digest because a toolchain changes on a different cadence than the
# code built with it: the image moves rarely, the build moves every commit.
# One is a layer, the other is a drive.
image_digest() {
	docker image inspect --format '{{.Id}}' "$1" 2>/dev/null | sed 's/^sha256://' | cut -c1-12
}

layer_file() { echo "$STATE_DIR/img-$1.ext4"; }
layers_of_project() { echo "$STATE_DIR/$1.layers"; }

# Export an image to an ext4 that the initramfs will recognise as a layer -
# which means its root has to sit under upper/, with a work/ beside it.
#
# The conversion runs inside a container as root, the same trick prepare uses,
# so root-owned files survive and the host needs no privileges at all.
import_image() {
	local image=$1 digest=$2 out size tar
	out=$(layer_file "$digest")
	[[ -f $out ]] && {
		log "already imported: $image ($digest)"
		return 0
	}

	mkdir -p "$STATE_DIR"
	tar="$STATE_DIR/.img-$digest.tar"
	log "exporting $image"
	local cid
	cid=$(docker create "$image" /bin/true) || die "cannot create a container from $image"
	docker export "$cid" -o "$tar" || {
		docker rm -f "$cid" >/dev/null 2>&1
		die "cannot export $image"
	}
	docker rm -f "$cid" >/dev/null 2>&1

	# Room for the filesystem plus the metadata ext4 needs to describe it.
	size=$(($(stat -c %s "$tar") * 5 / 4 + 512 * 1024 * 1024))
	log "converting to a layer ($(numfmt --to=iec "$size"))"

	docker run --rm -v "$STATE_DIR:/out" --entrypoint bash "$CONVERTER_IMAGE" -c '
		set -euo pipefail
		tar_in=$1; out=$2; size=$3; uid=$4; gid=$5
		stage=/tmp/firecode-layer
		rm -rf "$stage"; mkdir -p "$stage/upper" "$stage/work"
		tar -C "$stage/upper" -xf "$tar_in"
		rm -f "$stage/upper/.dockerenv"
		rm -f "$out.tmp"
		truncate -s "$size" "$out.tmp"
		mkfs.ext4 -q -F -L fl-layer -d "$stage" "$out.tmp"
		chown "$uid:$gid" "$out.tmp"
		mv -f "$out.tmp" "$out"
		rm -rf "$stage"
	' _ "/out/$(basename "$tar")" "/out/$(basename "$out")" "$size" "$(id -u)" "$(id -g)" ||
		die "converting $image to a layer failed"

	rm -f "$tar"
	printf '%s\n' "$image" >"$STATE_DIR/img-$digest.ref"
	log "imported $image as a layer ($(du -sh "$out" | cut -f1) on disk)"
}

cmd_layer() {
	local sub=${1:-ls}
	shift || true
	local dir=$PWD image=""
	local -a rest=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--project | --workdir)
			dir=$(cd "$2" && pwd) || die "no such directory: $2"
			shift 2
			;;
		*)
			rest+=("$1")
			shift
			;;
		esac
	done
	image=${rest[0]:-}
	local slug attached
	slug=$(project_slug "$dir")
	attached=$(layers_of_project "$slug")

	case "$sub" in
	add)
		[[ -n $image ]] || die "usage: firecode layer add <docker-image> [--project DIR]"
		command -v docker >/dev/null 2>&1 || die "docker is needed to import an image"
		local digest
		digest=$(image_digest "$image")
		[[ -n $digest ]] || die "no such image locally: $image (docker pull it first)"
		import_image "$image" "$digest"
		mkdir -p "$STATE_DIR"
		# Attached by digest, so re-tagging or rebuilding the image does not
		# silently change what a VM boots with. Re-running add picks up the
		# new digest and replaces the entry.
		if [[ -f $attached ]]; then
			grep -v "	$image\$" "$attached" >"$attached.tmp" 2>/dev/null || true
			mv -f "$attached.tmp" "$attached"
		fi
		printf '%s\t%s\n' "$digest" "$image" >>"$attached"
		log "$image is now a read-only layer for $dir"
		log "it applies to every VM for this project, worktrees included"
		;;
	ls)
		if [[ ! -s $attached ]]; then
			echo "no imported layers for $dir"
			return 0
		fi
		local d i f
		while IFS=$'\t' read -r d i; do
			f=$(layer_file "$d")
			printf '%-14s %-40s %s\n' "$d" "$i" \
				"$([[ -f $f ]] && du -sh "$f" | cut -f1 || echo "MISSING - re-add it")"
		done <"$attached"
		;;
	rm)
		[[ -n $image ]] || die "usage: firecode layer rm <docker-image> [--project DIR]"
		[[ -f $attached ]] || die "no imported layers for $dir"
		grep -v "	$image\$" "$attached" >"$attached.tmp" || true
		mv -f "$attached.tmp" "$attached"
		log "$image detached from $dir (the image itself is kept - firecode gc drops unused ones)"
		;;
	*) die "usage: firecode layer [add <image>|ls|rm <image>] [--project DIR]" ;;
	esac
}

# What a run actually changed, as paths relative to the project.
changed_files() {
	local src=$1 out=$2
	diff -rq --exclude=.git "$src" "$out" 2>/dev/null |
		sed -e "s|^Files ${src}/||" -e 's| and .* differ$||' \
			-e "s|^Only in ${out}/*|+ |" -e 's|: |/|' \
			-e "s|^Only in ${src}/*|- |" |
		grep -v '^$' || true
}

# A result directory is mostly the project it came from - one file changed out
# of a hundred megabytes is the normal case - and a full copy of it beside
# every run is what turns a project directory into landfill.
#
# So the files that came back identical become hardlinks to the ones already
# on disk. The directory still looks and diffs exactly the same; it just stops
# costing anything.
#
# The tradeoff is real and worth stating out loud: a hardlink is the same
# inode, so writing to one of those files *in place* writes to the project
# too. Editors that save by writing a temp file and renaming it - which is
# most of them, Emacs included - break the link first and are safe. sed -i and
# a shell append are not.
link_unchanged() {
	local src=$1 out=$2 rel linked=0 saved=0 sz
	[[ -d $src && -d $out ]] || return 0

	while IFS= read -r -d '' f; do
		rel=${f#"$out"/}
		[[ -f "$src/$rel" ]] || continue
		# Same file on both sides, so keep one of them.
		cmp -s "$f" "$src/$rel" || continue
		sz=$(stat -c %s "$f" 2>/dev/null || echo 0)
		if ln -f "$src/$rel" "$f" 2>/dev/null; then
			linked=$((linked + 1))
			saved=$((saved + sz))
		fi
	done < <(find "$out" -type f -not -path "$out/.git/*" -print0)

	((linked)) || return 0
	printf '%s of it is hardlinked to the project (%s files unchanged)\n' \
		"$(numfmt --to=iec "$saved" 2>/dev/null || echo "$saved bytes")" "$linked"
}

# --- who owns what ------------------------------------------------------
#
# A run owns a VMM, a few relay processes, a tap, a jail directory and a lock.
# "Stop that VM" has to mean all of it, from any process, whether or not the
# one that started it is still around - and a process tree cannot express
# that. firecracker is deliberately detached, socat gets reparented, and a VM
# started on another VM's behalf is launched by a different firecode entirely,
# with no kinship to the VM that asked for it.
#
# A cgroup expresses it exactly. Every run gets a subtree:
#
#   firecode.slice/run-<id>/vm          the VMM, and nothing else
#                          /relays      the socat processes serving it
#                          /children/   runs started on this one's behalf
#
# The VMM gets a leaf to itself so that "is this run alive" can mean "is the
# VM alive". Relays are helpers: one still running after the VMM died says the
# run is leaking, not that it is up.
#
# so one write to cgroup.kill on run-<id> takes the VM, its helpers, and every
# descendant VM with it - no pids to chase, no races with reparenting, and it
# works from a process that had nothing to do with starting any of them.
#
# Processes only ever live in the leaves, because cgroup v2 refuses a cgroup
# that holds both processes and child cgroups once a controller is enabled.
#
# This also gives liveness an answer that a pid file cannot: a run is alive if
# its cgroup is populated. Nothing to go stale, and a SIGKILLed launcher
# leaves a tree that is still identifiable and still killable.
CG_DIR=""

cg_root() {
	local uid
	uid=$(id -u)
	echo "/sys/fs/cgroup/user.slice/user-$uid.slice/user@$uid.service/firecode.slice"
}

# systemd delegates this subtree to the user, so none of it needs root. Where
# that is not true - no cgroup2, no delegation - everything still runs, and
# lifetime falls back to what it was before: each VM tied to its launcher.
cg_supported() {
	[[ $(stat -fc %T /sys/fs/cgroup 2>/dev/null) == cgroup2fs ]] || return 1
	local base
	base=$(cg_root)
	mkdir -p "$base" 2>/dev/null || return 1
	[[ -w $base/cgroup.procs && -e $base/cgroup.kill ]]
}

# The tree for one run, nested inside its parent's when it has one.
cg_make() {
	local id=$1 parent_cg=${2:-} dir
	cg_supported || return 1
	if [[ -n $parent_cg && -d $parent_cg ]]; then
		dir="$parent_cg/children/run-$id"
	else
		dir="$(cg_root)/run-$id"
	fi
	mkdir -p "$dir/vm" "$dir/relays" 2>/dev/null || return 1
	echo "$dir"
}

# Called inside the subshell that is about to become the VMM or a relay, so
# the process lands in the cgroup before it is anything else.
cg_join() {
	[[ -n ${1:-} && -d $1 ]] || return 0
	echo "$BASHPID" >"$1/cgroup.procs" 2>/dev/null || true
}

# populated is recursive: it is 1 while anything in the subtree is alive.
cg_alive() {
	[[ -n ${1:-} && -d $1 ]] || return 1
	grep -qs '^populated 1' "$1/cgroup.events"
}

# Everything in the subtree, in one write. Descendants included, which is the
# entire point: this is how a child VM stops when its parent does.
cg_kill() {
	local dir=${1:-}
	[[ -n $dir && -d $dir ]] || return 0
	echo 1 >"$dir/cgroup.kill" 2>/dev/null || true
	# A cgroup cannot be removed while it holds processes, and the kill is
	# not instant, so give it a moment before tidying up.
	local waited=0
	while cg_alive "$dir" && ((waited < 50)); do
		sleep 0.1
		waited=$((waited + 1))
	done
	find "$dir" -depth -type d -exec rmdir {} + 2>/dev/null || true
}

# --- fast start ---------------------------------------------------------
#
# Firecracker can save a running VM - guest memory and device state - and map
# it back later. Restoring skips the kernel, systemd, our setup script, and
# the guest memory allocation that dominates a cold start. That last one is
# most of it: a 4G VM spends ~2.4s having its memory set up and ~0.5s
# actually booting.
#
# The catch is that a snapshot is only valid against the exact drive bytes the
# guest had cached. The lower layers are already immutable - they are mounted
# read-only and never written - so they are not the problem. The upper
# workspace layer, the project and the agent state are, and a restored VM gets
# the checkpoint's copies of those rather than the live files.
#
# Which gives the whole thing a clean rule: a fast VM never touches the real
# drives, so it is transient - what it writes goes away with it.
#
# That makes a checkpoint a build artifact rather than a live thing, and it is
# stamped like one: the base images, the project's content and the machine
# shape. Not the mutable drives - a normal run writes to those continuously,
# so pinning them would invalidate the checkpoint every time and it would
# never once be used. The cost of that choice is that a toolchain installed
# after the checkpoint is not in it; --refresh takes a new one.
memcheck_dir() { echo "$STATE_DIR/mem-$1"; }

# What the checkpoint is only valid against. The immutable drives by identity,
# the project by content, and the machine shape - a snapshot of a 4G VM cannot
# be restored into a 1G one.
memcheck_stamp() {
	local project=$1 f
	shift
	# Every drive by identity, immutable or not. A fast VM writes only to its
	# own copies, so these move when a normal run changes something - which is
	# exactly when the checkpoint should stop being used.
	{
		printf 'shape:%s:%s:%s\n' "$MEM" "$VCPU" "$NONET"
		printf 'project:%s\n' "$(dir_fingerprint "$project" 2>/dev/null || echo none)"
		# The agent's binary, not the drive that carries it.
		#
		# The config drive used to be stamped whole, which made this question
		# "has anything on the host that feeds that drive moved" - credentials
		# rotating, a briefing edited, a settings file touched. None of those
		# describe guest memory, and all of them expired every checkpoint on
		# the machine whenever they happened. The drive itself is pinned into
		# the checkpoint now, so what is left to ask is whether the program
		# that would run after a restore is the same one, and that is the
		# binary.
		local bin
		bin=$(command -v "${AGENT:-claude}" 2>/dev/null || true)
		if [[ -n $bin ]]; then
			printf 'agent:%s:%s\n' "${AGENT:-claude}" \
				"$(stat -Lc '%s:%Y' "$bin" 2>/dev/null || echo none)"
		fi
		for f in "$@"; do
			# || continue rather than && printf: a missing file leaves the
			# loop - and so the brace group - with a failing status, which
			# under pipefail fails the whole pipeline, fails the assignment,
			# and under set -e ends the run without printing anything. Which
			# it did, the moment an optional path was passed in last.
			[[ -f $f ]] || continue
			printf '%s:%s:%s\n' \
				"$(basename "$f")" "$(stat -c %s "$f")" "$(stat -c %Y "$f")"
		done
	} | sha256sum | cut -d' ' -f1
}

memcheck_valid() {
	local d=$1 stamp=$2 f
	[[ -n ${FIRECODE_TRACE:-} ]] &&
		log "checkpoint: want $stamp, have $(cat "$d/stamp" 2>/dev/null || echo none)"
	[[ -f $d/vmstate && -f $d/mem && -f $d/stamp && -f $d/writables ]] || return 1
	[[ $(cat "$d/stamp") == "$stamp" ]] || return 1
	while read -r f; do
		[[ -f $d/w-$f ]] || return 1
	done <"$d/writables"
	return 0
}

# Save a running VM. Paused first, so guest memory and the drive files agree -
# copying a drive out from under a running guest would checkpoint a filesystem
# mid-write.
memcheck_save() {
	local api=$1 jail=$2 dest=$3 stamp=$4 f
	shift 4
	local tmp="$dest.new"
	rm -rf "$tmp"
	mkdir -p "$tmp" "$jail/snap"

	fc_api "$api" PATCH /vm '{"state":"Paused"}' || return 1
	fc_api "$api" PUT /snapshot/create \
		'{"snapshot_type":"Full","snapshot_path":"snap/vmstate","mem_file_path":"snap/mem"}' ||
		return 1

	for f in "$@"; do
		cp --sparse=always "$jail/$f" "$tmp/w-$f" || return 1
		printf '%s\n' "$f"
	done >"$tmp/writables"

	fc_api "$api" PATCH /vm '{"state":"Resumed"}' || true

	[[ -f $jail/snap/vmstate && -f $jail/snap/mem ]] || return 1
	mv -f "$jail/snap/vmstate" "$tmp/vmstate"
	mv -f "$jail/snap/mem" "$tmp/mem"
	# Guest memory is written out in full and is mostly zeroes; punching them
	# out costs nothing and keeps a 4G VM from being a 4G file.
	fallocate -d "$tmp/mem" 2>/dev/null || true
	printf '%s\n' "$stamp" >"$tmp/stamp"

	# Pin the config drive this memory describes.
	#
	# It is read-only and shared between runs, so it was never copied - but
	# it is also rebuilt whenever anything on the host that feeds it moves,
	# and a rebuild replaces the file. A guest resumed against a different
	# image than its memory describes is corruption, so the checkpoint used to
	# be invalidated by the rebuild instead: editing an agent briefing expired
	# every checkpoint on the machine, none of which had anything to do with
	# it.
	#
	# A hard link costs nothing and pins the exact inode. The rebuild unlinks
	# the shared name and writes a new file; this link keeps the old bytes
	# alive for as long as the checkpoint wants them, and a restore attaches
	# these rather than whatever the shared name points at now.
	if [[ -n ${CFG_DRIVE:-} && -f $CFG_DRIVE ]]; then
		ln "$CFG_DRIVE" "$tmp/roconfig.ext4" 2>/dev/null ||
			cp --sparse=always "$CFG_DRIVE" "$tmp/roconfig.ext4" || return 1
	fi

	rm -rf "$dest"
	mv "$tmp" "$dest"
	return 0
}

# Wait for the API socket, then map the snapshot back in and let it run.
memcheck_load() {
	local sock=$1 waited=0 t0
	# Microseconds, from the shell. Not date +%s%3N: this machine's date is
	# uutils, which ignores the width and hands back all nine digits.
	t0=${EPOCHREALTIME/[.,]/}
	while [[ ! -S $sock ]] && ((waited < 100)); do
		sleep 0.05
		waited=$((waited + 1))
	done
	[[ -S $sock ]] || {
		log "firecracker never opened its API socket"
		return 1
	}
	fc_api "$sock" PUT /snapshot/load \
		'{"snapshot_path":"vmstate","mem_backend":{"backend_path":"mem","backend_type":"File"},"resume_vm":true}' || return 1
	log "guest resumed in $(((${EPOCHREALTIME/[.,]/} - t0) / 1000))ms"
}

fc_api() {
	local sock=$1 method=$2 path=$3 body=$4 out
	out=$(curl -s -f --unix-socket "$sock" -X "$method" \
		-H 'Content-Type: application/json' \
		-d "$body" "http://localhost$path" 2>&1) || {
		log "firecracker refused $method $path: $out"
		return 1
	}
	return 0
}

# A VM that stays up. The point is a warm machine an agent can keep hitting -
# toolchain installed, data in place - rather than paying a boot and a build
# for every command it wants to run.
cmd_up() {
	local here=$PWD
	local -a passthru=()
	local fast=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--workdir | --project)
			here=$(cd "$2" && pwd) || die "no such directory: $2"
			passthru+=(--workdir "$here")
			shift 2
			;;
		--fast)
			fast=1
			passthru+=(--fast)
			shift
			;;
		--refresh)
			fast=1
			passthru+=(--refresh)
			shift
			;;
		*)
			passthru+=("$1")
			shift
			;;
		esac
	done
	if live_vm_socket "$here" >/dev/null 2>&1; then
		log "a VM is already up for this project - firecode in <command>"
		return 0
	fi

	# Held open by a process that does nothing, so the VM stays up until it is
	# told to stop.
	log "starting a VM and leaving it up"
	nohup setsid "$SELF" exec ${passthru+"${passthru[@]}"} --timeout 0 -- \
		sh -c 'while :; do sleep 3600; done' \
		>"$RUNS/up.log" 2>&1 &
	disown 2>/dev/null || true

	# Firecracker's socket accepts a connection the moment the VMM starts,
	# which is long before the guest has booted and opened its channels. Wait
	# for something to actually answer on the exec port instead.
	# A restore answers in a fraction of a second, so polling once a second
	# would be most of what a fast start costs. Check often at first, then
	# back off to stay cheap across a cold boot's minutes.
	local waited=0 nap=0.05
	while ((waited < 900)); do
		local sock
		if sock=$(live_vm_socket "$here" 2>/dev/null) &&
			python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - true >/dev/null 2>&1; then
			((fast)) && up_checkpoint "$sock"
			log "up. firecode in <command>, firecode enter, firecode down"
			return 0
		fi
		# A VM that died is not a VM that is slow. Without this the loop waits
		# out its whole timeout on a run that failed in the first second.
		#
		# "error:" as well as the VMM's own failures: a run can end before
		# firecracker is ever started - a missing disk, an unreadable image -
		# and matching only the VMM's exit meant those waited the full fifteen
		# minutes and then reported a timeout, which says nothing about the
		# actual cause.
		if grep -qE "Firecracker exiting with error|VM exited|\[firecode\] error:" \
			"$RUNS/up.log" 2>/dev/null; then
			log "the VM failed to start:"
			grep -E "\[firecode\] error:|Error|error:" "$RUNS/up.log" | tail -3 >&2
			die "see $RUNS/up.log"
		fi
		sleep "$nap"
		waited=$((waited + 1))
		((waited == 40)) && nap=0.25
		((waited == 100)) && nap=1
	done
	die "the VM did not come up - see $RUNS/up.log"
}

# A VM that just booted is the best thing to checkpoint: nothing has run in it
# yet, so what comes back on restore is a clean warm VM rather than someone
# else's leftovers.
up_checkpoint() {
	local sock=$1 jail
	jail=$(dirname "$sock")

	# A restored guest wakes up believing it is still the moment it was saved.
	# A wrong clock breaks TLS and confuses git, so correct it either way.
	python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - \
		"sudo date -s @$(date +%s)" >/dev/null 2>&1 || true

	[[ -f $jail/.memcheck-stamp ]] || return 0
	local -a w=()
	mapfile -t w <"$jail/.memcheck-writables"

	# Never replace a checkpoint that was not restored from.
	#
	# The stamp a checkpoint is keyed to covers host-side inputs - the config
	# drive among them - so editing an agent briefing invalidates every
	# project's checkpoint without touching a VM. --fast then boots normally,
	# which is correct, and used to take a fresh checkpoint on the way, which
	# is not: memcheck_save replaces the directory outright, so the fixture
	# somebody spent an hour building was overwritten by a bare boot, and the
	# only clue was that "back at the checkpoint" took nineteen seconds
	# instead of two.
	#
	# Replacing one is what --refresh is for, and it should take saying so.
	local dest
	dest=$(cat "$jail/.memcheck-dir")
	if [[ -d $dest ]] && ((REFRESH == 0)); then
		log "this start did not restore, so the existing checkpoint is left alone"
		log "  (it no longer matches this configuration - 'up --refresh' replaces it)"
		rm -f "$jail"/.memcheck-*
		return 0
	fi
	log "taking a checkpoint so the next start skips the boot"
	if memcheck_save "$jail/firecracker.socket" "$jail" \
		"$(cat "$jail/.memcheck-dir")" "$(cat "$jail/.memcheck-stamp")" "${w[@]}"; then
		# Real blocks, not apparent size: guest memory and the drive copies
		# are full of holes, and reporting 25G for 1.1G on disk is a lie.
		log "checkpointed ($(du -sh "$(cat "$jail/.memcheck-dir")" | cut -f1) on disk)"
	else
		log "could not checkpoint - this stays a normal VM"
	fi
	rm -f "$jail"/.memcheck-*
}

# Grow a running VM's disk, without stopping it.
#
# The default layer suits installing toolchains. Profiling does not: a perf
# capture of a busy process runs to hundreds of megabytes a minute, and a full
# layer does not just fail the capture - it stops the VM being able to do
# anything, which is a confusing way to learn you needed more disk.
#
# Three steps, none of which interrupt the guest: grow the sparse file, have
# firecracker re-read its size (a PATCH re-reads the backing file and raises a
# config-change interrupt), then resize the filesystem online, which ext4 has
# always been able to do while mounted.
cmd_grow() {
	local want="" drive="upper" size=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--project)
			want=$(cd "$2" && pwd)
			shift 2
			;;
		--drive)
			drive="$2"
			shift 2
			;;
		*)
			size="$1"
			shift
			;;
		esac
	done
	[[ -n $size ]] || die "usage: firecode grow [--drive upper|state|src] SIZE   (e.g. 64G, or +32G)"

	local sock jail
	sock=$(require_vm_socket "$want")
	jail=$(dirname "$sock")
	[[ -f $jail/vm-config.json ]] ||
		die "this VM was restored from a checkpoint, so it has no drive table to grow from"

	local base
	base=$(python3 -c '
import json, sys
cfg = json.load(open(sys.argv[1]))
for d in cfg.get("drives", []):
    if d.get("drive_id") == sys.argv[2]:
        print(d["path_on_host"])
        break
' "$jail/vm-config.json" "$drive") || true
	[[ -n $base && -f $jail/$base ]] || die "no drive called $drive in this VM"

	local now target
	now=$(stat -c %s "$jail/$base")
	if [[ $size == +* ]]; then
		target=$((now + $(numfmt --from=iec "${size#+}")))
	else
		target=$(numfmt --from=iec "$size")
	fi
	((target > now)) || die "$drive is already $(numfmt --to=iec "$now") - this only grows"

	# Sparse, so this costs nothing until the guest writes into it.
	truncate -s "$target" "$jail/$base" || die "could not grow the image"
	fc_api "$jail/firecracker.socket" PATCH "/drives/$drive" \
		"{\"drive_id\":\"$drive\",\"path_on_host\":\"$base\"}" ||
		die "firecracker would not re-read the drive"

	# The label is how the guest finds it: the device letter depends on the
	# order drives were attached, and the layer is under an overlay so nothing
	# mounted points at it.
	local label
	case "$drive" in
	upper) label=fl-layer ;;
	src) label=firecode-src ;;
	state) label=firecode-state ;;
	*) label="" ;;
	esac
	if [[ -n $label ]]; then
		python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - \
			"dev=\$(blkid -L $label) && sudo resize2fs \$dev" >/dev/null 2>&1 ||
			log "the guest did not resize its filesystem - do it there with resize2fs"
	fi
	log "$drive is now $(numfmt --to=iec "$target"), while the VM keeps running"
	python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - "df -h / | tail -1" 2>/dev/null || true
}

# Freeze the VM that is running now, whatever state it has got itself into.
#
# This is the one that makes a generated fixture worth generating. An agent
# builds itself a database, loads it, gets it into a state worth keeping - and
# from then on that state is 60ms away, as often as it likes, however badly it
# wrecks it in between.
cmd_checkpoint() {
	local want=""
	[[ ${1:-} == --project ]] && want=$(cd "$2" && pwd)
	local sock jail
	sock=$(require_vm_socket "$want")
	jail=$(dirname "$sock")
	# Two different reasons, and the message used to give the wrong one - it
	# blamed an older firecode, which sent somebody looking for a version skew
	# that did not exist. A VM that was restored, or that has already been
	# checkpointed once since it started, has had these markers cleared.
	if [[ ! -f $jail/.memcheck-stamp ]]; then
		if [[ -f $jail/vmstate ]]; then
			die "this VM was restored from a checkpoint, so it cannot be checkpointed
       again. Take one from a VM that booted normally: firecode down, then
       firecode up (without --fast), get it into the state you want, and
       firecode checkpoint."
		fi
		die "this VM cannot be checkpointed - no checkpoint markers in its jail,
       which means it was started by an older firecode, or it has already been
       checkpointed since it started."
	fi

	local -a w=()
	mapfile -t w <"$jail/.memcheck-writables"
	log "pausing the VM and writing it out"
	if memcheck_save "$jail/firecracker.socket" "$jail" \
		"$(cat "$jail/.memcheck-dir")" "$(cat "$jail/.memcheck-stamp")" "${w[@]}"; then
		log "checkpointed ($(du -sh "$(cat "$jail/.memcheck-dir")" | cut -f1) on disk)"
		log "restore it with:  firecode up --fast"
	else
		die "could not checkpoint this VM"
	fi
}

# One command in the VM that is up, with its output and its exit status.
cmd_in() {
	local cwd="-" want=""
	while [[ ${1:-} == --* ]]; do
		case "$1" in
		--cwd)
			cwd="$2"
			shift 2
			;;
		--project)
			want=$(cd "$2" && pwd)
			shift 2
			;;
		*) break ;;
		esac
	done
	[[ $# -gt 0 ]] || die "usage: firecode in [VM] [--cwd DIR] <command...>"

	# `firecode in fctop pytest` names the VM the way docker exec does, while
	# `firecode in pytest` still means the VM belonging to where you are
	# standing. Told apart by asking: a first word that is a running VM is the
	# VM, anything else is the command. Ambiguous only if you name a VM after
	# a program you also want to run in it.
	if (($# > 1)) && live_vm_socket "$1" >/dev/null 2>&1; then
		want="$1"
		shift
	fi

	local sock
	sock=$(require_vm_socket "$want")
	python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" "$cwd" "$@"
}

# The room.
#
# Every agent here works alone by construction - one per VM, one per session -
# which is the point and also the blind spot: two of them can spend an hour on
# the same wrong assumption without ever finding out. This is a place to say
# something to all of them at once, and to hear what they have said.
#
#   firecode chat serve              start it (once, on the host)
#   firecode chat 'text'             say something
#   firecode chat --read             everything said so far
#   firecode chat --wait             block until somebody says something new
cmd_chat() {
	# 9761 rather than 9760: this machine's reranker has had 9760 since July,
	# and a chat room that quietly answers 404 because it never started is
	# worse than one on an odd port.
	local port=${FIRECODE_CHAT_PORT:-9761} who=${FIRECODE_CHAT_NAME:-$(id -un)@host}
	local mode=say since=0 wait=0
	while [[ ${1:-} == -* || ${1:-} == serve || ${1:-} == install ]]; do
		case "${1:-}" in
		serve)
			mode=serve
			shift
			;;
		install)
			mode=install
			shift
			;;
		--read)
			mode="read"
			shift
			;;
		--wait)
			mode="read"
			wait=${FIRECODE_CHAT_WAIT:-60}
			shift
			;;
		--inbox)
			# Blocks until somebody actually says something, then prints it
			# and exits - which is what makes this usable as a notification
			# rather than a poll. An agent whose harness tells it when a
			# background command finishes gets told when the room speaks.
			mode="inbox"
			wait=${FIRECODE_CHAT_WAIT:-120}
			shift
			;;
		--since)
			since="$2"
			shift 2
			;;
		--as)
			who="$2"
			shift 2
			;;
		--port)
			port="$2"
			shift 2
			;;
		*) die "usage: firecode chat [serve|--read|--wait|--as NAME] [text...]" ;;
		esac
	done

	if [[ $mode == install ]]; then
		# A room that survives everything that started it.
		#
		# Run from a session, the room dies with the session - and the one
		# thing a shared room must not be is as short-lived as its most
		# talkative member. A user unit outlives sessions, reboots and the
		# person who set it up, and needs no root.
		local unit_dir="$HOME/.config/systemd/user"
		mkdir -p "$unit_dir" "$RUNS"
		cat >"$unit_dir/firecode-chat.service" <<-EOF
			[Unit]
			Description=firecode chat - the room agents on this machine talk in
			Documentation=https://github.com/deadtrickster/firecode

			[Service]
			ExecStart=$(command -v python3) $SCRIPTS/chat.py --port $port --log $RUNS/chat.log
			Restart=always
			RestartSec=2
			# Nothing here is secret, but nothing here needs privileges either.
			NoNewPrivileges=true
			PrivateTmp=false

			[Install]
			WantedBy=default.target
		EOF
		systemctl --user daemon-reload
		systemctl --user enable --now firecode-chat.service
		# Linger, or the room stops when the last login session ends - which
		# is precisely when unattended runs are still going.
		if ! loginctl show-user "$(id -un)" -p Linger 2>/dev/null | grep -q "Linger=yes"; then
			log "note: enable-linger is off, so this stops when your last session ends"
			log "  fix with: sudo loginctl enable-linger $(id -un)"
		fi
		log "chat runs as a user service now: systemctl --user status firecode-chat"
		return 0
	fi

	if [[ $mode == serve ]]; then
		mkdir -p "$RUNS"
		if ss -ltn 2>/dev/null | grep -q ":$port "; then
			log "chat is already up on $port"
			return 0
		fi
		setsid python3 "$SCRIPTS/chat.py" --port "$port" --log "$RUNS/chat.log" \
			>"$RUNS/chat-server.log" 2>&1 &
		disown 2>/dev/null || true
		local waited=0
		while ((waited < 40)) && ! ss -ltn 2>/dev/null | grep -q ":$port "; do
			sleep 0.1
			waited=$((waited + 1))
		done
		log "chat on port $port - give a VM --host-port $port and it can join"
		return 0
	fi

	if [[ $mode == inbox ]]; then
		# Its own mark, so the command never has to carry one.
		#
		# `--inbox --since 12` is a different command line every time it is
		# used, which is exactly the thing that cannot be granted once and so
		# asks the person behind the agent to approve another near-identical
		# command every few minutes. The position belongs in a file, not in
		# the argument list. One name, one mark, so two watchers reading the
		# room do not consume each other's messages.
		local mark_file="$RUNS/chat-mark-${who//[^A-Za-z0-9._-]/-}"
		if ((since == 0)) && [[ -f $mark_file ]]; then
			since=$(cat "$mark_file" 2>/dev/null || echo 0)
			[[ $since =~ ^[0-9]+$ ]] || since=0
		fi
		# The server caps a single long-poll, so this repeats one until there
		# is something to report or the whole wait runs out. Exit 0 with
		# messages, 1 with none, so a caller can tell "nobody spoke" from
		# "here is what was said" without parsing.
		local deadline=$(($(date +%s) + ${FIRECODE_CHAT_DEADLINE:-1800})) out=""
		while (($(date +%s) < deadline)); do
			out=$(FIRECODE_CHAT_MARK="$mark_file" curl -s -m $((wait + 30)) \
				"http://127.0.0.1:$port/messages?since=$since&wait=$wait" |
				FIRECODE_CHAT_MARK="$mark_file" FIRECODE_CHAT_SELF="$who" python3 -c '
import json, os, sys, time
d = json.load(sys.stdin)
me = os.environ.get("FIRECODE_CHAT_SELF", "")
for m in d.get("messages", []):
    # Not your own. Waiting on a room you also speak in means every message
    # you send wakes you up to tell you what you just said, which for an
    # agent costs a turn each time.
    if m.get("from") == me:
        continue
    stamp = time.strftime("%H:%M:%S", time.localtime(m["at"]))
    print("[%s] %s: %s" % (stamp, m["from"], m["text"]))
if d.get("messages"):
    # The mark moves past everything that was read, including your own -
    # otherwise the next call reads them again and skips them again forever.
    with open(os.environ["FIRECODE_CHAT_MARK"], "w") as fh:
        fh.write(str(d.get("last", 0)))' 2>/dev/null)
			[[ -n $out ]] && {
				printf '%s\n' "$out"
				# Said with the messages rather than in a document nobody
				# rereads: an unanswered message is indistinguishable from an
				# unread one, and the sender acts on that.
				echo
				echo "-- ack anything addressed to you before you work on it"
				echo "-- ('firecode chat --as <you> \"seen, doing X\"'), then"
				echo "-- start this waiter again so you stay in the room"
				return 0
			}
		done
		echo "nobody said anything (since id $since)"
		return 1
	fi

	if [[ $mode == read ]]; then
		curl -s -m $((wait + 30)) \
			"http://127.0.0.1:$port/messages?since=$since&wait=$wait" |
			python3 -c '
import json, sys, time
d = json.load(sys.stdin)
for m in d.get("messages", []):
    stamp = time.strftime("%H:%M:%S", time.localtime(m["at"]))
    print("[%s] %s: %s" % (stamp, m["from"], m["text"]))
print("-- last id: %d" % d.get("last", 0))'
		return 0
	fi

	[[ $# -gt 0 ]] || die "usage: firecode chat 'what you want to say'"
	FIRECODE_CHAT_WHO="$who" FIRECODE_CHAT_TEXT="$*" python3 -c '
import json, os, sys, urllib.request
body = json.dumps({"from": os.environ["FIRECODE_CHAT_WHO"],
                   "text": os.environ["FIRECODE_CHAT_TEXT"]}).encode()
req = urllib.request.Request(sys.argv[1], data=body,
                             headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=15) as r:
        print("said (#%d)" % json.load(r)["id"])
except Exception as exc:
    sys.exit("chat is not answering on %s: %s" % (sys.argv[1], exc))
' "http://127.0.0.1:$port/say"
}

# Wait, then say what a run has been doing.
#
# For whoever is watching a run they did not start - a person with a terminal,
# or an agent supervising another agent. Watching means pausing between looks,
# and a pause an agent writes for itself is a different command line every
# time: a bare sleep, a computed deadline, a loop. None of those can be
# permitted once, so the person behind the supervisor is asked to approve
# another almost-identical command every couple of minutes.
#
# One command, always the same shape, so it can be granted once and then
# forgotten about.
cmd_watch() {
	# 60 rather than 120: a caller that has to wrap this in its own timeout
	# has already lost the point of it, and most tool harnesses cut a command
	# off at two minutes. Short enough to survive that, long enough that
	# looking is not the main thing this watcher does.
	local want="" every=60 lines=60
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--every)
			every="$2"
			shift 2
			;;
		-n | --lines)
			lines="$2"
			shift 2
			;;
		--project)
			want=$(cd "$2" && pwd)
			shift 2
			;;
		-*) die "usage: firecode watch [VM] [--every SEC] [-n LINES]" ;;
		*)
			want="$1"
			shift
			;;
		esac
	done

	sleep "$every"

	# Whether it is still up comes first: the same tail means one thing from a
	# VM that is still working and another from one that has finished.
	local ids
	ids=$(cmd_list --ids 2>/dev/null || true)
	if [[ -n $want ]] && ! grep -qw -- "$want" <<<"$ids"; then
		echo "== $want is GONE (finished, or stopped)"
	else
		echo "== ${want:-the run} is running"
	fi
	echo "== last $lines lines after ${every}s"
	cmd_logs ${want:+"$want"} -n "$lines"
}

# Say something to a run that is already going.
#
# An unattended agent used to be a thing you could watch and not a thing you
# could answer, so a correction that occurred to you in minute ten waited for
# the run to end and then needed a whole new run. The agent takes further user
# turns on stdin, the entrypoint gives it a fifo, and this writes into it.
cmd_say() {
	local want=""
	while [[ ${1:-} == --* ]]; do
		case "$1" in
		--project)
			want=$(cd "$2" && pwd)
			shift 2
			;;
		*) break ;;
		esac
	done
	if (($# > 1)) && live_vm_socket "$1" >/dev/null 2>&1; then
		want="$1"
		shift
	fi
	[[ $# -gt 0 ]] || die "usage: firecode say [VM] <text...>"

	local sock text
	sock=$(require_vm_socket "$want")
	text="$*"

	# Encoded on the way in and decoded in the guest, because this is arbitrary
	# text crossing a shell: a quote or a newline in a correction would
	# otherwise end up as a syntax error in the command that carries it.
	local encoded
	encoded=$(printf '%s' "$text" | base64 -w0)
	local out
	# Two agents, two channels. claude takes further turns on stdin, so there
	# is a fifo to write a message into. opencode takes them through the
	# server its run is attached to, addressed to that run's session. Which
	# one is here is a question about this VM, so the guest answers it.
	out=$(python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - "
inbox=/tmp/firecode-agent-inbox
session=/tmp/firecode-agent-session
msg=\$(printf '%s' '$encoded' | base64 -d)
# On the console too, so it is in the run's log next to what the agent did
# with it. A supervisor's nudge that only exists in the supervisor's own
# transcript makes the log a record of an argument with one side missing.
printf '[firecode] <- said: %s\n' \"\$msg\" | sudo tee /dev/console >/dev/null 2>&1 || true
if [ -p \$inbox ]; then
    # The stamp is what keeps the run alive: the guest closes the agent's
    # stdin after a stretch with nothing said to it, and this is how it knows
    # somebody is still here.
    touch \$inbox.stamp 2>/dev/null || true
    FIRECODE_MSG=\$msg python3 -c '
import json, os, sys
sys.stdout.write(json.dumps({\"type\": \"user\",
    \"message\": {\"role\": \"user\", \"content\": os.environ[\"FIRECODE_MSG\"]}}) + \"\\n\")
' > \$inbox
    echo sent
elif [ -s \$session ]; then
    # Detached, because this call waits for the whole reply - which for a
    # session that is in the middle of something is however long that takes,
    # and saying something should not block on being answered. The reply
    # arrives in the run's own output either way.
    setsid nohup opencode run --attach http://127.0.0.1:\${FIRECODE_OPENCODE_PORT:-4096} \
        --session \"\$(cat \$session)\" \"\$msg\" >>/tmp/firecode-say.log 2>&1 &
    sleep 1
    echo sent
else
    echo 'no inbox'
    exit 3
fi
" 2>&1) || true

	case "$out" in
	*sent*) log "said it - the agent takes it at the end of its current turn" ;;
	*"no inbox"*)
		die "this run has no inbox - only an unattended claude run started by
       this harness takes further turns (an interactive session is already
       yours: use 'firecode enter')"
		;;
	*) die "could not reach the agent: $out" ;;
	esac
}

cmd_down() {
	local want=""
	[[ ${1:-} == --project ]] && want=$(cd "$2" && pwd)
	local sock
	sock=$(require_vm_socket "$want")
	log "stopping the VM"
	# Asking it to shut down cleanly is what unmounts the project drive and
	# lets the work be copied back.
	python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - \
		"sudo systemctl --no-block reboot" >/dev/null 2>&1 || true
	local waited=0
	while ((waited < 60)); do
		vm_reachable "$sock" || {
			log "stopped"
			return 0
		}
		sleep 1
		waited=$((waited + 1))
	done
	log "it is taking its time; still shutting down"
}

cmd_enter() {
	local want=${1:-}
	# A name, a project path, or nothing and the VM you are standing in.
	[[ -n $want && -d $want ]] && want=$(cd "$want" && pwd)
	local -a socks=()
	socks=("$(require_vm_socket "$want")")

	log "entering the VM (exit leaves it running)"
	exec python3 "$SCRIPTS/vsock-console.py" "${socks[0]}" "$CONSOLE_PORT"
}

# Sessions are named after the project, so this needs no arguments in the
# usual case: you are standing in the project you want.
cmd_attach() {
	local sess
	sess=$(session_name "${1:-}")
	local mux=tmux
	command -v byobu >/dev/null 2>&1 && mux=byobu
	if ! tmux has-session -t "$sess" 2>/dev/null; then
		echo "no session for ${1:-$(basename "$PWD")}. Running ones:"
		cmd_sessions
		return 1
	fi
	exec "$mux" attach -t "$sess"
}

cmd_sessions() {
	local out
	out=$(tmux ls 2>/dev/null | grep '^firecode/' || true)
	if [[ -z $out ]]; then
		echo "  (none)"
		return 0
	fi
	printf '  %s\n' "$out"
}

cmd_cp() {
	local src=${1:-} dst=${2:-}
	[[ -n $src && -n $dst ]] || die "usage: firecode cp <src> <dst>   (vm:/path for the guest side)"

	# Whichever VM is running right now. One at a time is the common case; be
	# explicit about it rather than guessing between several.
	local -a socks=()
	local d
	for d in "$JAIL_BASE"/firecracker/*/root; do
		[[ -S $d/firecracker-vsock.sock ]] || continue
		# The file outlives the VM. Only something listening counts.
		vm_reachable "$d/firecracker-vsock.sock" &&
			socks+=("$d/firecracker-vsock.sock")
	done
	((${#socks[@]} > 0)) || die "no VM is running"
	((${#socks[@]} == 1)) || die "${#socks[@]} VMs are running - stop all but one"

	if [[ $src == vm:* ]]; then
		python3 "$SCRIPTS/vsock-cp.py" "${socks[0]}" "$FILES_PORT" get "${src#vm:}" "$dst"
	elif [[ $dst == vm:* ]]; then
		python3 "$SCRIPTS/vsock-cp.py" "${socks[0]}" "$FILES_PORT" put "$src" "${dst#vm:}"
	else
		die "one side has to be vm:<path>"
	fi
}

cmd_snapshot() {
	local sub=${1:-take}
	case "$sub" in
	ls | list | rm | restore | take) shift ;;
	*) sub=take ;;
	esac

	local dir=$PWD slug base
	slug=$(project_slug "$(cd "$dir" && pwd)")
	base="$STATE_DIR/snapshots/$slug"

	case "$sub" in
	take)
		local name=${1:-}
		[[ -n $name ]] || name=$(date +%Y%m%d-%H%M%S)
		local dest="$base/$name"
		[[ -e $dest ]] && die "snapshot $name already exists"
		mkdir -p "$dest"

		local part path label n=0
		while IFS= read -r part; do
			path=${part%:*}
			label=${part##*:}
			[[ -f $path ]] || continue
			log "capturing $label"
			cp --sparse=always "$path" "$dest/$label.ext4"
			n=$((n + 1))
		done < <(snapshot_parts "$slug")

		((n > 0)) || {
			rmdir "$dest" 2>/dev/null
			die "nothing to snapshot yet - run something in this project first"
		}
		printf '%s\n' "$dir" >"$dest/project"
		log "snapshot $name: $n drive(s), $(du -sh "$dest" | cut -f1) on disk"
		echo "  restore with:  firecode snapshot restore $name"
		;;
	ls | list)
		if ! compgen -G "$base/*" >/dev/null; then
			echo "no snapshots for $dir"
			return 0
		fi
		local d
		for d in "$base"/*/; do
			printf '%-24s %-6s %s\n' "$(basename "$d")" \
				"$(du -sh "$d" 2>/dev/null | cut -f1)" \
				"$(date -r "$d" '+%Y-%m-%d %H:%M')"
		done
		;;
	restore)
		local name=${1:-}
		[[ -n $name ]] || die "usage: firecode snapshot restore <name>"
		local src="$base/$name"
		[[ -d $src ]] || die "no snapshot $name for $dir"
		# Refuse while a run holds the project, or we would be swapping the
		# drives out from under a live VM.
		mkdir -p "$STATE_DIR"
		local fd
		exec {fd}>"$STATE_DIR/$slug.lock"
		flock -n "$fd" || die "a run is using this project right now"

		local part path label
		while IFS= read -r part; do
			path=${part%:*}
			label=${part##*:}
			[[ -f $src/$label.ext4 ]] || continue
			cp --sparse=always "$src/$label.ext4" "$path.restoring"
			mv -f "$path.restoring" "$path"
			log "restored $label"
		done < <(snapshot_parts "$slug")
		exec {fd}>&-
		log "restored snapshot $name - the next run continues from there"
		;;
	rm)
		local name=${1:-}
		[[ -n $name ]] || die "usage: firecode snapshot rm <name>"
		[[ -d $base/$name ]] || die "no snapshot $name for $dir"
		rm -rf "${base:?}/${name:?}"
		log "removed snapshot $name"
		;;
	*) die "usage: firecode snapshot [take [name]|ls|restore <name>|rm <name>]" ;;
	esac
}

cmd_state() {
	local sub=${1:-list}
	shift || true
	case "$sub" in
	list)
		if ! compgen -G "$STATE_DIR/*.ext4" >/dev/null; then
			echo "no project state yet"
			return 0
		fi
		local f
		for f in "$STATE_DIR"/*.ext4; do
			printf '%-44s %s\n' "$(basename "$f" .ext4)" \
				"$(du -h --apparent-size "$f" | cut -f1)"
		done
		;;
	sessions)
		local dir=${1:-$PWD} img tmp
		img="$STATE_DIR/$(project_slug "$(cd "$dir" && pwd)").ext4"
		[[ -f $img ]] || die "no state for $dir yet"
		tmp=$(mktemp -d)
		sbin debugfs -R "rdump /upper/claude/projects $tmp" "$img" >/dev/null 2>&1 || true
		if compgen -G "$tmp/projects/*/*.jsonl" >/dev/null; then
			local s
			# Newest last, so the most useful one is next to the prompt.
			while IFS= read -r s; do
				printf '%s  %s\n' "$(date -r "$s" '+%Y-%m-%d %H:%M')" \
					"$(basename "$s" .jsonl)"
			done < <(find "$tmp/projects" -name '*.jsonl' -printf '%T@ %p\n' |
				sort -n | cut -d' ' -f2-)
			echo
			echo "resume with:  firecode claude --resume <id> 'next thing'"
		else
			echo "no sessions recorded for $dir yet"
		fi
		rm -rf "$tmp"
		;;
	reset)
		local dir=${1:-$PWD} img
		img="$STATE_DIR/$(project_slug "$(cd "$dir" && pwd)").ext4"
		[[ -f $img ]] || die "no state for $dir"
		rm -f "$img" "${img%.ext4}-src.ext4" "${img%.ext4}-root.ext4" \
			"${img%.ext4}.imported"
		log "removed this project's agent home, working tree and rootfs"
		;;
	*)
		die "usage: firecode state [list|sessions [dir]|reset [dir]]"
		;;
	esac
}

# ---------------------------------------------------------------- networking

NET_SLOT=""
TAP_DEV=""
NET_ADOPTED=0
NET_FD=""

# Each VM gets its own tap and its own /30, so several can run at once. A slot
# is held with a lock file rather than by looking at what exists, because a
# persistent tap left behind by net-setup exists whether or not it is in use.
#
# Sets NET_SLOT and NET_FD rather than printing. It cannot print: a command
# substitution runs in a subshell, so the descriptor holding the lock would be
# closed the moment it returned, and every VM would take the same slot.
alloc_net_slot() {
	local s fd i
	mkdir -p "$STATE_DIR/net"

	# Try this project's own slot first, derived from its path, so a given
	# project keeps the same guest address run after run and a dashboard it
	# serves stays at a URL you can bookmark. Chosen from the taps that
	# already exist, since any other slot would need root to create one.
	local preferred=1
	local -a ready=()
	for ((s = 1; s <= 250; s++)); do
		[[ -e /sys/class/net/fccode$s ]] && ready+=("$s")
	done
	if [[ -n ${SLUG:-} && ${#ready[@]} -gt 0 ]]; then
		local h
		h=$((0x$(printf '%s' "$SLUG" | sha256sum | cut -c1-4)))
		preferred=${ready[$((h % ${#ready[@]}))]}
	fi

	for ((i = 0; i <= 250; i++)); do
		if ((i == 0)); then
			s=$preferred
		else
			s=$i
			((s == preferred)) && continue
		fi
		exec {fd}>"$STATE_DIR/net/$s.lock"
		if ! flock -n "$fd"; then
			exec {fd}>&-
			continue
		fi
		# The lock says no live firecode holds this slot, which is not the same
		# as the tap being free: a VM outlives a firecode that was killed
		# rather than asked to stop, and it keeps the device open. A tap with
		# a process attached has carrier; an idle one does not.
		if [[ $(cat "/sys/class/net/fccode$s/carrier" 2>/dev/null || echo 0) == 1 ]]; then
			log "fccode$s is still in use by something, trying the next slot"
			exec {fd}>&-
			continue
		fi
		NET_FD=$fd
		NET_SLOT=$s
		return 0
	done
	return 1
}

# One-time root setup for a tap. Made persistent and owned by the invoking
# user, so afterwards firecracker can open it with no privileges at all.
net_create_tap() {
	local dev=$1 slot=$2 owner
	# Under sudo, id -u is 0. The tap has to belong to whoever will actually
	# run firecracker, or the whole point of making it persistent is lost.
	owner=${SUDO_UID:-$(id -u)}
	priv ip tuntap add dev "$dev" mode tap user "$owner"
	priv ip addr add "172.16.$slot.1/30" dev "$dev"
	priv ip link set "$dev" up
	priv sysctl -qw net.ipv4.ip_forward=1

	# Docker sets the FORWARD policy to DROP, so the masquerade rule alone is
	# not enough: the traffic has to be allowed through the filter table too.
	priv iptables -t nat -C POSTROUTING -s "172.16.$slot.0/30" ! -o "$dev" \
		-j MASQUERADE 2>/dev/null ||
		priv iptables -t nat -A POSTROUTING -s "172.16.$slot.0/30" ! -o "$dev" -j MASQUERADE
	priv iptables -C FORWARD -i "$dev" -j ACCEPT 2>/dev/null ||
		priv iptables -I FORWARD 1 -i "$dev" -j ACCEPT
	priv iptables -C FORWARD -o "$dev" -j ACCEPT 2>/dev/null ||
		priv iptables -I FORWARD 1 -o "$dev" -j ACCEPT
}

net_up() {
	alloc_net_slot || die "no free network slot (250 VMs already running?)"
	TAP_DEV="fccode$NET_SLOT"

	if ip link show "$TAP_DEV" >/dev/null 2>&1; then
		# Left in place by net-setup. Nothing here needs root.
		NET_ADOPTED=1
		log "network: $TAP_DEV (already set up), guest 172.16.$NET_SLOT.2"
		return 0
	fi

	log "network: $TAP_DEV, guest 172.16.$NET_SLOT.2 via 172.16.$NET_SLOT.1"
	net_create_tap "$TAP_DEV" "$NET_SLOT"
}

net_down() {
	[[ -n $TAP_DEV ]] || return 0
	if ((NET_ADOPTED == 0)); then
		priv iptables -t nat -D POSTROUTING -s "172.16.$NET_SLOT.0/30" \
			! -o "$TAP_DEV" -j MASQUERADE 2>/dev/null || true
		priv iptables -D FORWARD -i "$TAP_DEV" -j ACCEPT 2>/dev/null || true
		priv iptables -D FORWARD -o "$TAP_DEV" -j ACCEPT 2>/dev/null || true
		priv ip link del "$TAP_DEV" 2>/dev/null || true
	fi
	TAP_DEV=""
	if [[ -n $NET_FD ]]; then exec {NET_FD}>&- 2>/dev/null || true; fi
	NET_FD=""
}

# Pre-create taps so ordinary runs need no privileges for networking. One
# sudo now instead of one per run.
cmd_net_setup() {
	local count=4 s dev
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--count)
			count="$2"
			shift 2
			;;
		--teardown)
			# Both names: these were fcllmN before the rename, and a stale one
			# still holds its address and its NAT rules.
			for dev in $(for ((s = 1; s <= 250; s++)); do echo "fccode$s fcllm$s"; done); do
				s=${dev//[!0-9]/}
				ip link show "$dev" >/dev/null 2>&1 || continue
				priv iptables -t nat -D POSTROUTING -s "172.16.$s.0/30" \
					! -o "$dev" -j MASQUERADE 2>/dev/null || true
				priv iptables -D FORWARD -i "$dev" -j ACCEPT 2>/dev/null || true
				priv iptables -D FORWARD -o "$dev" -j ACCEPT 2>/dev/null || true
				priv ip link del "$dev" 2>/dev/null || true
				log "removed $dev"
			done
			return 0
			;;
		*) die "usage: firecode net-setup [--count N] [--teardown]" ;;
		esac
	done

	for ((s = 1; s <= count; s++)); do
		dev="fccode$s"
		if ip link show "$dev" >/dev/null 2>&1; then
			log "$dev already there"
			continue
		fi
		net_create_tap "$dev" "$s"
		log "$dev up, for a guest on 172.16.$s.2"
	done
	echo
	echo "  $count VMs can now have a network without any further privileges."
	echo "  Undo with: firecode net-setup --teardown"
}

# ---------------------------------------------------------------- MCP relay

RELAY_PIDS=()

# Firecracker turns a guest connection to CID 2 port N into a connection to
# the unix socket <uds_path>_N on the host. Listening there and forwarding to
# 127.0.0.1:N is what makes the guest's localhost:N the host's localhost:N.
# The host MCP servers see an ordinary local connection and need no changes.
relays_up() {
	local jail_dir=$1 ports=$2 p
	[[ -n $ports ]] || return 0
	if ! command -v socat >/dev/null 2>&1; then
		log "WARNING: socat not installed on the host, MCP will not be reachable"
		return 0
	fi
	for p in $ports; do
		# Bound from inside the jail directory on purpose. A unix socket path
		# is capped at 108 bytes, and the absolute path to a run's jail is
		# already longer than that for any normally placed checkout.
		(
			cg_join "$CG_DIR/relays"
			cd "$jail_dir" && exec socat \
				"UNIX-LISTEN:firecracker-vsock.sock_$p,fork,unlink-early" \
				"TCP:127.0.0.1:$p"
		) >>"$RUN_DIR/relays.log" 2>&1 &
		RELAY_PIDS+=($!)
	done
	# Give socat time to create the sockets: firecracker resets the guest's
	# connection if the matching one is not there yet.
	local waited=0
	while ((waited < 30)); do
		local missing=0
		for p in $ports; do
			[[ -S $jail_dir/firecracker-vsock.sock_$p ]] || missing=1
		done
		((missing)) || break
		sleep 0.1
		waited=$((waited + 1))
	done
	log "host reachable from the guest on ports: $ports"
}

relays_down() {
	local pid
	for pid in ${RELAY_PIDS+"${RELAY_PIDS[@]}"}; do
		kill "$pid" 2>/dev/null || true
	done
	RELAY_PIDS=()
	# The auth relay holds this machine's credentials and answers on a port.
	# Leaving it behind is both a process nobody owns and a port the next run
	# may draw and mistake for its own.
	if [[ -n ${AUTH_RELAY_PID:-} ]]; then
		kill "$AUTH_RELAY_PID" 2>/dev/null || true
		AUTH_RELAY_PID=""
	fi
}

# ---------------------------------------------------------------- arguments

# Turn a natural command line into one that actually runs unattended. An
# agent sitting at an interactive prompt with no tty just hangs until the
# timeout, which is the least useful possible outcome for autopilot.
massage_args() {
	local agent=$1
	shift
	local -a in=("$@") out=()
	local a has_print=0 has_perm=0 subcmd=0

	for a in ${in+"${in[@]}"}; do
		case "$a" in
		-p | --print) has_print=1 ;;
		--dangerously-skip-permissions | --permission-mode | --allowedTools | \
			--allowed-tools) has_perm=1 ;;
		esac
	done

	if [[ $agent == claude ]]; then
		((has_print)) || out+=(-p)
		# The whole point of the VM is that the agent does not need to ask.
		((has_perm)) || out+=(--dangerously-skip-permissions)

		# Compact against the window the model actually has.
		#
		# --autocompact defaults to "auto", sized from the model the client
		# believes it is talking to. Pointed at a local server that is not
		# that model, the belief is wrong in the dangerous direction: it keeps
		# appending until the server rejects the request outright, and a run
		# ends at "request (262310 tokens) exceeds the context" with hours of
		# work and no compaction ever attempted. That is how the second qwen
		# experiment here died, four minutes from finishing.
		#
		# llama.cpp says its real size on /props, so ask rather than guess,
		# and leave a fifth of it as headroom for the reply.
		if [[ -n $API_BASE && " ${in[*]} " != *" --autocompact "* ]]; then
			local n_ctx window
			# Asked of the server, or told to us. A proxy in front of the model
			# usually does not carry /props through, and there is no other way
			# to find out - so FIRECODE_MODEL_CTX is how you say what the thing
			# behind it can hold.
			n_ctx=${FIRECODE_MODEL_CTX:-$(curl -s -m 3 "${API_BASE%/}/props" 2>/dev/null |
				python3 -c 'import json,sys
d = json.load(sys.stdin)
g = d.get("default_generation_settings") or {}
print(g.get("n_ctx") or d.get("n_ctx") or "")' 2>/dev/null || true)}
			if [[ $n_ctx =~ ^[0-9]+$ ]] && ((n_ctx >= 125000)); then
				window=$((n_ctx * 4 / 5))
				((window > 1000000)) && window=1000000
				out+=(--autocompact "$window")
				log "local model context $n_ctx - compacting at $window"
			elif [[ $n_ctx =~ ^[0-9]+$ ]]; then
				# --autocompact will not go below 100k, so a smaller server
				# cannot be accommodated - say so rather than let the run find
				# out hours in.
				log "warning: this model's context is $n_ctx, below the 100k floor for"
				log "         auto-compaction - a long run will end on a 400 from the server"
			else
				# Said out loud, because the silent version of this is a run
				# that dies of a full context four hours in.
				log "warning: $API_BASE did not say how much context it has, so the agent"
				log "         will compact against its own model's window, which is not this"
				log "         one. Set FIRECODE_MODEL_CTX=<tokens> to size it properly."
			fi
		fi
	elif [[ $agent == opencode ]]; then
		case "${in[0]:-}" in
		run | serve | models | auth | providers | agent | session | stats | \
			export | import | github | pr | mcp | debug | upgrade | plugin | \
			db | web | attach | acp | completion | uninstall) subcmd=1 ;;
		esac
		((subcmd)) || out+=(run)
	fi

	printf '%s\0' ${out+"${out[@]}"} ${in+"${in[@]}"}
}

# Is there an actual task in here, as opposed to only flags?
#
# This is what decides unattended versus interactive. Arguments alone are not
# the test: `--resume <id>` is a flag and a session id, not something to do,
# and treating it as a task produced `claude -p --resume <id>` with nothing to
# respond to - which fails on its first line.
has_prompt() {
	local -a in=("$@")
	local i skip=0

	for ((i = 0; i < ${#in[@]}; i++)); do
		local a=${in[i]}
		if ((skip)); then
			skip=0
			continue
		fi
		case "$a" in
		# Flags whose value would otherwise look like a task.
		-r | --resume | --model | --agent | --settings | --permission-mode | \
			--append-system-prompt | --system-prompt | --autocompact | \
			--output-format | --input-format | --session-id | --fallback-model)
			skip=1
			;;
		-*) ;;
		*) return 0 ;;
		esac
	done
	return 1
}

# ---------------------------------------------------------------- launch

RUN_DIR=""
RUN_ID=""
JAIL_DIR=""
STTY_SAVED=""
VM_PID=""

# Ask every VM this run started to shut down, then wait a little for them to
# do it. Shutting down cleanly is what unmounts a guest's project drive and
# lets its work be copied back out, so it is worth a few seconds even when the
# cgroup could end all of them instantly.
stop_children() {
	local me=$1 r sock waited=0
	for r in "$RUNS"/*/; do
		[[ -f $r/parent && -f $r/jail ]] || continue
		[[ $(cat "$r/parent" 2>/dev/null) == "$me" ]] || continue
		sock="$(cat "$r/jail")/firecracker-vsock.sock"
		[[ -S $sock ]] || continue
		log "stopping the VM this run started ($(basename "${r%/}"))"
		python3 "$SCRIPTS/vsock-exec.py" "$sock" "$EXEC_PORT" - \
			"sudo systemctl --no-block reboot" >/dev/null 2>&1 || true
	done
	# populated is recursive, so this waits on the whole descendant tree at
	# once - grandchildren included, without having to walk it.
	[[ -n $CG_DIR ]] || return 0
	while cg_alive "$CG_DIR/children" && ((waited < 100)); do
		sleep 0.1
		waited=$((waited + 1))
	done
	return 0
}

cleanup_run() {
	local status=$?
	trap - EXIT INT TERM PIPE HUP
	# The VM is a child, and a child outlives a parent that was killed. A
	# closed pipe is enough to do that - which is how a stray VM per run got
	# left behind by anything reading our output with head.
	# Both of these routinely fail - the VM has usually exited already, and
	# there may be no terminal to restore. Under set -e an unguarded failure
	# here exits the shell on the spot, before the status below is returned,
	# so a session that went perfectly reports 1.
	# VMs started on this one's behalf get asked to stop first: a child that
	# is killed outright loses whatever it had not written back, and being a
	# sub-VM is not a reason to lose work. The cgroup below is the backstop
	# for whatever ignores the request.
	if [[ -n $RUN_ID ]]; then stop_children "$RUN_ID" || true; fi
	if [[ -n $VM_PID ]]; then kill "$VM_PID" 2>/dev/null || true; fi
	# A libvirt domain is not a child of this process, so nothing above
	# reaches it.
	if [[ -n $RUN_DIR && -f $RUN_DIR/domain ]]; then
		libvirt_down "$(cat "$RUN_DIR/domain")" "$(cat "$RUN_DIR/libvirt-uri" 2>/dev/null)" || true
	fi
	# And everything this run owns, including any VM started on its behalf.
	# Killing the pid above only ever reached the VMM this process started;
	# a child VM belongs to a different firecode and would have survived.
	if [[ -n $CG_DIR ]]; then cg_kill "$CG_DIR" || true; fi
	if [[ -n $STTY_SAVED ]]; then stty "$STTY_SAVED" 2>/dev/null || true; fi
	relays_down
	net_down
	if [[ $KEEP -eq 0 ]]; then
		# rm can fail here - the jailer makes device nodes as root - and in
		# "test && command" it is the command's failure that set -e acts on,
		# so an unguarded one ends the run early and skips what follows.
		[[ -n $RUN_DIR ]] && rm -f "$RUN_DIR"/*.ext4 2>/dev/null
		if [[ -n $JAIL_DIR ]]; then rm -rf "$(dirname "$JAIL_DIR")" 2>/dev/null || true; fi
	fi
	return $status
}

launch() {
	AGENT=$1
	shift

	local -a agent_args=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--workdir | --project)
			WORKDIR="$2"
			shift 2
			;;
		--mem)
			MEM="$2"
			shift 2
			;;
		--fast)
			FAST=1
			shift
			;;
		--layer-size)
			# What a VM can write before it runs out. The default suits
			# installing toolchains; profiling does not - a perf capture of a
			# busy process runs to hundreds of megabytes a minute, and a full
			# layer stops the VM doing anything rather than just the capture.
			# Only used when the layer is first created, so pass it with
			# --fresh-root to resize an existing one.
			FIRECODE_LAYER_SIZE=$(numfmt --from=iec "$2" 2>/dev/null || echo "$2")
			export FIRECODE_LAYER_SIZE
			shift 2
			;;
		--kernel)
			# "debug" for the traceable one, or a path to any vmlinux.
			WANT_KERNEL="$2"
			shift 2
			;;
		--api-base)
			# Point the agent at a different endpoint that speaks the same
			# API - a local model behind a shim, a gateway, a proxy. The
			# relay does this for the real API; this is for everything else,
			# and is what makes running the same task against another model a
			# one-word change rather than a different harness.
			API_BASE="$2"
			shift 2
			;;
		--auth-relay)
			# The guest reaches the model API through this host, holding no
			# credentials of its own. Refresh stays where it belongs - with the
			# one client that owns the session - so a long run cannot expire
			# and cannot rotate your desktop's login out from under it.
			AUTH_RELAY=1
			shift
			;;
		--verify)
			# What must pass for the work to count, checked by the harness
			# rather than reported by the agent.
			#
			# An agent saying "success" is a claim about a process that is
			# about to stop, made by the only party who could have checked it
			# and did not. Both runs that lied tonight lied in that gap. So
			# this runs after the agent exits, in the project as it will be
			# handed over, and its result is what firecode reports.
			VERIFY="$2"
			shift 2
			;;
		--verify-timeout)
			VERIFY_TIMEOUT="$2"
			shift 2
			;;
		--deliver)
			# Where the work should end up when the run finishes. Without
			# this a result lands in a timestamped directory beside the
			# project, which is right when you are watching and useless when
			# something else is waiting for it to appear somewhere specific.
			DELIVER=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")
			shift 2
			;;
		--vectorized)
			# For work whose whole point is how fast it runs. Pins the VM to
			# performance cores, sizes it to them, and says up front which of
			# the measurements this machine can actually support - because a
			# benchmark that silently lost its counters still prints numbers.
			VECTORIZED=1
			shift
			;;
		--vmm)
			VMM="$2"
			[[ $VMM == firecracker || $VMM == libvirt ]] ||
				die "--vmm takes firecracker or libvirt"
			shift 2
			;;
		--gpu)
			# A PCI address, or "auto" for the discrete card. Implies libvirt:
			# firecracker has no PCI bus to put it on.
			GPU_PCI="$2"
			[[ $GPU_PCI == auto ]] && GPU_PCI=$(gpu_auto)
			[[ -n $GPU_PCI ]] || die "--gpu auto found no discrete GPU"
			VMM=libvirt
			shift 2
			;;
		--refresh)
			FAST=1
			REFRESH=1
			shift
			;;
		--parent-run)
			# Which run asked for this VM. Only lifetime depends on it, never
			# access, so a guest naming the wrong parent can shorten its own
			# VM's life and nothing else.
			PARENT_RUN="$2"
			shift 2
			;;
		--vcpu | --cpus)
			VCPU="$2"
			shift 2
			;;
		--timeout)
			TIMEOUT="$2"
			shift 2
			;;
		--no-net)
			NONET=1
			shift
			;;
		--no-jail)
			NOJAIL=1
			shift
			;;
		--no-sync)
			SYNC_BACK=0
			shift
			;;
		--keep)
			KEEP=1
			shift
			;;
		--cgroups)
			CGROUPS=1
			shift
			;;
		--debug-boot)
			QUIET_BOOT=0
			shift
			;;
		--no-auto-flags)
			AUTO_FLAGS=0
			shift
			;;
		--disk)
			# A 5TB dataset is not copied anywhere. It is attached, and the
			# guest sees the same blocks the host does.
			DISKS+=("$2")
			shift 2
			;;
		--add-dir)
			EXTRA_DIRS+=("$2")
			shift 2
			;;
		--host-port)
			HOST_PORTS+=("$2")
			shift 2
			;;
		--exclude)
			EXCLUDES+=("$2")
			shift 2
			;;
		--all-files)
			USE_GITIGNORE=0
			shift
			;;
		--dry-run)
			DRY_RUN=1
			shift
			;;
		--no-tmux)
			NO_TMUX=1
			shift
			;;
		--fresh-root)
			FRESH_ROOT=1
			shift
			;;
		--no-mcp)
			NO_MCP=1
			shift
			;;
		--import-sessions)
			IMPORT_SESSIONS=1
			shift
			;;
		--no-import-sessions)
			IMPORT_SESSIONS=0
			shift
			;;
		--worktree)
			WORKTREE="$2"
			shift 2
			;;
		--fresh)
			RESUME_TREE=0
			shift
			;;
		--resume-tree)
			RESUME_TREE=1
			shift
			;;
		--)
			shift
			# With `firecode exec ... -- cmd args`, the command itself is the
			# first thing after the separator.
			if [[ -z $AGENT && $# -gt 0 ]]; then
				AGENT="$1"
				shift
			fi
			agent_args+=("$@")
			break
			;;
		*)
			# `firecode exec` passes an empty agent so that the first thing
			# that is not a firecode option becomes the command to run.
			if [[ -z $AGENT ]]; then
				AGENT="$1"
			else
				agent_args+=("$1")
			fi
			shift
			;;
		esac
	done
	[[ -n $AGENT ]] || die "no command given"

	resolve_assets
	WORKDIR=$(cd "$WORKDIR" && pwd) || die "workdir does not exist"

	# Run in a git worktree of this repository, making it if it is not there.
	# Each worktree gets its own layer and inherits the main checkout's, so
	# several can be worked on at once without sharing a toolchain or a tree.
	if [[ -n $WORKTREE ]]; then
		local repo
		repo=$(git -C "$WORKDIR" rev-parse --show-toplevel 2>/dev/null) ||
			die "--worktree needs a git repository"
		repo=$(main_checkout "$repo")
		local wt="${repo}-${WORKTREE//[^A-Za-z0-9._-]/-}"
		if [[ -d $wt ]]; then
			log "worktree $WORKTREE is at $wt"
		elif git -C "$repo" show-ref --verify --quiet "refs/heads/$WORKTREE"; then
			git -C "$repo" worktree add "$wt" "$WORKTREE" >/dev/null ||
				die "could not add a worktree for the existing branch $WORKTREE"
			log "worktree $WORKTREE checked out at $wt"
		else
			git -C "$repo" worktree add -b "$WORKTREE" "$wt" >/dev/null ||
				die "could not create the worktree $WORKTREE"
			log "new branch $WORKTREE, worktree at $wt"
		fi
		WORKDIR=$wt
	fi
	# The project directory is a way into the guest just as much as --add-dir
	# is. Matters most if launching is ever exposed to something automated.
	refuse_if_sensitive "$WORKDIR"

	# A task means unattended. Flags on their own - `--resume <id>`, a model
	# choice - mean you want the session, and you are the one driving it, so
	# you get a console with those flags passed straight through.
	local mode=auto
	if [[ $AGENT == shell ]]; then
		mode=interactive
	elif [[ $AGENT == claude || $AGENT == opencode ]]; then
		has_prompt ${agent_args+"${agent_args[@]}"} || mode=interactive
	elif ((${#agent_args[@]} == 0)); then
		mode=interactive
	fi

	# An unattended agent with no route to a model is a VM that boots, sits
	# there, and tells you nothing. --no-net removes the internet, which is a
	# perfectly good thing to want, but the agent still has to reach a model
	# from somewhere - the relay and --api-base both arrive over vsock and so
	# survive --no-net. Without one of them there is nothing to wait for, and
	# waiting is exactly what it looks like from outside.
	if ((NONET)) && [[ $mode == auto ]] && [[ $AGENT == claude || $AGENT == opencode ]] &&
		((AUTH_RELAY == 0)) && [[ -z $API_BASE ]]; then
		die "--no-net leaves this agent with no way to reach a model, so the run
       would boot and hang with nothing to show for it.
       Add --auth-relay (the model API through this host, no credentials in
       the VM), or --api-base URL for a local one, or drop --no-net."
	fi

	# Continuing a conversation but starting from the pristine host tree would
	# be nonsense: the agent would be told it already made changes that are
	# not there. So --continue/--resume carries the working tree forward too.
	if [[ $RESUME_TREE == auto ]]; then
		RESUME_TREE=0
		# Only for the agents whose -c and -r actually mean continue and
		# resume. Guessing from any command's flags is wrong: `bash -c` is
		# not a request to carry the last run's working tree forward.
		if [[ $AGENT == claude || $AGENT == opencode ]]; then
			local a
			for a in ${agent_args+"${agent_args[@]}"}; do
				case "$a" in
				-c | --continue | -r | --resume) RESUME_TREE=1 ;;
				esac
			done
		fi
	fi

	# An interactive session belongs in a multiplexer. It gives three things
	# worth having: one session per project rather than two VMs racing for it,
	# a name you can find it by, and the ability to detach - close the laptop,
	# reattach over ssh, the VM never notices.
	#
	# byobu if it is there, since it is tmux underneath and keeps its status
	# line; plain tmux otherwise. Already inside one, or asked not to, and this
	# does nothing.
	if [[ $mode == interactive ]] && ((NO_TMUX == 0)) &&
		[[ -z ${TMUX:-} && -z ${FIRECODE_IN_MUX:-} && -t 0 ]]; then
		local mux=""
		command -v byobu >/dev/null 2>&1 && mux=byobu
		[[ -z $mux ]] && command -v tmux >/dev/null 2>&1 && mux=tmux
		if [[ -n $mux ]]; then
			local sess
			sess=$(session_name "$(basename "$WORKDIR")")
			log "session $sess - detach with ctrl-a d, come back with: firecode attach"
			# -A attaches to the session if it exists rather than starting a
			# second one, which is what makes this a singleton per project.
			exec env FIRECODE_IN_MUX=1 "$mux" new-session -A -s "$sess" -- \
				"$SELF" ${FIRECODE_ARGV+"${FIRECODE_ARGV[@]}"}
		fi
	fi

	local id
	# BASHPID, not $$: in a subshell $$ is still the parent's pid, so two runs
	# launched together from one shell would collide on the same run id.
	id="firecode-$(date +%Y%m%d-%H%M%S)-$BASHPID"
	RUN_DIR="$RUNS/$id"
	RUN_ID="$id"
	JAIL_DIR="$JAIL_BASE/firecracker/$id/root"
	mkdir -p "$RUN_DIR" "$JAIL_DIR"
	# Which project this VM is for, so several can run and still be told
	# apart by something other than "the only one".
	# A name a person can say. The run id is a timestamp and a pid, which
	# identifies a run and describes nothing - and every command that takes a
	# VM then wants a path or a 40-character id. Named after the project,
	# because that is what anyone calls it.
	local vm_name base n=1
	base=$(basename "$WORKDIR" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//')
	vm_name=${base:-vm}
	while live_runs 2>/dev/null | cut -f4 | grep -qx "$vm_name"; do
		n=$((n + 1))
		vm_name="$base-$n"
	done
	printf '%s\n' "$vm_name" >"$RUN_DIR/name"

	printf '%s\n' "$WORKDIR" >"$RUN_DIR/project"
	printf '%s\n' "$JAIL_DIR" >"$RUN_DIR/jail"
	# How to reach this VM's channels, whichever backend started it.
	if [[ $VMM == libvirt ]]; then
		printf 'cid:%s\n' "$((3 + ${NET_SLOT:-0}))" >"$RUN_DIR/vsock"
	else
		printf '%s\n' "$JAIL_DIR/firecracker-vsock.sock" >"$RUN_DIR/vsock"
	fi

	# The cgroup this run owns. Nested inside the parent's when this VM was
	# asked for by another one, which is what makes the parent's teardown
	# reach it. A parent that named itself and is already gone leaves the run
	# at the top level rather than failing it - the VM is still wanted, it
	# just has nothing to outlive.
	local parent_cg=""
	if [[ -n $PARENT_RUN && -f $RUNS/$PARENT_RUN/cgroup ]]; then
		parent_cg=$(cat "$RUNS/$PARENT_RUN/cgroup")
		printf '%s\n' "$PARENT_RUN" >"$RUN_DIR/parent"
	fi
	if CG_DIR=$(cg_make "$id" "$parent_cg"); then
		printf '%s\n' "$CG_DIR" >"$RUN_DIR/cgroup"
		[[ -n $parent_cg ]] && log "this VM belongs to run $PARENT_RUN and stops when it does"
	else
		CG_DIR=""
		log "WARNING: no usable cgroup, so this VM is only tied to this process"
	fi
	trap cleanup_run EXIT INT TERM PIPE HUP

	log "run $id  agent=$AGENT  mode=$mode  project=$WORKDIR"

	# Which provider is being stood in for, decided before anything is staged.
	#
	# This used to be read off the agent's name - opencode meant xai - which
	# is wrong as soon as opencode is pointed at any of the other providers it
	# speaks. The run then got a relay for a provider it was not using and had
	# the credentials for the one it was using withheld, so it had neither.
	# The model argument says which one it is, so ask that.
	if ((AUTH_RELAY)); then
		if [[ $AGENT == claude ]]; then
			RELAY_PROVIDER=claude
		else
			local prev=""
			for a in ${agent_args+"${agent_args[@]}"}; do
				if [[ $prev == -m || $prev == --model ]]; then
					RELAY_PROVIDER=${a%%/*}
					break
				fi
				prev=$a
			done
			# No model said, so the provider is whatever opencode picks -
			# unknowable here. xai is the one this harness has a relay for,
			# and naming it is better than silently relaying nothing.
			[[ -n $RELAY_PROVIDER ]] || RELAY_PROVIDER=xai
		fi
		if [[ " $RELAY_KNOWS " != *" $RELAY_PROVIDER "* ]]; then
			log "no relay for $RELAY_PROVIDER - its credentials go into the VM as they are"
			log "  (the relay speaks $RELAY_KNOWS; an api key does not rotate, an oauth login does)"
			AUTH_RELAY=0
		fi
	fi

	if ((DRY_RUN)); then
		log "dry run: nothing built, nothing booted"
		return 0
	fi

	build_config_drive

	# Everything the guest should be able to reach on the host's loopback:
	# MCP servers found in the config, plus whatever --host-port asked for
	# (a local llama-server or any other OpenAI-compatible endpoint).
	local relay_ports
	local -a mcp=()
	((NO_MCP)) || read -r -a mcp <<<"$(discover_mcp_ports)"

	# Ports you always want reachable - a local model server, say - without
	# having to remember --host-port every time. One per line, # for comments.
	if [[ -f $PORTS_FILE ]]; then
		local line
		while IFS= read -r line; do
			line=${line%%#*}
			line=${line//[[:space:]]/}
			[[ $line =~ ^[0-9]+$ ]] && HOST_PORTS+=("$line")
		done <"$PORTS_FILE"
	fi
	# The room, when there is one.
	#
	# An agent in a VM is the participant with the most to say and the least
	# ability to say it - it is the one doing the work. Spawned runs were
	# given this port and runs started from the command line were not, which
	# meant whether an agent could report being stuck depended on how somebody
	# else had launched it. If nothing is listening, this costs one relay that
	# never connects.
	local chat_port=${FIRECODE_CHAT_PORT:-9761}
	if ss -ltn 2>/dev/null | grep -q ":$chat_port "; then
		HOST_PORTS+=("$chat_port")
	fi

	# The `|| true` is load-bearing: with nothing to forward, grep matches
	# The relay, if asked for: a port on this host that guests reach through
	# the same vsock relay as any other, and an ANTHROPIC_BASE_URL pointing at
	# it. Started here rather than by hand because it has to outlive nothing
	# and be gone with the run.
	if ((AUTH_RELAY)); then
		# Which credentials are being kept out of the VM depends on which agent
		# is going to ask for them.
		# Decided from the model asked for, before the config drive was built.
		local relay_provider=${RELAY_PROVIDER:-claude}

		# A free port, never one that is already answering.
		#
		# This used to take a random port and reuse whatever was listening on
		# it, which is only safe if every relay relays the same thing. Since
		# they do not, a claude run could inherit an opencode run's relay and
		# have its requests authenticated against xAI - which answers "Model
		# not found: claude-opus-5" and looks like an outage rather than a
		# mix-up.
		if [[ -z $AUTH_RELAY_PORT ]]; then
			local try=0
			while ((try < 50)); do
				AUTH_RELAY_PORT=$((9800 + RANDOM % 100))
				ss -ltn 2>/dev/null | grep -q ":$AUTH_RELAY_PORT " || break
				AUTH_RELAY_PORT=""
				try=$((try + 1))
			done
			[[ -n $AUTH_RELAY_PORT ]] || die "no free relay port in 9800-9899"
		fi
		setsid python3 "$SCRIPTS/auth-relay.py" --port "$AUTH_RELAY_PORT" \
			--provider "$relay_provider" \
			>"$RUN_DIR/auth-relay.log" 2>&1 &
		AUTH_RELAY_PID=$!
		disown 2>/dev/null || true
		local waited=0
		while ((waited < 40)) && ! ss -ltn 2>/dev/null | grep -q ":$AUTH_RELAY_PORT "; do
			sleep 0.1
			waited=$((waited + 1))
		done
		# Its pid on disk as well as in a variable: the relay outlives the
		# shell that started it, and something has to be able to end it after
		# a run that died without cleaning up.
		echo "$AUTH_RELAY_PID" >"$RUN_DIR/auth-relay.pid"
		HOST_PORTS+=("$AUTH_RELAY_PORT")
		log "authenticating through this host on port $AUTH_RELAY_PORT ($relay_provider) - the VM gets no token"
	fi

	# nothing and exits 1, which under `set -e` takes the whole run down.
	relay_ports=$(printf '%s\n' ${mcp+"${mcp[@]}"} ${HOST_PORTS+"${HOST_PORTS[@]}"} |
		grep -E '^[0-9]+$' | sort -un | tr '\n' ' ' || true)
	relay_ports=${relay_ports% }

	# --- per-project agent state, so --continue and --resume have something
	#     to continue from. Taken first: it decides where the src drive lives.
	ensure_state_drive "$WORKDIR" "$RUN_DIR"
	local state_drive=$STATE_DRIVE

	# Whether this is a restore has to be settled here, before the drives get
	# built: a restore uses none of them, and building them costs more than
	# the restore does. Everything the stamp needs is cheap to get - the base
	# images by identity, the project by content.
	# Computed for every run, not just fast ones: any running VM can be told
	# to checkpoint itself, and it needs to stamp the result the same way a
	# later fast start will look it up.
	local memdir memstamp restoring=0
	local early_main early_layer=""
	early_main=$(main_checkout "$WORKDIR")
	[[ -n $early_main && $early_main != "$WORKDIR" ]] &&
		early_layer="$STATE_DIR/$(project_slug "$early_main")-layer.ext4"
	memdir=$(memcheck_dir "$SLUG")
	# No CFG_DRIVE here: the checkpoint pins its own copy of that drive, so a
	# rebuilt one no longer means a stale checkpoint. What remains is the
	# substrate the guest's memory actually describes - kernel, base image,
	# the layers under it - plus the agent binary, handled inside.
	memstamp=$(memcheck_stamp "$WORKDIR" "$KERNEL" "$INITRD" "$ROOTFS" \
		"$(layers_of_project "$SLUG")" ${early_layer:+"$early_layer"})
	((REFRESH)) && rm -rf "$memdir"
	((FAST)) && memcheck_valid "$memdir" "$memstamp" && restoring=1
	# Why it is booting rather than restoring, at the moment it happens. This
	# was silent, and a silent fallback is indistinguishable from a slow
	# restore - which is how a checkpoint that had not restored for weeks went
	# unnoticed while being overwritten each time.
	if ((FAST)) && ((restoring == 0)) && [[ -d $memdir ]]; then
		log "the checkpoint does not match this configuration, so this is a normal boot"
		log "  (it was taken for a different config drive, project or base image)"
	fi

	# Continuing a conversation that only exists on the host means bringing
	# the transcript in. Done once per project unless asked for again.
	local imported_marker="$STATE_DIR/$SLUG.imported"
	if [[ $IMPORT_SESSIONS == 1 ]] ||
		{ [[ $IMPORT_SESSIONS == auto ]] && ((RESUME_TREE)) && [[ ! -f $imported_marker ]]; }; then
		import_host_sessions "$WORKDIR" "$state_drive"
		touch "$imported_marker"
	fi

	# --- src drive. Persistent per project when we hold the lock, so a
	#     continuation run resumes the tree the last run left behind.
	local src_drive src_size
	if ((STATE_PERSISTENT)); then
		src_drive="$STATE_DIR/$SLUG-src.ext4"
	else
		src_drive="$RUN_DIR/src.ext4"
	fi

	if ((restoring)); then
		# The checkpoint carries its own copy of the project, which is the
		# one the restored guest's memory describes. Packing a new drive here
		# would be both wasted and wrong.
		:
	elif ((RESUME_TREE)) && [[ -f $src_drive ]]; then
		log "resuming the working tree from the previous run"
	else
		((RESUME_TREE)) && log "no previous tree for this project, starting from $WORKDIR"
		local src_stage="$RUN_DIR/src"
		stage_project "$WORKDIR" "$src_stage"
		src_size=$(size_for_dir "$src_stage" $((4 * 1024 * 1024 * 1024)))
		log "packing $WORKDIR into a $((src_size / 1024 / 1024 / 1024))G drive"
		mkimage_from_dir "$src_stage" "$src_drive" firecode-src "$src_size"
		rm -rf "$src_stage"
	fi

	# --- extra read-only context: sibling projects, notes, whatever. These
	#     are copies, so the guest can read them and nothing goes back.
	local -a extra_drives=() extra_spec=()
	local n=0 d
	for d in ${EXTRA_DIRS+"${EXTRA_DIRS[@]}"}; do
		d=$(cd "$d" 2>/dev/null && pwd) || die "--add-dir: no such directory: $d"
		refuse_if_sensitive "$d"
		n=$((n + 1))
		# Label derived from the path, not from the order it was given in, so
		# a cached image is never relabelled out from under a running VM.
		local label img
		label="fl-$(printf '%s' "$d" | sha256sum | cut -c1-8)"
		img=$(cached_ro_image "$d" "$label" "$n")
		log "adding $d read-only at $d"
		extra_drives+=("$img")
		# Mounted where it lives on the host, not under /mnt, so references
		# to it from anywhere still resolve.
		extra_spec+=("$label:$d")
	done

	# --- control drive: this run's parameters, read-only in the guest
	local ctl_stage="$RUN_DIR/ctl"
	mkdir -p "$ctl_stage"
	{
		echo "FIRECODE_ID=$id"
		echo "FIRECODE_MODE=$mode"
		[[ $AGENT != shell ]] && echo "FIRECODE_AGENT=$AGENT"
		echo "FIRECODE_TIMEOUT=$TIMEOUT"
		echo "FIRECODE_RELAY_PORTS='$relay_ports'"
		# The guest mirrors the host's layout: same user, same uid, same home,
		# same project path. An absolute path in a resumed transcript, in a
		# CLAUDE.md or in a tool call then means the same thing in both places,
		# and nothing has to be rewritten on the way in or out.
		# A serial console has no window size and no SIGWINCH, so the guest
		# would sit at the 80x24 default whatever your terminal is - which a
		# full-screen TUI renders into and then misplaces every keystroke.
		# Taken once, at launch.
		if [[ -t 0 ]]; then
			local rows cols
			read -r rows cols < <(stty size 2>/dev/null || echo "")
			[[ -n ${rows:-} && -n ${cols:-} && $rows != 0 && $cols != 0 ]] &&
				printf 'FIRECODE_ROWS=%s\nFIRECODE_COLS=%s\n' "$rows" "$cols"
		fi
		# What kind of terminal is really on the other end. The guest console
		# is handed to it directly, so it is that terminal answering capability
		# probes - but agetty labels the line vt220, and an application that
		# believes it then mis-decodes everything the real terminal sends back.
		# Enter is the one you notice: a terminal speaking the kitty keyboard
		# protocol reports it as CSI 13 u, arrows stay ordinary CSI, so the
		# arrows work and Enter appears dead.
		echo "FIRECODE_CONSOLE_PORT=$CONSOLE_PORT"
		echo "FIRECODE_FILES_PORT=$FILES_PORT"
		echo "FIRECODE_EXEC_PORT=$EXEC_PORT"
		echo "FIRECODE_TERM='${TERM:-}'"
		echo "FIRECODE_TERM_PROGRAM='${TERM_PROGRAM:-}'"
		echo "FIRECODE_COLORTERM='${COLORTERM:-}'"
		echo "FIRECODE_USER='$(id -un)'"
		echo "FIRECODE_UID=$(id -u)"
		echo "FIRECODE_GID=$(id -g)"
		echo "FIRECODE_HOME='$HOME'"
		echo "FIRECODE_PROJECT='$WORKDIR'"
		# An explicit endpoint wins over the relay: the relay authenticates
		# against the real API, and pointing it at a local model would send
		# your token somewhere it does not belong.
		if [[ -n $API_BASE ]]; then
			echo "ANTHROPIC_BASE_URL='$API_BASE'"
		elif ((AUTH_RELAY)); then
			echo "ANTHROPIC_BASE_URL='http://localhost:$AUTH_RELAY_PORT'"
		fi
		# opencode has no environment variable for a provider's endpoint - it
		# reads that from its config file - so this is the port, and the guest
		# writes the config around it at boot. It cannot come off the config
		# drive: that drive is shared between runs and keyed by content, and
		# the port is per run.
		if ((AUTH_RELAY)) && [[ $AGENT == opencode && $RELAY_PROVIDER == xai && -z $API_BASE ]]; then
			echo "FIRECODE_XAI_BASE_URL='http://localhost:$AUTH_RELAY_PORT/v1'"
		fi
		echo "FIRECODE_EXTRA='${extra_spec[*]-}'"
		# Where each --disk should be mounted, in the order they were given.
		# Not the device names: those are assigned further down, after this
		# file is already inside an image. The guest pairs them with the last
		# N virtio disks, which is exactly where these are attached.
		echo "FIRECODE_DISKS='$(disk_mounts)'"
		# Read from the project, not from wherever firecode happens to live, so
		# a repo-local identity wins the same way it would on the host.
		echo "FIRECODE_GIT_NAME='$(git -C "$WORKDIR" config --get user.name 2>/dev/null || true)'"
		echo "FIRECODE_GIT_EMAIL='$(git -C "$WORKDIR" config --get user.email 2>/dev/null || true)'"
		if [[ $NONET -eq 0 ]]; then
			echo "FIRECODE_GUEST_IP=172.16.SLOT.2/30"
			echo "FIRECODE_GATEWAY=172.16.SLOT.1"
			echo "FIRECODE_DNS='1.1.1.1 8.8.8.8'"
		fi
		if [[ -n $VERIFY ]]; then
			echo "FIRECODE_VERIFY=$(printf '%q' "$VERIFY")"
			echo "FIRECODE_VERIFY_TIMEOUT='$VERIFY_TIMEOUT'"
		fi
		# How long a finished run stays open to be spoken to. Worth raising
		# when something is supervising the run and may want to interject.
		[[ -n ${FIRECODE_INBOX_IDLE:-} ]] &&
			echo "FIRECODE_INBOX_IDLE='$FIRECODE_INBOX_IDLE'"
	} >"$ctl_stage/env"
	{
		cat "$GUEST/firecode-context.md"
		# Said here rather than left as a surprise: an agent that knows which
		# command decides the outcome can aim at it, and one that does not
		# finds out after it has stopped, which helps nobody.
		if [[ -n $VERIFY ]]; then
			cat <<-EOF

				## What will be run after you finish

				\`$VERIFY\`

				The harness runs this itself once you exit, in the project
				directory as it will be handed over, and its exit status is
				what this run reports. You are not asked to trust it or to
				remember it - run it yourself, as often as you like, and fix
				what it says. A run whose agent claimed success and whose
				verification failed is reported as a failure.
			EOF
		fi
	} >"$ctl_stage/context.md"

	# The guest scripts ride along on the control drive and take precedence
	# over the copies baked into the image, so changing the harness does not
	# mean rebuilding a 6G rootfs.
	local g
	for g in firecode-setup.sh agent-entrypoint.sh profile.sh keydump.sh \
		console.sh fileserver.sh execserver.sh chat-client.sh; do
		install -m 0755 "$GUEST/$g" "$ctl_stage/$g"
	done

	if [[ $mode == auto ]]; then
		# The presence of this file is what starts firecode-agent.service.
		if ((AUTO_FLAGS)); then
			massage_args "$AGENT" ${agent_args+"${agent_args[@]}"} >"$ctl_stage/args"
		else
			printf '%s\0' ${agent_args+"${agent_args[@]}"} >"$ctl_stage/args"
		fi
		log "agent command: $AGENT $(tr '\0' ' ' <"$ctl_stage/args")"
	elif ((${#agent_args[@]} > 0)); then
		# Interactive, but with flags to hand the agent. Under a different
		# name, or the agent service would take it as an unattended run.
		local -a iargs=(${agent_args+"${agent_args[@]}"})
		# No -p here - there is a terminal, and you are on it. Permissions
		# still get bypassed: the VM is the boundary, not the prompt.
		if ((AUTO_FLAGS)) && [[ $AGENT == claude ]]; then
			local a has_perm=0
			for a in "${iargs[@]}"; do
				case "$a" in
				--dangerously-skip-permissions | --permission-mode | \
					--allowedTools | --allowed-tools) has_perm=1 ;;
				esac
			done
			((has_perm)) || iargs=(--dangerously-skip-permissions "${iargs[@]}")
		fi
		printf '%s\0' "${iargs[@]}" >"$ctl_stage/interactive-args"
		log "interactive: $AGENT ${iargs[*]}"
	fi

	# --- networking, then patch the allocated slot into the control drive
	if [[ $NONET -eq 0 ]]; then
		net_up
		sed -i "s/172\.16\.SLOT\./172.16.$NET_SLOT./g" "$ctl_stage/env"
	fi

	local ctl_drive="$RUN_DIR/ctl.ext4"
	((restoring)) ||
		mkimage_from_dir "$ctl_stage" "$ctl_drive" firecode-ctl "$(size_ro_dir "$ctl_stage")"

	# --- the root, as layers rather than a copy.
	#
	#   base       the image prepare built, read-only, shared by every VM
	#   project    the main checkout's layer, where its toolchains live
	#   workspace  this directory's own layer, the only thing written
	#
	# A git worktree gets its own workspace layer and inherits the main
	# checkout's, read-only - the same relationship the worktree has to the
	# repository. Nothing is copied, so a run no longer starts by duplicating
	# six gigabytes.
	local -a lower_drives=()
	local workspace_layer main_layer="" main_dir
	main_dir=$(main_checkout "$WORKDIR")

	if [[ -n $main_dir && $main_dir != "$WORKDIR" ]]; then
		main_layer=$(ensure_layer "$(project_slug "$main_dir")")
		# A layer whose VM was killed rather than shut down has a dirty
		# journal, and the kernel cannot replay one on a read-only mount - it
		# refuses the mount instead. Replaying it here is cheap when clean.
		sbin e2fsck -p "$main_layer" >/dev/null 2>&1 || true
		lower_drives+=("$main_layer")
		log "inheriting the layer of $main_dir (this is a worktree of it)"
	fi
	# Imported images sit under the project's own layer and over the base, so
	# a toolchain image supplies what the base does not and the project can
	# still install on top of it.
	local imported
	imported=$(layers_of_project "$SLUG")
	if [[ -f $imported ]]; then
		local d i f
		while IFS=$'\t' read -r d i; do
			f=$(layer_file "$d")
			if [[ -f $f ]]; then
				lower_drives+=("$f")
				log "layer: $i"
			else
				log "WARNING: layer $i ($d) is missing - firecode layer add it again"
			fi
		done <"$imported"
	fi

	lower_drives+=("$ROOTFS")

	workspace_layer="$STATE_DIR/$SLUG-layer.ext4"
	if ((FRESH_ROOT)) && [[ -f $workspace_layer ]]; then
		log "discarding this workspace's layer, starting from the base image"
		rm -f "$workspace_layer"
	fi
	[[ -f $workspace_layer ]] || {
		log "new workspace layer (what gets installed here stays here)"
		ensure_layer "$SLUG" >/dev/null
	}

	# Check the one image that is both written to and kept.
	#
	# This was checked only when it was somebody else's layer being inherited
	# read-only, on the reasoning that a dirty journal cannot be replayed on a
	# read-only mount. But a read-write mount replays it happily, and a run
	# whose VM was killed rather than shut down - a timeout, a cancel, a
	# closed pipe - leaves exactly that. The replay goes through, nothing
	# complains, and the damage shows up two runs later as
	# "freeing already freed block; block bitmap corrupt" in a boot log nobody
	# reads. This layer is where installed toolchains live, so what it loses
	# is discovered much later, as a package that is mysteriously not there.
	#
	# -p only fixes what is safe to fix without asking. Exit 1 means it
	# repaired something, which is worth knowing but not worth stopping for;
	# 4 and up means it will not touch it, and booting over that is how the
	# corruption compounds.
	# One writer, or a copy.
	#
	# The state drive has been flock-guarded for this reason since the
	# beginning; the layer never was, and it is the drive an agent writes to
	# most - every package it installs. Two runs on one project mounted the
	# same ext4 read-write, which produced multiply-claimed blocks, a root
	# that remounted read-only mid-boot, and a run that died twelve seconds in
	# saying "mount point is not a directory". Nothing pointed at the cause.
	if ((STATE_PERSISTENT == 0)); then
		local shared=$workspace_layer
		workspace_layer="$RUN_DIR/layer.ext4"
		log "another run holds this workspace's layer - using a private copy"
		log "  (what this VM installs will not be kept)"
		cp --sparse=always "$shared" "$workspace_layer"
	fi

	local fsck_rc=0
	sbin e2fsck -p "$workspace_layer" >"$RUN_DIR/layer-fsck.log" 2>&1 || fsck_rc=$?
	if ((fsck_rc == 1)); then
		log "repaired the workspace layer (it was left dirty by an earlier run)"
	elif ((fsck_rc >= 4)); then
		# Refuse rather than boot onto it. A damaged layer mounts read-only,
		# so the root is read-only, so nothing that makes a VM usable works -
		# and every symptom points somewhere else.
		die "this workspace's layer is damaged and e2fsck -p will not repair it
       unattended. The VM would boot with a read-only root and fail in
       confusing ways, so this run stops here instead.
         what happened: $RUN_DIR/layer-fsck.log
         repair it:     e2fsck -y $workspace_layer
         or start over: firecode --fresh-root ...   (installed packages are lost)"
	fi

	# --- jail: everything the VM touches has to live inside the chroot
	local f
	# The read-only drives are shared with the live project either way - the
	# guest never writes to them, so there is nothing to diverge. A restore
	# brings its own copies of the rest, and building them would be wasted.
	local -a into_jail=("$KERNEL" "$INITRD" ${lower_drives+"${lower_drives[@]}"})
	((restoring)) || into_jail+=(
		"$workspace_layer" "$src_drive" "$ctl_drive"
		"$state_drive" ${extra_drives+"${extra_drives[@]}"}
	)
	for f in "${into_jail[@]}"; do
		ln "$f" "$JAIL_DIR/$(basename "$f")" 2>/dev/null ||
			cp "$f" "$JAIL_DIR/$(basename "$f")"
	done

	# The config drive, by content on a restore and by name always.
	#
	# A restored guest must see the drive its memory describes, and the
	# snapshot refers to it by the name it had when it was taken - so the
	# checkpoint's pinned copy goes in under that same name. Linking the
	# current one here instead is how a rebuilt config drive would appear
	# underneath a resumed guest, which is the corruption the stamp used to
	# prevent by throwing the checkpoint away.
	local cfg_source="$CFG_DRIVE"
	((restoring)) && [[ -f $memdir/roconfig.ext4 ]] && cfg_source="$memdir/roconfig.ext4"
	ln "$cfg_source" "$JAIL_DIR/$(basename "$CFG_DRIVE")" 2>/dev/null ||
		cp "$cfg_source" "$JAIL_DIR/$(basename "$CFG_DRIVE")"

	local extra_json="" i=0
	for f in ${extra_drives+"${extra_drives[@]}"}; do
		i=$((i + 1))
		extra_json="$extra_json,
    {\"drive_id\": \"extra$i\", \"path_on_host\": \"$(basename "$f")\", \"is_root_device\": false, \"is_read_only\": true}"
	done

	local net_ifaces="[]"
	if [[ -n $TAP_DEV ]]; then
		local mac
		mac=$(printf '06:00:ac:10:%02x:02' "$NET_SLOT")
		net_ifaces="[{\"iface_id\":\"eth0\",\"guest_mac\":\"$mac\",\"host_dev_name\":\"$TAP_DEV\"}]"
	fi

	# Drives get vda, vdb, ... in the order they appear here, and the
	# initramfs is told which of those are layers by device name.
	local -a drive_json=()
	local dev_i=0 dev_lower="" dev_upper="" NEXT_DEV=""
	# Sets NEXT_DEV rather than printing it. A command substitution runs in a
	# subshell, so an echoing version would hand out /dev/vda every time and
	# the counter would never move - which is exactly what it did.
	next_dev() {
		local letters=abcdefghijklmnopqrstuvwxyz
		NEXT_DEV="/dev/vd${letters:$dev_i:1}"
		dev_i=$((dev_i + 1))
	}
	add_drive() {
		local id=$1 path=$2 ro=$3 root=${4:-false}
		drive_json+=("{\"drive_id\": \"$id\", \"path_on_host\": \"$(basename "$path")\", \"is_root_device\": $root, \"is_read_only\": $ro}")
	}

	local li=0 f
	for f in ${lower_drives+"${lower_drives[@]}"}; do
		li=$((li + 1))
		next_dev
		if [[ -z $dev_lower ]]; then
			dev_lower=$NEXT_DEV
		else
			dev_lower="$dev_lower,$NEXT_DEV"
		fi
		add_drive "lower$li" "$f" true "$([[ $li == 1 ]] && echo true || echo false)"
	done
	next_dev
	dev_upper=$NEXT_DEV
	add_drive "upper" "$workspace_layer" false

	# The rest are found by filesystem label once udev is up, so their device
	# names do not matter - only their position in this list does.
	next_dev
	add_drive "src" "$src_drive" false
	next_dev
	# Always by its own name: the pinned copy is linked into the jail under
	# exactly this basename, so the guest sees the right bytes either way.
	add_drive "roconfig" "$CFG_DRIVE" true
	next_dev
	add_drive "control" "$ctl_drive" true
	next_dev
	add_drive "state" "$state_drive" false
	local xi=0
	for f in ${extra_drives+"${extra_drives[@]}"}; do
		xi=$((xi + 1))
		next_dev
		add_drive "extra$xi" "$f" true
	done

	# Host disks, attached whole and last, which is what lets the guest pair
	# them with mountpoints by position.
	local di=0 spec host_path disk_ro
	for spec in ${DISKS+"${DISKS[@]}"}; do
		di=$((di + 1))
		host_path=${spec%%:*}
		disk_ro=false
		[[ $spec == *:ro ]] && disk_ro=true
		[[ -e $host_path ]] || die "--disk: no such file or device: $host_path"
		if [[ -b $host_path ]] && ((NOJAIL == 0)); then
			die "--disk $host_path is a block device, which needs --no-jail:
  the jailer chroots, and a device node inside that chroot has to be made by
  root. A file image works jailed; a raw device does not, yet."
		fi
		next_dev
		if ((NOJAIL)); then
			# By absolute path: the whole point is that this lives outside
			# anything firecode manages, and a 5TB device is not going to be
			# copied into a jail directory.
			drive_json+=("{\"drive_id\": \"disk$di\", \"path_on_host\": \"$host_path\", \"is_root_device\": false, \"is_read_only\": $disk_ro}")
		else
			# Jailed, the VMM can only see inside its chroot. A hardlink costs
			# nothing and shares the same inode, so the guest reads the same
			# blocks - but it only works on the same filesystem.
			ln "$host_path" "$JAIL_DIR/$(basename "$host_path")" 2>/dev/null ||
				die "--disk $host_path is on a different filesystem from the jail,
  so it cannot be linked in. Run with --no-jail, or move the image alongside
  $JAIL_BASE."
			add_drive "disk$di" "$host_path" "$disk_ro"
		fi
		log "disk: $host_path attached as $NEXT_DEV$([[ $disk_ro == true ]] && echo " (read-only)")"
	done

	# Decided here, before the machine is described: the vcpu count below and
	# the command that launches the VMM both depend on it.
	local -a pin_cpus=()
	if ((VECTORIZED)); then
		cpu_topology
		if [[ -n $PCORES ]]; then
			read -ra pin_cpus <<<"$(cpu_list "$PCORES")"
			# More vcpus than performance cores would put some of the work on
			# an E-core, which is the thing being avoided.
			if ((VCPU > ${#pin_cpus[@]})); then
				log "sizing down to ${#pin_cpus[@]} vcpu: that is how many performance cores there are"
				VCPU=${#pin_cpus[@]}
			fi
			pin_cpus=("${pin_cpus[@]:0:VCPU}")
			log "pinned to performance cores ${pin_cpus[*]}"
		fi
		((HYBRID)) && log "hybrid cpu: P and E cores differ, so runs are comparable only within one kind"
		# What actually ruins a measurement on a workstation, measured rather
		# than assumed: a busy machine. On this one, an FMA loop's median moved
		# 12% between core types and its spread was 17% within a single core -
		# under a load average of 9. The minimum of several runs is the number
		# to keep, because interference only ever adds time.
		local load
		load=$(cut -d' ' -f1 /proc/loadavg)
		if awk -v l="$load" 'BEGIN{exit !(l > 2)}'; then
			log "host load is $load - timings will be noisy; take the minimum of several runs"
		fi
		if ((VPMU)); then
			log "hardware counters available: perf stat -e cycles,instructions"
		else
			log "no hardware counters in a VM here - KVM disables the vPMU$( ((HYBRID)) && echo " on hybrid parts")"
			log "  wall-clock and perf record -e cpu-clock work; IPC and cache misses need the host"
		fi
	fi

	# pci=off is right for firecracker, whose devices are all virtio-mmio, and
	# fatal under qemu, where every one of them is virtio-pci: the guest comes
	# up unable to see its own root disk. Same kernel, opposite argument.
	local boot_args="console=ttyS0 reboot=k panic=1"
	[[ $VMM == firecracker ]] && boot_args="$boot_args pci=off"
	boot_args="$boot_args firecode.lower=$dev_lower firecode.upper=$dev_upper"
	((QUIET_BOOT)) && boot_args="$boot_args quiet loglevel=3 systemd.show_status=false"

	local cid=$((3 + ${NET_SLOT:-0}))
	local drives_joined
	drives_joined=$(printf '%s,\n    ' "${drive_json[@]}")
	drives_joined=${drives_joined%,$'\n    '}
	cat >"$JAIL_DIR/vm-config.json" <<EOF
{
  "boot-source": {
    "kernel_image_path": "$(basename "$KERNEL")",
    "initrd_path": "$(basename "$INITRD")",
    "boot_args": "$boot_args"
  },
  "drives": [
    $drives_joined
  ],
  "machine-config": {"vcpu_count": $VCPU, "mem_size_mib": $MEM},
  "network-interfaces": $net_ifaces,
  "vsock": {"guest_cid": $cid, "uds_path": "firecracker-vsock.sock"}
}
EOF

	# Everything the guest writes to. A checkpoint keeps its own copies of
	# these, because restoring means handing the guest back the exact bytes
	# its memory still describes.
	local -a writables=()
	for f in "$workspace_layer" "$src_drive" "$ctl_drive" "$state_drive"; do
		writables+=("$(basename "$f")")
	done

	if ((restoring)); then
		# The guest's memory still describes these exact filesystems, so it
		# gets the checkpoint's copies of them rather than the live drives.
		while read -r f; do
			cp --sparse=always "$memdir/w-$f" "$JAIL_DIR/$f"
		done <"$memdir/writables"
		ln "$memdir/vmstate" "$JAIL_DIR/vmstate" 2>/dev/null ||
			cp "$memdir/vmstate" "$JAIL_DIR/vmstate"
		ln "$memdir/mem" "$JAIL_DIR/mem" 2>/dev/null ||
			cp --sparse=always "$memdir/mem" "$JAIL_DIR/mem"
	else
		# What a checkpoint of this VM would need to know. Written for every
		# run, so "save the state you are in now" works on any of them.
		printf '%s\n' "$memdir" >"$JAIL_DIR/.memcheck-dir"
		printf '%s\n' "$memstamp" >"$JAIL_DIR/.memcheck-stamp"
		printf '%s\n' "${writables[@]}" >"$JAIL_DIR/.memcheck-writables"
	fi

	relays_up "$JAIL_DIR" "$relay_ports"

	# Your host is the other end of the guest's link, so anything it serves is
	# reachable directly - no forwarding involved.
	if [[ -n $TAP_DEV ]]; then
		log "guest is 172.16.$NET_SLOT.2 - a server it starts on PORT is at"
		log "  http://172.16.$NET_SLOT.2:PORT"
	fi

	local -a jargs=(
		--id "$id"
		--exec-file "$FC"
		--uid "$(id -u)"
		--gid "$(id -g)"
		--chroot-base-dir "$JAIL_BASE"
		--new-pid-ns
	)
	if ((CGROUPS)); then
		jargs+=(
			--cgroup-version 2
			--cgroup "memory.max=$(((MEM + 512) * 1024 * 1024))"
			--cgroup "cpu.max=$((VCPU * 100000)) 100000"
			--cgroup "pids.max=4096"
		)
	fi
	# Restoring brings its own devices, drives and machine shape - they come
	# out of the snapshot, so there is no config file to give it.
	if ((restoring)); then
		jargs+=(-- --api-sock /firecracker.socket)
	else
		jargs+=(-- --api-sock /firecracker.socket --config-file /vm-config.json)
	fi

	# The other backend. Same guest, same drives, same channels - only the
	# thing that boots them differs, because firecracker has no PCI bus and
	# therefore no way to hand a GPU to a VM. Everything above this line is
	# shared, which is the whole reason a second backend is affordable.
	if [[ $VMM == libvirt ]]; then
		((${#pin_cpus[@]})) && export FIRECODE_PIN="${pin_cpus[*]}"
		libvirt_boot "$drives_joined" "$boot_args" "$cid" "$RUN_DIR/console.log"
		return $?
	fi

	# The VM boundary is Firecracker and KVM either way. The jailer adds a
	# chroot, a dropped uid and a private pid namespace around the VMM
	# process itself - defence in depth against a VMM escape, and the only
	# part that needs root. Without it you still get a real VM.
	local -a cmd=()
	# taskset rather than a config knob: firecracker has no cpu affinity
	# setting, and the vcpu threads inherit the process's.
	local -a pin_prefix=()
	((${#pin_cpus[@]})) && pin_prefix=(taskset -c "$(
		IFS=,
		echo "${pin_cpus[*]}"
	)")
	if ((NOJAIL)); then
		log "WARNING: --no-jail, the VMM runs unconfined on the host"
		if ((restoring)); then
			cmd=(${pin_prefix+"${pin_prefix[@]}"} "$FC" --api-sock firecracker.socket)
		else
			cmd=(${pin_prefix+"${pin_prefix[@]}"} "$FC" --api-sock firecracker.socket --config-file vm-config.json)
		fi
	else
		cmd=(${pin_prefix+"${pin_prefix[@]}"} ${SUDO+"${SUDO[@]}"} "$JAILER" "${jargs[@]}")
	fi

	if ((restoring)); then
		log "restoring from a checkpoint ($VCPU vcpu, ${MEM}M)"
		log "this VM is transient - it writes to its own copies, not the real drives"
	else
		log "booting ($VCPU vcpu, ${MEM}M)"
	fi
	echo >&2

	local rc=0
	if ((restoring)) && [[ $mode != interactive ]]; then
		# Loading a snapshot is an API call, which means the VMM has to be
		# running before the VM exists - so this path cannot hand the
		# terminal straight to firecracker the way a cold boot does.
		#
		# Its serial input still has to stay open. A detached run has no
		# terminal, so firecracker's console reader sees EOF immediately and
		# ends its event loop - the VM resumes in 60ms and the VMM exits
		# cleanly a moment later, which reads from outside as "restored, then
		# died for no reason". A fifo held open here gives it a stdin that
		# never ends and that nobody types into.
		local serial_in="$JAIL_DIR/serial-in"
		mkfifo "$serial_in" 2>/dev/null || true
		# Held open and never written to: the descriptor is the point.
		# shellcheck disable=SC2034  # kept open deliberately, not read
		exec {SERIAL_FD}<>"$serial_in"
		(cg_join "$CG_DIR/vm" && cd "$JAIL_DIR" && exec "${cmd[@]}") \
			<"$serial_in" >"$RUN_DIR/console.log" 2>&1 &
		local vm_pid=$!
		VM_PID=$vm_pid
		memcheck_load "$JAIL_DIR/firecracker.socket" || rc=1
		tail -n +1 -f --pid="$vm_pid" "$RUN_DIR/console.log" 2>/dev/null |
			python3 "$SCRIPTS/termfilter.py" --strict &
		wait "$vm_pid" 2>/dev/null || rc=$?
	elif [[ $mode == interactive ]]; then
		# The VM runs in the background with its serial console going to a
		# log, and the session comes back over vsock with a pty of its own.
		# Firecracker's serial input rewrites CR to LF, so a raw-mode TUI on
		# that console never sees Enter. Keeping the VM off the terminal also
		# means the jailer works here, which it does not when firecracker is
		# attached to one.
		(cg_join "$CG_DIR/vm" && cd "$JAIL_DIR" && exec "${cmd[@]}") \
			>"$RUN_DIR/console.log" 2>&1 &
		local vm_pid=$!
		VM_PID=$vm_pid
		((restoring)) && { memcheck_load "$JAIL_DIR/firecracker.socket" || rc=1; }

		echo >&2
		python3 "$SCRIPTS/vsock-console.py" \
			"$JAIL_DIR/firecracker-vsock.sock" "$CONSOLE_PORT" || rc=$?

		# The guest reboots itself when the session ends, which is what makes
		# the VMM exit. Give it a moment, then insist.
		local waited=0
		while kill -0 "$vm_pid" 2>/dev/null && ((waited < 60)); do
			sleep 0.5
			waited=$((waited + 1))
		done
		kill "$vm_pid" 2>/dev/null || true
		wait "$vm_pid" 2>/dev/null || true
	else
		# tee keeps the unfiltered record; what reaches the terminal is
		# scrubbed. An unattended run prints logs, and a log has no business
		# setting the clipboard or redefining a key.
		(cg_join "$CG_DIR/vm" && cd "$JAIL_DIR" && exec "${cmd[@]}") 2>&1 |
			tee "$RUN_DIR/console.log" |
			python3 "$SCRIPTS/termfilter.py" --strict || rc=$?
	fi

	echo >&2
	log "VM exited (status $rc)"

	if ((SYNC_BACK)) && [[ -n $WORKTREE ]]; then
		# A worktree firecode made is scratch by construction - a branch to
		# throw away - so the work goes back into it rather than beside it
		# with a timestamp. What you get afterwards is an ordinary worktree:
		# cd into it, diff it, merge it, delete it.
		local tmp
		tmp=$(mktemp -d "$RUNS/incoming.XXXXXX")
		log "returning the work to the worktree at $WORKDIR"
		extract_image "$src_drive" "$tmp"
		rm -f "$tmp/.firecode-exit-status"

		# The commits first. The VM had a standalone .git, so its history is
		# fetched into the real repository and the branch moved onto it.
		if [[ -d $tmp/.git ]] && git -C "$WORKDIR" rev-parse --git-dir >/dev/null 2>&1; then
			if git -C "$WORKDIR" fetch -q "$tmp" HEAD:refs/firecode/incoming 2>/dev/null; then
				git -C "$WORKDIR" reset -q --hard refs/firecode/incoming
				git -C "$WORKDIR" update-ref -d refs/firecode/incoming
				log "branch $WORKTREE now has what the agent committed"
			fi
		fi
		# Then whatever it did not commit.
		rsync -a --delete --exclude=.git "$tmp"/ "$WORKDIR"/ 2>/dev/null || true
		rm -rf "$tmp"

		echo
		echo "  worktree: $WORKDIR  (branch $WORKTREE)"
		echo "  history:  git -C '$WORKDIR' log --oneline -5"
		[[ -f $RUN_DIR/console.log ]] && echo "  console:  $RUN_DIR/console.log"
		echo
	elif ((SYNC_BACK)); then
		local out_dir="${DELIVER:-${WORKDIR}-${id#firecode-}}"
		log "copying the project out to $out_dir"
		extract_image "$src_drive" "$out_dir"
		local st="$out_dir/.firecode-exit-status"
		if [[ -f $st ]]; then
			log "agent exit status: $(cat "$st")"
			rm -f "$st"
		fi
		# Said last, because it is the part that decides whether any of this
		# is worth reading. The log stays in the delivered tree either way.
		local vst="$out_dir/.firecode-verify-status"
		if [[ -f $vst ]]; then
			if [[ $(cat "$vst") == 0 ]]; then
				log "verification passed - see $out_dir/.firecode-verify.log"
			else
				log "VERIFICATION FAILED (exit $(cat "$vst")) - $out_dir/.firecode-verify.log"
				log "  whatever the agent said about this run, the check did not pass"
			fi
			rm -f "$vst"
		fi

		# A run that changed nothing should not leave a copy of your project
		# behind. Most of these VMs are transient - a test, a probe, one that
		# failed to start - and seventeen identical directories beside a
		# project is just litter to work out the meaning of later.
		if [[ -z $DELIVER ]] && diff -rq --exclude=.git "$WORKDIR" "$out_dir" >/dev/null 2>&1; then
			rm -rf "$out_dir"
			log "nothing changed, so no result directory"
			echo
			[[ -f $RUN_DIR/console.log ]] && echo "  console: $RUN_DIR/console.log"
			echo
			return $rc
		fi
		local saved
		saved=$(link_unchanged "$WORKDIR" "$out_dir")

		echo
		echo "  result:  $out_dir"
		[[ -n $saved ]] && echo "           $saved"
		echo "  changed: $(changed_files "$WORKDIR" "$out_dir" | head -5 | tr '\n' ' ')"
		echo "  diff:    diff -ru --exclude=.git '$WORKDIR' '$out_dir' | less"
		[[ -f $RUN_DIR/console.log ]] && echo "  console: $RUN_DIR/console.log"
		if ((STATE_PERSISTENT)); then
			echo "  resume:  firecode $AGENT --continue 'and now also ...'"
			echo "           firecode state sessions"
		fi
		echo
	fi

	return $rc
}

# Read an ext4 image without mounting it, so no root is needed. Files the
# guest created as root come out owned by you, which is what you want anyway.
extract_image() {
	local img=$1 dest=$2
	mkdir -p "$dest"
	sbin debugfs -R "rdump / $dest" "$img" >/dev/null 2>&1 ||
		log "WARNING: extraction reported errors, check $dest"
	rm -rf "$dest/lost+found"
}

# ---------------------------------------------------------------- commands

cmd_extract() {
	local id=${1:-}
	[[ -n $id ]] || die "usage: firecode extract <run-id> [dest]"
	local img="$RUNS/$id/src.ext4"
	[[ -f $img ]] || die "no src drive for run $id (already cleaned up?)"
	local dest=${2:-$RUNS/$id/src}
	log "extracting $img to $dest"
	extract_image "$img" "$dest"
	echo "$dest"
}

# Every VM that is actually running now, as "<id> <project> <parent>".
#
# Liveness is asked of the cgroup, not of a pid file or a socket: a pid can be
# reused and a socket file outlives the process that made it, but a cgroup is
# populated exactly while something in it is alive. That is what lets a run
# whose launcher was killed outright still be recognised - and cleaned up.
live_runs() {
	local d id proj parent cg sock
	[[ -d $RUNS ]] || return 0
	for d in "$RUNS"/*/; do
		[[ -f $d/jail ]] || continue
		id=$(basename "${d%/}")
		proj=$(cat "$d/project" 2>/dev/null || echo "?")
		parent=$(cat "$d/parent" 2>/dev/null || echo "-")
		cg=$(cat "$d/cgroup" 2>/dev/null || echo "")
		# A libvirt domain is not in our cgroup - libvirt places qemu in its
		# own machine slice - so the cgroup says nothing about whether it is
		# alive. Ask the VM instead, which works for either backend.
		if [[ -f $d/domain ]]; then
			libvirt_alive "$(cat "$d/domain")" "$(cat "$d/libvirt-uri" 2>/dev/null)" || continue
		elif [[ -n $cg ]]; then
			cg_alive "$cg/vm" || continue
		else
			# No cgroup for this run, so fall back to asking the VM itself.
			sock="$(cat "$d/jail")/firecracker-vsock.sock"
			vm_reachable "$sock" || continue
		fi
		printf '%s\t%s\t%s\t%s\n' "$id" "$proj" "$parent" \
			"$(cat "$d/name" 2>/dev/null || echo "${id##*-}")"
	done
}

# What every VM is actually doing, in one place.
#
# `list` says which VMs exist, which is not the question anyone has while a VM
# is working. This asks each of them: what is the agent doing, what else is
# running, what is it listening on, and is it busy or wedged - the things you
# would otherwise get by opening a shell in each one in turn.
cmd_ps() {
	local want="" id proj parent addr any=0
	[[ ${1:-} == --project ]] && want=$(cd "$2" && pwd)

	local vmname
	while IFS=$'\t' read -r id proj parent vmname; do
		[[ -n $want && $proj != "$want" && $vmname != "$want" ]] && continue
		any=1
		addr=$(cat "$RUNS/$id/vsock" 2>/dev/null)
		local backend="firecracker"
		[[ -f $RUNS/$id/domain ]] && backend="libvirt"
		echo
		printf '%s  %s\n' "${vmname:-$id}" "$proj"
		printf '  %s\n' "$id"
		# When it last said anything. An agent waiting on a model response
		# burns no cpu and prints nothing, which looks exactly like a wedged
		# one - and this is the number that tells them apart.
		if [[ -f $RUNS/$id/console.log ]]; then
			local quiet=$(($(date +%s) - $(stat -c %Y "$RUNS/$id/console.log")))
			# "thinking, or stuck" is the honest answer only while the answer
			# is genuinely unknown. Once the agent has reported a result it is
			# neither: it has finished and is holding the inbox open in case
			# anyone still wants to say something, and saying "stuck" about a
			# run that is counting down to its own shutdown is just wrong.
			local finished=""
			[[ -n $addr ]] && finished=$(python3 "$SCRIPTS/vsock-exec.py" "$addr" "$EXEC_PORT" - \
				'test -p /tmp/firecode-agent-inbox &&
				 tail -c 4000 /tmp/firecode-agent-stream.jsonl 2>/dev/null |
				 grep -q "\"type\":\"result\"" && echo waiting' 2>/dev/null || true)
			if [[ $finished == *waiting* ]]; then
				printf '  agent finished %ss ago - inbox open, it exits when nobody speaks\n' \
					"$quiet"
			elif ((quiet < 90)); then
				printf '  last output %ss ago\n' "$quiet"
			else
				printf '  last output %sm ago - thinking, or stuck\n' "$((quiet / 60))"
			fi
		fi
		printf '  %s' "$backend"
		[[ $parent != "-" && -n $parent ]] && printf ', stops with %s' "$parent"
		echo

		# One round trip for everything worth knowing. A VM whose exec channel
		# does not answer is not necessarily dead - it may be thrashing - so
		# say that rather than reporting it as gone.
		local snap
		# shellcheck disable=SC2016  # runs in the guest, expanded there
		snap=$(timeout 25 python3 "$SCRIPTS/vsock-exec.py" "$addr" "$EXEC_PORT" - '
up=$(cut -d" " -f1 /proc/uptime | cut -d. -f1)
printf "  up %sm, load%s\n" "$((up / 60))" "$(cut -d" " -f1-3 /proc/loadavg | sed "s/^/ /")"
free -m | awk "/Mem:/{printf \"  memory %s of %s MB\\n\", \$3, \$2}"
a=$(pgrep -a -f "claude|opencode|qwen" | grep -v pgrep | head -1 | cut -c1-90)
[ -n "$a" ] && printf "  agent %s\n" "$a"
s=$(systemctl list-units "firecode-svc-*" --no-legend --no-pager 2>/dev/null | awk "{printf \"%s(%s) \", \$1, \$4}")
[ -n "$s" ] && printf "  services %s\n" "$s"
p=$(ss -ltn 2>/dev/null | tail -n +2 | awk "{print \$4}" | grep -v "^127\." | sort -u | tr "\n" " ")
[ -n "$p" ] && printf "  listening %s\n" "$p"
true' 2>/dev/null) || snap=""
		if [[ -n $snap ]]; then
			printf '%s\n' "$snap"
		else
			echo "  (not answering - busy, or shutting down)"
		fi
	done < <(live_runs)

	((any)) || echo "no VMs running"
}

# What a VM has printed - the console, which is where the agent's own output
# goes as well as the kernel's.
#
# The obvious place to look, and until now you had to know that a run keeps its
# console under runs/<id>/ and find the right one yourself.
cmd_logs() {
	local want="" follow=0 lines=60 id proj RAW_LOGS=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--project)
			want=$(cd "$2" && pwd)
			shift 2
			;;
		-f | --follow)
			follow=1
			shift
			;;
		-n)
			lines="$2"
			shift 2
			;;
		--all)
			RAW_LOGS=1
			shift
			;;
		-*) die "usage: firecode logs [VM] [--project DIR] [-n LINES] [-f] [--all]" ;;
		*)
			# A VM name, so `firecode logs cl-irc` means that one. Without it
			# this shows whichever console was written to last, which with two
			# VMs running is a coin toss rather than an answer.
			want="$1"
			[[ -d $want ]] && want=$(cd "$want" && pwd)
			shift
			;;
		esac
	done

	# The newest run for that project, running or not: the log of a run that
	# just ended is usually the one being asked for.
	local newest="" newest_time=0 d t
	for d in "$RUNS"/*/; do
		[[ -f $d/console.log ]] || continue
		proj=$(cat "$d/project" 2>/dev/null)
		if [[ -n $want && $proj != "$want" ]]; then
			[[ $(cat "$d/name" 2>/dev/null) == "$want" ]] || continue
		fi
		t=$(stat -c %Y "$d/console.log" 2>/dev/null || echo 0)
		((t > newest_time)) && {
			newest_time=$t
			newest=$d
		}
	done
	[[ -n $newest ]] || die "no console log${want:+ for $want} - has anything run yet?"

	id=$(basename "${newest%/}")
	log "$id  $(cat "$newest/project" 2>/dev/null)"

	# The guest kernel probes legacy ISA ports - the CMOS clock at 0x70, a DMA
	# page register at 0x87, PCI config space at 0xcfc - and firecracker
	# emulates none of them, so it logs a bus error per probe. Harmless, and
	# noise in the one place anyone looks to see what an agent is doing.
	# --all keeps them for when the VMM itself is the thing being debugged.
	# --line-buffered, because with -f this filter is the only thing between
	# a live VM and whoever is watching. grep block-buffers when its stdout is
	# a pipe, so a reader like fctop gets one burst and then silence until
	# another 4K of console has piled up - a log that looks frozen while the
	# agent is working.
	local -a filter=(grep -a --line-buffered -v "bus_error: MissingAddressRange")
	((RAW_LOGS)) && filter=(cat)
	if ((follow)); then
		tail -n "$lines" -f "$newest/console.log" | "${filter[@]}"
	else
		tail -n "$lines" "$newest/console.log" | "${filter[@]}"
	fi
}

cmd_list() {
	# Machine-readable, for tests and for anything scripting this.
	if [[ ${1:-} == --ids ]]; then
		live_runs
		return 0
	fi

	echo "sessions:"
	cmd_sessions
	echo
	echo "VMs running:"
	local any=0 id proj parent vmname
	while IFS=$'\t' read -r id proj parent vmname; do
		any=1
		printf '  %-20s %s\n' "${vmname:-$id}" "$proj"
		[[ $parent != "-" && -n $parent ]] &&
			printf '  %-20s   stops when %s does\n' "" "$parent"
	done < <(live_runs)
	((any)) || echo "  (none)"

	[[ -d $RUNS ]] || return 0

	# Only the runs that still hold something. A finished run leaves a
	# directory of metadata behind, and after a busy day there are hundreds
	# of them - printing them all buries the two lines that matter.
	local d kept=0 done_count=0
	for d in "$RUNS"/*/; do
		[[ -d $d ]] || continue
		if compgen -G "$d*.ext4" >/dev/null; then
			((kept == 0)) && {
				echo
				echo "runs still holding drives:"
			}
			kept=$((kept + 1))
			printf '  %-38s %s\n' "$(basename "${d%/}")" "$(du -sh "$d" | cut -f1)"
		else
			done_count=$((done_count + 1))
		fi
	done
	if ((done_count)); then
		echo
		echo "$done_count finished run(s) - firecode gc clears them"
	fi
}

cmd_gc() {
	local keep=${1:-5} n=0 d
	local -a stuck=()
	[[ -d $RUNS ]] || return 0
	# Newest first; anything past the keep count goes entirely.
	while IFS= read -r d; do
		n=$((n + 1))
		if ((n > keep)); then
			log "removing $(basename "$d")"
			rm -rf "$d"
		else
			rm -f "$d"/*.ext4
		fi
	done < <(find "$RUNS" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
		sort -rn | cut -d' ' -f2-)
	# Jail directories outlive a VM that was killed rather than stopped.
	local j
	for j in "$JAIL_BASE"/firecracker/*/; do
		[[ -d $j ]] || continue
		if vm_reachable "$j/root/firecracker-vsock.sock"; then
			continue # still alive
		fi
		# The jailer makes device nodes in there as root, so a plain rm can
		# come up short. Where it does, say so and carry on: leaving one
		# directory behind is not a reason to abandon the rest of the sweep,
		# and there is no terminal here to authenticate with anyway.
		rm -rf "$j" 2>/dev/null || stuck+=("$j")
	done
	log "kept the $keep most recent runs (logs only)"
	if ((${#stuck[@]})); then
		log "${#stuck[@]} jail director(ies) need root to remove:"
		log "  sudo rm -rf ${stuck[*]}"
	fi
}

# What a new setup is missing, and what to type to fix each thing.
#
# A tick beside a name is not much use to somebody who has never run this: the
# useful part is which of these stops a run outright, which only costs a
# convenience, and the one command that fixes it. So every check carries its
# own fix, failures are separated from warnings, and anything that is present
# says which one it found - a rootfs that exists but was built before the
# guest scripts changed is a different problem from no rootfs at all.
DOC_OK=0
DOC_BAD=0
DOC_WARN=0
declare -a DOC_FIXES=()

# doc_check <fail|warn> <label> <test> <detail-when-ok> <fix>
doc_check() {
	local severity=$1 label=$2 test=$3 detail=${4:-} fix=${5:-}
	if eval "$test" >/dev/null 2>&1; then
		printf '  ok    %-38s %s\n' "$label" "$detail"
		DOC_OK=$((DOC_OK + 1))
		return 0
	fi
	if [[ $severity == warn ]]; then
		printf '  warn  %-38s %s\n' "$label" "${fix:+see below}"
		DOC_WARN=$((DOC_WARN + 1))
	else
		printf '  FAIL  %-38s %s\n' "$label" "${fix:+see below}"
		DOC_BAD=$((DOC_BAD + 1))
	fi
	[[ -n $fix ]] && DOC_FIXES+=("$label|$fix")
	return 1
}

doc_info() { printf '  --    %-38s %s\n' "$1" "$2"; }

cmd_doctor() {
	echo "firecode doctor"
	echo
	echo " virtualisation"
	doc_check fail "kvm usable (/dev/kvm)" "test -r /dev/kvm -a -w /dev/kvm" \
		"" "sudo usermod -aG kvm $(id -un)   # then log out and back in"
	doc_check warn "vsock available" "test -e /dev/vhost-vsock" \
		"$([[ -e /dev/vhost-vsock ]] && echo 'console and exec channels work')" \
		"sudo modprobe vhost_vsock   # without it, no 'enter', 'in', 'ps' or 'say'"

	echo
	echo " firecode's own pieces"
	doc_check fail "firecracker" "test -x '$FC'" \
		"$("$FC" --version 2>/dev/null | head -1)" "firecode setup"
	doc_check fail "jailer" "test -x '$JAILER'" "" "firecode setup"
	doc_check fail "guest kernel" "compgen -G '$IMAGES/vmlinux-*'" \
		"$(basename "$(find "$IMAGES" -maxdepth 1 -name 'vmlinux-*' -printf '%T@ %p\n' 2>/dev/null |
			sort -rn | head -1 | cut -d' ' -f2-)" 2>/dev/null)" \
		"firecode setup"
	doc_check fail "guest rootfs" "test -f '$IMAGES/agent-firecode.ext4'" \
		"$(du -h "$IMAGES/agent-firecode.ext4" 2>/dev/null | cut -f1)" \
		"firecode prepare        # needs docker, but no root"
	doc_check warn "docker (only for prepare)" "docker info" "" \
		"install docker and add yourself to the docker group - only 'prepare' needs it"

	echo
	echo " host tools"
	doc_check fail "mkfs.ext4" "command -v mkfs.ext4 || test -x /usr/sbin/mkfs.ext4" \
		"" "sudo apt install e2fsprogs"
	doc_check fail "debugfs" "command -v debugfs || test -x /usr/sbin/debugfs" \
		"" "sudo apt install e2fsprogs   # reads guest disks without mounting them"
	doc_check fail "socat" "command -v socat" "" \
		"sudo apt install socat   # every host port a guest reaches goes through it"
	doc_check fail "rsync" "command -v rsync" "" "sudo apt install rsync"
	doc_check fail "python3" "command -v python3" \
		"$(python3 -V 2>&1 | cut -d' ' -f2)" "sudo apt install python3"
	doc_check warn "iptables" "command -v iptables || test -x /usr/sbin/iptables" \
		"" "sudo apt install iptables   # guests have no network without it"
	doc_check warn "curl" "command -v curl" "" "sudo apt install curl"

	echo
	echo " privileges - each of these is a prompt you would otherwise get every run"
	# The jailer specifically, not sudo in general: a correctly scoped rule
	# grants this one binary, so `sudo -n true` failing proves nothing.
	doc_check warn "jailer runs unprompted" "sudo -n '$JAILER' --version" "" \
		"sudo $SCRIPTS/install-privileged.sh   # or run with --no-jail"
	doc_check warn "a tap is ready" "ip link show fccode1" \
		"$(ip -o link show 2>/dev/null | grep -c fccode) tap(s)" \
		"sudo $ROOT/bin/firecode net-setup --count 4"
	# Delegation is what lets a run put its VM in its own cgroup and kill the
	# whole tree at the end - including any VM the agent started itself.
	local cg
	cg="/sys/fs/cgroup$(awk -F: '/^0::/{print $3}' /proc/self/cgroup 2>/dev/null)"
	doc_check warn "cgroup delegation" "test -w '$cg/cgroup.subtree_control'" \
		"$(basename "$cg")" \
		"systemd should delegate this to your user session - without it a child VM can outlive its parent"

	echo
	echo " agents"
	doc_check warn "claude" "command -v claude" "$(claude --version 2>/dev/null)" \
		"install Claude Code on the host - the VM runs the host's binary"
	doc_check warn "opencode" "command -v opencode" "$(opencode --version 2>/dev/null)" \
		"install opencode on the host if you want to run it in a VM"
	doctor_credentials

	echo
	echo " capacity"
	doc_info "memory" "$(free -g 2>/dev/null | awk '/^Mem:/{print $7" GB available of "$2" GB"}')"
	doc_info "disk for images and state" \
		"$(df -h "$IMAGES" 2>/dev/null | awk 'NR==2{print $4" free of "$2}')"
	# The same test the rest of the harness uses: the kernel publishes a
	# separate PMU per core type, which is the only honest signal that this is
	# a hybrid part - /proc/cpuinfo does not say so.
	doc_info "cpu" "$(nproc) threads$([[ -d /sys/devices/cpu_atom ]] &&
		echo ", hybrid P+E - measure with --vectorized")"

	echo
	printf '  %d ok, %d warning(s), %d failure(s)\n' "$DOC_OK" "$DOC_WARN" "$DOC_BAD"
	if ((${#DOC_FIXES[@]})); then
		echo
		echo "  what to do:"
		local entry
		for entry in "${DOC_FIXES[@]}"; do
			printf '    %s\n        %s\n' "${entry%%|*}" "${entry#*|}"
		done
	fi
	if ((DOC_BAD == 0 && DOC_WARN == 0 && ${#DOC_FIXES[@]} == 0)); then
		echo
		echo "  Nothing missing. Try: firecode claude -p 'say hello'"
	elif ((DOC_BAD == 0)); then
		echo
		echo "  Nothing here stops a run. Try: firecode claude -p 'say hello'"
	fi
	((DOC_BAD == 0))
}

# Credentials are the one part where "present" is not the same as "usable",
# and where the wrong arrangement is silent until a run has already burned it.
doctor_credentials() {
	if [[ -f $CLAUDE_HOME/.credentials.json ]]; then
		local exp
		exp=$(python3 -c '
import json, sys, time
try:
    d = json.load(open(sys.argv[1])).get("claudeAiOauth") or {}
except Exception:
    print("unreadable")
    raise SystemExit
at = d.get("expiresAt")
if not at:
    print("no expiry recorded")
elif at / 1000 < time.time():
    print("EXPIRED")
else:
    print("valid for %d min" % ((at / 1000 - time.time()) / 60))
' "$CLAUDE_HOME/.credentials.json" 2>/dev/null || echo unknown)
		if [[ $exp == EXPIRED ]]; then
			printf '  warn  %-38s %s\n' "claude credentials" "expired on the host"
			DOC_WARN=$((DOC_WARN + 1))
			DOC_FIXES+=("claude credentials|run 'claude' on the host once to refresh, then use --auth-relay so the VM never holds a token")
		else
			printf '  ok    %-38s %s\n' "claude credentials" "$exp"
			DOC_OK=$((DOC_OK + 1))
		fi
	else
		printf '  warn  %-38s %s\n' "claude credentials" "none on the host"
		DOC_WARN=$((DOC_WARN + 1))
		DOC_FIXES+=("claude credentials|log in with 'claude' on the host - a VM cannot log in for you")
	fi

	[[ -f $OPENCODE_SHARE/auth.json ]] || return 0
	local kind
	kind=$(python3 -c '
import json, sys, time
d = json.load(open(sys.argv[1]))
for name, v in d.items():
    if not isinstance(v, dict):
        continue
    if v.get("type") == "oauth":
        at = (v.get("expires") or 0) / 1000
        state = "expired" if at and at < time.time() else "valid"
        print("%s: subscription login, %s" % (name, state))
    else:
        print("%s: api key" % name)
' "$OPENCODE_SHARE/auth.json" 2>/dev/null | tr '\n' '; ')
	printf '  ok    %-38s %s\n' "opencode credentials" "${kind:-present}"
	DOC_OK=$((DOC_OK + 1))
	# A subscription login rotates on refresh, so a copy inside a VM spends
	# the host's token. The relay is the whole answer, and it is worth saying
	# before a run does it rather than after.
	if [[ $kind == *"subscription login"* ]]; then
		DOC_FIXES+=("opencode credentials|a subscription login rotates when it refreshes, so run opencode with --auth-relay - a copy in a VM leaves the host holding a spent token")
		if [[ $kind == *expired* ]]; then
			DOC_FIXES+=("opencode credentials (expired)|opencode auth login")
		fi
	fi
}

usage() {
	cat <<'EOF'
firecode - run a coding agent in a Firecracker microVM

  firecode setup                 fetch firecracker, jailer and a guest kernel
  firecode prepare [--full]      build the guest rootfs (via docker, no root)
  firecode prepare --with "dotnet@10 uv"
                                put toolchains in the base image, so every
                                project has them without installing anything
  firecode net-setup [--count N] pre-create taps once, so runs need no root
  firecode doctor                check the host is ready

  firecode claude [args...]      run claude in a VM over the current directory
  firecode opencode [args...]    same, with opencode
  firecode shell                 interactive root shell in a VM
  firecode keys                  show what the guest receives for each keypress
  firecode cp SRC DST            move files in or out of a running VM,
                                with vm: naming the guest side
  firecode exec CMD [args...]    run any command in a VM over this directory

  firecode attach [project]      reattach to a running session
  firecode enter                 a second shell inside the VM running now

  firecode up                    start a VM and leave it running
  firecode in CMD [args...]      run a command in it, with its exit status
                                 --project DIR picks which VM, --cwd DIR where
  firecode ps                    what every VM is doing right now
  firecode logs [-f]             what it has printed, agent output included
  firecode say [VM] <text>       another turn for a run that is still going
  firecode watch [VM] [--every SEC] [-n LINES]
                                 wait, then say whether it is still up and what
                                 it has printed - one command for a watcher,
                                 so it can be permitted once
  firecode down                  stop it, copying the work back out
  firecode checkpoint            freeze the running VM as it is now, so that
                                 up --fast brings it back in ~60ms
  firecode up --fast             restore that checkpoint instead of booting
                                 (transient: it writes to its own copies)
  firecode up --refresh          throw the checkpoint away and take a new one
  firecode list                  sessions, runs, and whether drives still exist
  firecode extract <id> [dest]   pull a run's /src back out
  firecode gc [keep]             drop old run drives (default: keep 5)

  firecode snapshot [name]       capture this project's VM state
  firecode snapshot ls           list snapshots
  firecode snapshot restore NAME go back to one
  firecode snapshot rm NAME      drop one

  firecode state list            per-project agent state drives
  firecode state sessions [dir]  session ids you can --resume
  firecode state reset [dir]     forget this project's agent history

options (before the agent's own arguments):
  --workdir DIR   project to put in /src            (default: .)
  --exclude PAT   leave PAT out of /src, repeatable
  --all-files     include gitignored files too (they are left out by default)
  --fresh-root    throw away this workspace's layer and start from the base
                  image again (packages it installed are lost)
  --worktree NAME run in a git worktree of this repo, creating it if needed.
                  Its own layer, inheriting the main checkout's.
  --add-dir DIR   extra host dir, read-only at /mnt/<name>, repeatable
  --host-port N   make the host's localhost:N reachable at localhost:N in the
                  guest, over vsock; repeatable. For a local llama-server or
                  any other OpenAI-compatible endpoint on loopback.
  --resume-tree   carry the previous run's /src forward (implied by -c/-r)
  --fresh         start from the host tree even when continuing
  --import-sessions    copy this project's host transcripts into the VM,
                       rewriting host paths to /src so they can be resumed
  --no-import-sessions never do that
  --mem MB        guest memory                      (default: 4096)
  --vcpu N        guest cpus                        (default: 4)
  --timeout SEC   kill the agent after SEC seconds  (default: none)
  --verify CMD    run CMD in the project after the agent exits, and report
                  its result as the run's. The agent is told what it is.
                  Output lands in the delivered tree as .firecode-verify.log
  --verify-timeout SEC                              (default: 1800)
  --no-net        no network at all
  --no-jail       skip the jailer (still a real VM, less hardening, no root)
  --no-tmux       do not wrap an interactive session in byobu/tmux
  --dry-run       say what would happen and stop, without building or booting
  --no-sync       do not copy /src back out
  --keep          keep the run's drives afterwards
  --cgroups       also cap the host-side process via jailer cgroups
  --debug-boot    verbose guest boot
  --no-auto-flags do not add -p / --dangerously-skip-permissions
  --              everything after this goes to the agent verbatim

Given arguments, the agent runs unattended and the VM powers off when it is
done. Given none, you get an interactive session on the guest console.

Work is copied to a sibling directory, <project>-<timestamp>-<pid>. Your
project directory is never written to.

The agent's home directory is kept on a per-project drive that outlives the
VM, so a later run can pick up where the last one stopped:

  firecode claude "start the refactor"
  firecode claude --continue "now do the tests too"
  firecode state sessions
  firecode claude --resume 3f9a1c2e "and update the docs"

examples:
  firecode claude "add tests for the parser"
  firecode claude --timeout 3600 -- -p "fix the failing build" --model opus
  firecode opencode "fix the tests"
  firecode claude --workdir ~/Projects/foo "update the readme"
  firecode claude --add-dir ~/Projects "match the API used in the sibling repo"
  firecode shell
EOF
}

case "${1:-}" in
setup)
	shift
	"$SCRIPTS/setup.sh" "$@"
	;;
prepare)
	shift
	"$SCRIPTS/prepare-rootfs.sh" "$@"
	;;
doctor)
	shift
	cmd_doctor
	;;
list | ls)
	shift
	cmd_list "$@"
	;;
ps)
	shift
	cmd_ps "$@"
	;;
logs)
	shift
	cmd_logs "$@"
	;;
say | tell)
	shift
	cmd_say "$@"
	;;
watch)
	shift
	cmd_watch "$@"
	;;
chat)
	shift
	cmd_chat "$@"
	;;
stop)
	# docker's word for it; firecode's is down.
	shift
	cmd_down "$@"
	;;
extract)
	shift
	cmd_extract "$@"
	;;
gc)
	shift
	cmd_gc "$@"
	;;
state)
	shift
	cmd_state "$@"
	;;
snapshot | snap)
	shift
	cmd_snapshot "$@"
	;;
net-setup)
	shift
	cmd_net_setup "$@"
	;;
spawn-server)
	shift
	exec python3 "$ROOT/mcp/firecode-spawn.py" "$@"
	;;
test)
	shift
	exec "$ROOT/tests/run-tests.sh" "$@"
	;;
claude | opencode)
	agent=$1
	shift
	launch "$agent" "$@"
	;;
shell)
	shift
	# `shell <name>` means the VM called that, and leaving it does not stop
	# it - the same thing `docker exec -it` does, and what anyone typing this
	# expects. With no argument there is nothing to attach to, so it starts a
	# VM whose session *is* the shell, and ending that ends the VM.
	if [[ -n ${1:-} && $1 != -* ]] && live_vm_socket "$1" >/dev/null 2>&1; then
		cmd_enter "$1"
	else
		launch shell "$@"
	fi
	;;
keys)
	shift
	launch keys "$@"
	;;
cp)
	shift
	cmd_cp "$@"
	;;
attach)
	shift
	cmd_attach "$@"
	;;
enter)
	shift
	cmd_enter "$@"
	;;
up)
	shift
	cmd_up "$@"
	;;
in)
	shift
	cmd_in "$@"
	;;
checkpoint)
	shift
	cmd_checkpoint "$@"
	;;
layer)
	shift
	cmd_layer "$@"
	;;
mirror)
	shift
	cmd_mirror "$@"
	;;
info)
	shift
	cmd_info "$@"
	;;
down)
	shift
	cmd_down "$@"
	;;
exec)
	shift
	[[ $# -gt 0 ]] || die "usage: firecode exec [options] <command> [args...]"
	launch "" "$@"
	;;
-h | --help | help | "")
	usage
	;;
*)
	die "unknown command: $1 (try: firecode help)"
	;;
esac
