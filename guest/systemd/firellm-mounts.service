[Unit]
Description=firellm guest setup (drives, network, MCP relays)
After=systemd-udevd.service local-fs.target
Wants=systemd-udevd.service
Before=firellm-agent.service serial-getty@ttyS0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/firellm/firellm-setup.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
