[Unit]
Description=firellm agent run
Requires=firellm-mounts.service
After=firellm-mounts.service
# Unattended runs only. In interactive mode the host writes no args file and
# this unit is skipped, leaving the serial console to the autologin shell.
ConditionPathExists=/opt/firellm/run/args
# The agent owns the serial console while it runs.
Conflicts=serial-getty@ttyS0.service

[Service]
Type=oneshot
WorkingDirectory=/src
ExecStart=/opt/firellm/agent-entrypoint.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=infinity
# Shut down whether the agent succeeded, failed or was killed - the host is
# waiting on the VM exiting to copy the work back out.
#
# reboot, not poweroff: a Firecracker guest has no ACPI power button to press
# from the inside, so poweroff only halts the CPU and the VMM sits there
# forever. With reboot=k on the kernel command line the reset goes through
# the i8042, which Firecracker sees and exits on. systemd still unmounts
# everything cleanly on the way out, which is what matters for /src.
ExecStopPost=-/bin/systemctl --no-block reboot

[Install]
WantedBy=multi-user.target
