{
  "boot-source": {
    "kernel_image_path": "vmlinux-6.1.0",
    "boot_args": "console=ttyS0 reboot=k panic=1 init=/sbin/init"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "agent-firellm.ext4",
      "is_root_device": true,
      "is_read_only": false
    },
    {
      "drive_id": "work",
      "path_on_host": "work-xxx.ext4",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 1024,
    "smt": false
  },
  "vsock": {
    "vsock_id": "vsock0",
    "uds_path": "firecracker-vsock.sock"
  }
}
